    "check:formulas": "node scripts/verify-formula-coverage.mjs",
    "check:entrance-content": "node scripts/verify-entrance-content.mjs",
    "check:diagrams": "node scripts/verify-diagrams.mjs",
    "check:component-styles": "node scripts/verify-component-styles.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.84",
    "astro": "7.2.9",
    "mathlive": "0.110.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
