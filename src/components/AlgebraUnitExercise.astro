---
import ExerciseSet from "./ExerciseSet.astro";
import type { AlgebraUnit } from "../content/math1/algebra";
import "../styles/global.css";
import "../styles/lesson.css";

type Props = {
  unit: AlgebraUnit;
};

const { unit: _unit } = Astro.props;
const _base = import.meta.env.BASE_URL;
const _unitHref = `${_base}math1/algebra/${_unit.key}/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`高校数学I「${_unit.title}」の単元末演習。基礎・応用・難問を自動採点し、小単元ごとの弱点を確認します。`}
    />
    <title>単元末演習 | {_unit.title} | 数学I</title>
  </head>
  <body>
    <main class="lesson-shell">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href={_base}>数学I</a>
        <span aria-hidden="true">/</span>
        <a href={_unitHref}>{_unit.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">単元末演習</span>
      </nav>

      <header class="lesson-hero compact-hero">
        <p class="lesson-kicker">数と式 · UNIT EXERCISE</p>
        <h1>{_unit.title}の単元末演習</h1>
        <p>
          単元全体から問題を出し、採点後に小単元別の正答状況を表示します。不正解が多い小単元は復習リンクから戻れます。
        </p>
      </header>

      <ExerciseSet mode="unit" unitKey={_unit.key} />

      <nav class="lesson-navigation" aria-label="教材ナビゲーション">
        <a href={_unitHref}>← {_unit.title}の小単元一覧</a>
        <a href={_base}>数学Iの目次へ →</a>
      </nav>
    </main>
  </body>
</html>
