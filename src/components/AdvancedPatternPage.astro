---
import { type MathCourseInfo, math1Course } from "../content/math-courses";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import BreadcrumbTrail from "./ui/BreadcrumbTrail.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ConceptCard from "./ui/ConceptCard.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import GuidedPractice from "./ui/GuidedPractice.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "./ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PracticeProblem from "./ui/PracticeProblem.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import TagList from "./ui/TagList.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import WorkedExample from "./ui/WorkedExample.astro";

type GuidedStep = { prompt: string; answers: string[]; placeholder?: string };
type Pattern = {
  id: string;
  title: string;
  level: string;
  estimatedMinutes: number;
  skills: string[];
  thinking: { title: string; body: string[]; checkpoints: string[] };
  example: {
    statement: string[];
    question: string;
    solution: { strategy: string; steps: string[]; answer: string };
  };
  guidedPractice: {
    title: string;
    statement: string[];
    question: string;
    steps: GuidedStep[];
    hint: string;
  };
  practice: {
    statement: string[];
    question: string;
    solution: { steps: string[]; answer: string };
  };
  generatorKey?: string;
};
type TopicSet = { topic: string; title: string; patterns: Pattern[] };
type Props = {
  topicSet: TopicSet;
  areaTitle: string;
  pattern: Pattern;
  patternIndex: number;
  course?: MathCourseInfo;
};

const {
  topicSet: _topicSet,
  areaTitle: _areaTitle,
  pattern: _pattern,
  patternIndex: _patternIndex,
  course: _course = math1Course,
} = Astro.props as Props;
const _base = import.meta.env.BASE_URL;
const _levelLabel = _pattern.level === "advanced" ? "発展" : "応用";
const _patternSlug = (pattern: Pattern) =>
  pattern.id.replace(`${_course.key}-${_topicSet.topic}-pattern-`, "");
const _previousPattern = _patternIndex > 0 ? _topicSet.patterns[_patternIndex - 1] : undefined;
const _nextPattern =
  _patternIndex < _topicSet.patterns.length - 1 ? _topicSet.patterns[_patternIndex + 1] : undefined;
const _courseHomeHref = `${_base}${_course.homePath}`;
const _areaHref = `${_base}${_course.routeBase}/${_topicSet.topic}/`;
const _topicHref = `${_base}${_course.routeBase}/entrance/${_topicSet.topic}/`;
const _patternHref = (pattern: Pattern) => `${_topicHref}${_patternSlug(pattern)}/`;
---

<StudyPage
  title={`${_pattern.title} | ${_topicSet.title} | 学習コンテンツ`}
  description={`${_course.title}「${_areaTitle}」の${_levelLabel}パターン「${_pattern.title}」。考え方、例題、ステップ練習、実践の順で学びます。`}
>
  <BreadcrumbTrail
    items={[
      { label: "科目一覧", href: _base },
      { label: _course.title, href: _courseHomeHref },
      { label: _areaTitle, href: _areaHref },
      { label: "応用・発展", href: _topicHref },
      { label: _pattern.title },
    ]}
  />
  <ContentHero
    kicker={`PATTERN ${String(_patternIndex + 1).padStart(2, "0")} · ${_levelLabel}`}
    title={_pattern.title}
    description={`目安 ${_pattern.estimatedMinutes}分`}
    compact
  >
    <TagList items={_pattern.skills} ariaLabel="このパターンで使う主な技能" />
  </ContentHero>

  <ContentSection labelledby="thinking-title">
    <SectionHeading label="THINKING" title="考え方・着眼点" id="thinking-title" />
    <ConceptCard
      title={_pattern.thinking.title}
      body={_pattern.thinking.body}
      points={_pattern.thinking.checkpoints}
    />
  </ContentSection>

  <ContentSection labelledby="example-title">
    <SectionHeading label="EXAMPLE" title="例題" id="example-title" />
    <WorkedExample
      problem={`${_pattern.example.statement.join(" ")} ${_pattern.example.question}`}
      strategy={_pattern.example.solution.strategy}
      steps={_pattern.example.solution.steps.map((text) => ({ text }))}
      answer={_pattern.example.solution.answer}
    />
  </ContentSection>

  <ContentSection labelledby="guided-title">
    <SectionHeading
      label="STEP PRACTICE"
      title="ステップバイステップの練習"
      id="guided-title"
    />
    <GuidedPractice
      title={_pattern.guidedPractice.title}
      statement={_pattern.guidedPractice.statement}
      question={_pattern.guidedPractice.question}
      steps={_pattern.guidedPractice.steps}
      hint={_pattern.guidedPractice.hint}
      successMessage="すべて正解です。着眼点から解答手順まで再現できています。"
      errorMessage="例題の判断順序と比べて確認してください。"
    />
  </ContentSection>

  <ContentSection labelledby="practice-title">
    <SectionHeading label="PRACTICE" title="実践" id="practice-title" />
    <PracticeProblem
      statement={_pattern.practice.statement}
      question={_pattern.practice.question}
      solutionSteps={_pattern.practice.solution.steps}
      answer={_pattern.practice.solution.answer}
      solutionSummary="実践問題の解答・解説を表示"
    />
  </ContentSection>

  {
    _pattern.generatorKey && (
      <ContentSection labelledby="generated-title">
        <SectionHeading
          label="GENERATED PRACTICE"
          title="同じパターンでもう1問"
          id="generated-title"
          description="成立条件を保ったまま、数値や条件を変えた独自問題を生成します。"
        />
        <div class="generator" data-generator data-generator-key={_pattern.generatorKey}>
          <button type="button" data-generator-button>別の実践問題を生成</button>
          <div class="generated" data-generated-content hidden>
            <div data-generated-statement></div>
            <p class="generated-question" data-generated-question></p>
            <details data-generated-solution>
              <summary>生成問題の解答・解説を表示</summary>
              <ol data-generated-steps></ol>
              <p class="generated-answer" data-generated-answer></p>
            </details>
          </div>
          <p class="generator-feedback" data-generator-feedback aria-live="polite"></p>
        </div>
      </ContentSection>
    )
  }

  <PageNavigation
    previous={
      _previousPattern
        ? { label: `← ${_previousPattern.title}`, href: _patternHref(_previousPattern) }
        : { label: "← パターン一覧", href: _topicHref }
    }
    center={{ label: "パターン一覧", href: _topicHref }}
    next={
      _nextPattern
        ? { label: `${_nextPattern.title} →`, href: _patternHref(_nextPattern) }
        : { label: `${_areaTitle}の基礎教材へ →`, href: _areaHref }
    }
  />
</StudyPage>

<script>
  import { generateMath1QuadraticPractice } from "../content/entrance/math1-quadratic-generators";

  for (const block of document.querySelectorAll("[data-generator]")) {
    if (!(block instanceof HTMLElement) || block.dataset.generatorReady === "true") continue;
    block.dataset.generatorReady = "true";
    const button = block.querySelector("[data-generator-button]");
    const content = block.querySelector("[data-generated-content]");
    const statement = block.querySelector("[data-generated-statement]");
    const question = block.querySelector("[data-generated-question]");
    const steps = block.querySelector("[data-generated-steps]");
    const answer = block.querySelector("[data-generated-answer]");
    const solution = block.querySelector("[data-generated-solution]");
    const feedback = block.querySelector("[data-generator-feedback]");
    if (
      !(button instanceof HTMLButtonElement) ||
      !(content instanceof HTMLElement) ||
      !(statement instanceof HTMLElement) ||
      !(question instanceof HTMLElement) ||
      !(steps instanceof HTMLOListElement) ||
      !(answer instanceof HTMLElement) ||
      !(solution instanceof HTMLDetailsElement) ||
      !(feedback instanceof HTMLElement)
    )
      continue;

    button.addEventListener("click", () => {
      const key = block.dataset.generatorKey;
      if (!key) return;
      const generated = generateMath1QuadraticPractice(key);
      if (!generated) {
        feedback.textContent = "このパターンの生成器を読み込めませんでした。";
        return;
      }
      statement.replaceChildren(
        ...generated.statement.map((text) =>
          Object.assign(document.createElement("p"), { textContent: text }),
        ),
      );
      question.textContent = generated.question;
      steps.replaceChildren(
        ...generated.solution.steps.map((text) =>
          Object.assign(document.createElement("li"), { textContent: text }),
        ),
      );
      answer.textContent = generated.solution.answer;
      solution.open = false;
      content.hidden = false;
      feedback.textContent =
        "別の条件で実践問題を生成しました。まず解答を閉じたまま解いてください。";
    });
  }
</script>

<style>
  .generator {
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--color-border-soft);
    border-radius: 1rem;
    background: var(--surface-accent);
  }

  button {
    min-height: 2.75rem;
    padding: 0.65rem 0.95rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.65rem;
    color: var(--color-accent-strong);
    background: #fff;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 750;
    cursor: pointer;
  }

  button:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  .generated {
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-text-soft);
    line-height: 1.85;
  }

  .generated-question,
  .generated-answer {
    padding: 1rem;
    border-radius: 0.85rem;
    background: #fff;
    font-weight: 700;
    line-height: 1.8;
  }

  summary {
    cursor: pointer;
    color: var(--color-link);
    font-weight: 800;
  }

  .generator-feedback {
    margin: 0.9rem 0 0;
    color: var(--color-muted-strong);
    line-height: 1.75;
  }

  .generator :global(p),
  .generator :global(li) {
    line-height: 1.85;
  }
</style>
