---
import "../styles/exercise.css";

type Props = {
  mode: "lesson" | "unit";
  courseKey?: "math1" | "matha" | "mathb" | "mathc" | "chemistry-basic";
  areaKey: string;
  unitKey: string;
  lessonKey?: string;
};

const {
  mode: _mode,
  courseKey: _courseKey = "math1",
  areaKey: _areaKey,
  unitKey: _unitKey,
  lessonKey: _lessonKey,
} = Astro.props;
const _base = import.meta.env.BASE_URL;
const _isUnit = _mode === "unit";
const _isChemistry = _courseKey === "chemistry-basic";
---

<section
  class:list={["exercise-set", _isUnit && "unit-exercise-set"]}
  data-exercise-set
  data-mode={_mode}
  data-course-key={_courseKey}
  data-area-key={_areaKey}
  data-unit-key={_unitKey}
  data-lesson-key={_lessonKey}
  data-base={_base}
  aria-labelledby={_isUnit ? "unit-exercise-title" : "lesson-check-title"}
>
  <div class="exercise-heading">
    <div>
      <p class="section-label">{_isUnit ? "UNIT EXERCISE" : "CHECK"}</p>
      <h2 id={_isUnit ? "unit-exercise-title" : "lesson-check-title"}>
        {_isUnit ? "単元末演習" : "理解を確認する3問"}
      </h2>
    </div>
    <p>
      {
        _isUnit
          ? _isChemistry
            ? "基礎4問・応用1問・難問1問を採点し、小単元ごとの理解度を確認します。"
            : "基礎12問・応用3問・難問1問を採点し、小単元ごとの理解度を確認します。"
          : "解き方を確認したあと、誘導なしで3問解いてからまとめへ進みます。"
      }
    </p>
  </div>

  <div class="exercise-toolbar">
    <p class="exercise-count-note">
      {
        _isUnit
          ? _isChemistry
            ? "全6問 · 対応小単元を各問題に表示"
            : "全16問 · 対応小単元を各問題に表示"
          : "全3問 · すべてこの小単元の確認問題"
      }
    </p>
    <button type="button" class="secondary-button exercise-regenerate">別の問題を作る</button>
  </div>

  <form class="exercise-form">
    <div class="exercise-list" data-exercise-list></div>
    <div class="exercise-actions">
      <button type="submit" class="primary-button">採点する</button>
      <button type="reset" class="secondary-button">回答を消す</button>
    </div>
  </form>

  <p class="feedback exercise-feedback" aria-live="polite"></p>
  <section class="exercise-diagnostic" data-exercise-diagnostic hidden aria-labelledby="diagnostic-title">
    <h3 id="diagnostic-title">小単元ごとの理解度</h3>
    <p>正答率が低い小単元から復習すると、理解不足の場所を絞れます。</p>
    <div class="diagnostic-list" data-diagnostic-list></div>
  </section>

  <noscript>演習問題の生成と採点には JavaScript が必要です。</noscript>
</section>

<script>
  import { MathfieldElement } from "mathlive";
  import "mathlive/fonts.css";
  import {
    generateLessonExercises as generateChemistryLessonExercises,
    generateUnitExercises as generateChemistryUnitExercises,
  } from "../content/chemistry-basic/exercise-registry";
  import {
    generateLessonExercises as generateMath1LessonExercises,
    generateUnitExercises as generateMath1UnitExercises,
    type GeneratedExercise,
  } from "../content/math1/exercise-registry";
  import {
    generateLessonExercises as generateMathALessonExercises,
    generateUnitExercises as generateMathAUnitExercises,
  } from "../content/matha/exercise-registry";
  import {
    generateLessonExercises as generateMathBLessonExercises,
    generateUnitExercises as generateMathBUnitExercises,
  } from "../content/mathb/exercise-registry";
  import {
    generateLessonExercises as generateMathCLessonExercises,
    generateUnitExercises as generateMathCUnitExercises,
  } from "../content/mathc/exercise-registry";

  MathfieldElement.soundsDirectory = null;

  const normalizeAnswer = (value: string) => {
    let normalized = value
      .trim()
      .toLowerCase()
      .replaceAll(/\s+/g, "")
      .replaceAll("\\left", "")
      .replaceAll("\\right", "")
      .replaceAll(/\\[,;:!]/g, "")
      .replaceAll("\\cdot", "*")
      .replaceAll("\\times", "*")
      .replaceAll("\\pm", "±")
      .replaceAll("\\leqslant", "≤")
      .replaceAll("\\leq", "≤")
      .replaceAll("\\le", "≤")
      .replaceAll("\\geqslant", "≥")
      .replaceAll("\\geq", "≥")
      .replaceAll("\\ge", "≥")
      .replaceAll("\\Rightarrow", "⇒")
      .replaceAll("\\implies", "⇒")
      .replaceAll("\\lbrace", "{")
      .replaceAll("\\rbrace", "}")
      .replaceAll("\\{", "{")
      .replaceAll("\\}", "}")
      .replaceAll("−", "-")
      .replaceAll("–", "-")
      .replaceAll("—", "-")
      .replaceAll("×", "*")
      .replaceAll("·", "*")
      .replaceAll("，", ",")
      .replaceAll("（", "(")
      .replaceAll("）", ")")
      .replaceAll("｛", "{")
      .replaceAll("｝", "}");

    let previous = "";
    while (previous !== normalized) {
      previous = normalized;
      normalized = normalized.replace(/\\sqrt\{([^{}]+)\}/g, "√$1");
    }
    previous = "";
    while (previous !== normalized) {
      previous = normalized;
      normalized = normalized.replace(/\\frac\{([^{}]+)\}\{([^{}]+)\}/g, "$1/$2");
    }
    return normalized.replaceAll("^{2}", "²").replaceAll("^2", "²");
  };

  const difficultyLabel: Record<GeneratedExercise["difficulty"], string> = {
    basic: "基礎",
    applied: "応用",
    challenge: "難問",
  };

  const createElement = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    if (text !== undefined) element.textContent = text;
    return element;
  };

  const mathShortcuts = [
    ["x²", "#@^{2}", "直前の式を2乗する"],
    ["xⁿ", "#@^{#?}", "指数を入力する"],
    ["√□", "\\sqrt{#0}", "平方根を入力する"],
    ["□/□", "\\frac{#0}{#?}", "分数を入力する"],
    ["±", "\\pm", "プラスマイナスを入力する"],
    ["(", "(", "左かっこを入力する"],
    [")", ")", "右かっこを入力する"],
  ] as const;

  const createMathEditor = (id: string, ariaLabel: string) => {
    const wrapper = createElement("div", "exercise-math-editor");
    const field = new MathfieldElement();
    field.id = id;
    field.className = "exercise-answer-editor exercise-math-input";
    field.placeholder = "\\text{答えを入力}";
    field.mathVirtualKeyboardPolicy = "auto";
    field.dataset.answerEditor = "math";
    field.setAttribute("aria-label", ariaLabel);

    const help = createElement(
      "p",
      "exercise-input-help",
      "入力しにくい記号は下のボタンから挿入できます。スマートフォンでは数式キーボードも利用できます。",
    );
    const toolbar = createElement("div", "exercise-symbol-toolbar");
    toolbar.setAttribute("aria-label", "数式入力補助");
    for (const [label, latex, shortcutAriaLabel] of mathShortcuts) {
      const button = createElement("button", "exercise-symbol-button", label);
      button.type = "button";
      button.setAttribute("aria-label", shortcutAriaLabel);
      button.addEventListener("click", () => field.insert(latex, { focus: true, selectionMode: "placeholder" }));
      toolbar.append(button);
    }
    wrapper.append(field, help, toolbar);
    return wrapper;
  };

  for (const section of document.querySelectorAll<HTMLElement>("[data-exercise-set]")) {
    const mode = section.dataset.mode;
    const courseKey = section.dataset.courseKey ?? "math1";
    const areaKey = section.dataset.areaKey;
    const unitKey = section.dataset.unitKey;
    const lessonKey = section.dataset.lessonKey;
    const base = section.dataset.base ?? "/";
    const form = section.querySelector<HTMLFormElement>(".exercise-form");
    const list = section.querySelector<HTMLElement>("[data-exercise-list]");
    const feedback = section.querySelector<HTMLElement>(".exercise-feedback");
    const regenerate = section.querySelector<HTMLButtonElement>(".exercise-regenerate");
    const diagnostic = section.querySelector<HTMLElement>("[data-exercise-diagnostic]");
    const diagnosticList = section.querySelector<HTMLElement>("[data-diagnostic-list]");
    if (!areaKey || !unitKey || !form || !list || !feedback || !regenerate || !diagnostic || !diagnosticList) continue;

    let exercises: GeneratedExercise[] = [];
    const makeExercises = () => {
      if (courseKey === "chemistry-basic") {
        return mode === "unit"
          ? generateChemistryUnitExercises(unitKey)
          : lessonKey
            ? generateChemistryLessonExercises(unitKey, lessonKey)
            : [];
      }
      if (courseKey === "matha") {
        return mode === "unit"
          ? generateMathAUnitExercises(unitKey)
          : lessonKey
            ? generateMathALessonExercises(unitKey, lessonKey)
            : [];
      }
      if (courseKey === "mathb") {
        return mode === "unit"
          ? generateMathBUnitExercises(unitKey)
          : lessonKey
            ? generateMathBLessonExercises(unitKey, lessonKey)
            : [];
      }
      if (courseKey === "mathc") {
        return mode === "unit"
          ? generateMathCUnitExercises(unitKey)
          : lessonKey
            ? generateMathCLessonExercises(unitKey, lessonKey)
            : [];
      }
      return mode === "unit"
        ? generateMath1UnitExercises(unitKey)
        : lessonKey
          ? generateMath1LessonExercises(unitKey, lessonKey)
          : [];
    };

    const renderExercises = () => {
      exercises = makeExercises();
      list.replaceChildren();
      diagnostic.hidden = true;
      diagnosticList.replaceChildren();
      feedback.textContent = "";
      feedback.className = "feedback exercise-feedback";

      for (const [index, exercise] of exercises.entries()) {
        const article = createElement("article", "exercise-question");
        const header = createElement("div", "exercise-question-header");
        header.append(
          createElement("span", "exercise-number", `問${index + 1}`),
          createElement("span", `exercise-difficulty difficulty-${exercise.difficulty}`, difficultyLabel[exercise.difficulty]),
        );
        const prompt = createElement("p", "exercise-prompt", exercise.prompt);
        const mapping = createElement("p", "exercise-mapping", `対応: ${exercise.lessonTitles.join(" / ")}`);
        const answerBlock = createElement("div", "exercise-answer-label");
        const answerId = `exercise-answer-${exercise.id}-${index}`;
        const label = createElement("label", undefined, "答え");
        label.htmlFor = answerId;

        if (exercise.answerMode === "text") {
          const input = document.createElement("input");
          input.id = answerId;
          input.type = "text";
          input.className = "exercise-answer-editor exercise-text-input";
          input.autocomplete = "off";
          input.spellcheck = false;
          input.required = true;
          input.dataset.answerEditor = "text";
          input.setAttribute("aria-label", `問${index + 1}の答え`);
          answerBlock.append(label, input);
        } else {
          answerBlock.append(label, createMathEditor(answerId, `問${index + 1}の数式の答え`));
        }

        article.append(header, prompt, mapping, answerBlock);
        if (exercise.hint) {
          const details = createElement("details", "exercise-hint");
          details.append(createElement("summary", undefined, "ヒント"), createElement("p", undefined, exercise.hint));
          article.append(details);
        }
        list.append(article);
      }
    };

    const renderDiagnostic = (results: Map<string, { title: string; correct: number; total: number }>) => {
      diagnosticList.replaceChildren();
      const sorted = [...results.entries()].sort(([, a], [, b]) => a.correct / a.total - b.correct / b.total);
      for (const [key, result] of sorted) {
        const item = createElement("article", "diagnostic-item");
        const ratio = result.total === 0 ? 0 : result.correct / result.total;
        const link = createElement("a", "diagnostic-link", "この小単元を復習する");
        link.href = `${base}${courseKey}/${areaKey}/${unitKey}/${key}/`;
        item.append(
          createElement("h4", undefined, result.title),
          createElement("p", "diagnostic-score", `${result.correct}/${result.total} 正解`),
          createElement(
            "p",
            ratio === 1 ? "diagnostic-status is-strong" : "diagnostic-status is-weak",
            ratio === 1 ? "理解できています" : "復習候補",
          ),
          link,
        );
        diagnosticList.append(item);
      }
      diagnostic.hidden = false;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      let correctCount = 0;
      const lessonResults = new Map<string, { title: string; correct: number; total: number }>();

      for (const [index, article] of [...list.querySelectorAll<HTMLElement>(".exercise-question")].entries()) {
        const exercise = exercises[index];
        if (!exercise) continue;
        const mathField = article.querySelector<MathfieldElement>("math-field[data-answer-editor='math']");
        const textInput = article.querySelector<HTMLInputElement>("input[data-answer-editor='text']");
        const editor = mathField ?? textInput;
        if (!editor) continue;
        const rawAnswer = mathField ? mathField.getValue("latex-unstyled") : (textInput?.value ?? "");
        const isCorrect = exercise.answers.map(normalizeAnswer).includes(normalizeAnswer(rawAnswer));
        article.classList.toggle("is-correct", isCorrect);
        article.classList.toggle("is-error", !isCorrect);
        editor.classList.toggle("is-correct", isCorrect);
        editor.classList.toggle("is-error", !isCorrect);
        if (isCorrect) correctCount += 1;

        for (const [lessonIndex, key] of exercise.lessonKeys.entries()) {
          const current = lessonResults.get(key) ?? {
            title: exercise.lessonTitles[lessonIndex] ?? key,
            correct: 0,
            total: 0,
          };
          current.total += 1;
          if (isCorrect) current.correct += 1;
          lessonResults.set(key, current);
        }
      }

      feedback.textContent = `全${exercises.length}問中 ${correctCount}問正解です。`;
      feedback.className = `feedback exercise-feedback ${correctCount === exercises.length ? "is-correct" : "is-error"}`;
      if (mode === "unit") renderDiagnostic(lessonResults);
    });

    form.addEventListener("reset", () => {
      window.setTimeout(() => {
        for (const article of list.querySelectorAll<HTMLElement>(".exercise-question")) {
          article.classList.remove("is-correct", "is-error");
          const mathField = article.querySelector<MathfieldElement>("math-field[data-answer-editor='math']");
          const textInput = article.querySelector<HTMLInputElement>("input[data-answer-editor='text']");
          mathField?.setValue("");
          mathField?.classList.remove("is-correct", "is-error");
          textInput?.classList.remove("is-correct", "is-error");
        }
        feedback.textContent = "";
        feedback.className = "feedback exercise-feedback";
        diagnostic.hidden = true;
        diagnosticList.replaceChildren();
      }, 0);
    });

    regenerate.addEventListener("click", () => {
      renderExercises();
      feedback.textContent = "別の問題を生成しました。";
    });

    renderExercises();
  }
</script>
