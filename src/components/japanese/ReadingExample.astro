---
import type { JapaneseExample } from "../../content/japanese/types";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ReadingPassage from "./ReadingPassage.astro";

type Props = {
  example: JapaneseExample;
  classical?: boolean;
};

const { example: _example, classical: _classical = false } = Astro.props;
---

<article class="reading-example">
  <p class="label">EXAMPLE</p>
  <h3>例題</h3>
  {
    _example.passage && (
      <ReadingPassage text={_example.passage} label="例文" classical={_classical} />
    )
  }
  <p class="prompt">{_example.prompt}</p>
  <details>
    <summary>答えと読み方を確認する</summary>
    <div class="solution">
      <p class="answer"><span>答え</span>{_example.answer}</p>
      <ol>
        {_example.reasoning.map((reason) => <li>{reason}</li>)}
      </ol>
    </div>
  </details>
</article>

<style>
  .reading-example {
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid var(--color-border-soft);
    border-radius: 1rem;
    background: rgb(255 255 255 / 82%);
  }

  .label {
    margin: 0 0 0.55rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .prompt {
    margin: 1.1rem 0 0;
    color: var(--color-text-strong);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.9;
  }

  details {
    margin-top: 1.2rem;
    border-top: 1px solid var(--color-border-soft);
    padding-top: 1rem;
  }

  summary {
    width: fit-content;
    color: var(--color-link);
    cursor: pointer;
    font-weight: 800;
  }

  summary:focus-visible {
    border-radius: 0.2rem;
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  .solution {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 0.8rem;
    background: var(--surface-accent);
  }

  .answer {
    margin: 0;
    color: var(--color-accent-strong);
    font-weight: 700;
    line-height: 1.8;
  }

  .answer span {
    display: inline-block;
    margin-right: 0.7rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  ol {
    display: grid;
    gap: 0.55rem;
    margin: 0.9rem 0 0;
    padding-left: 1.5rem;
    color: var(--color-muted-strong);
    line-height: 1.75;
  }
</style>
