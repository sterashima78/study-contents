---
import { math1Course, type MathCourseInfo } from "../content/math-courses";
import type { MathArea, MathUnit } from "../content/math1/types";
import "../styles/global.css";
import "../styles/lesson.css";

type Props = {
  area: MathArea;
  unit: MathUnit;
  course?: MathCourseInfo;
};

const { area: _area, unit: _unit, course: _course = math1Course } = Astro.props;
const _base = import.meta.env.BASE_URL;
const _courseHomeHref = `${_base}${_course.homePath}`;
const _areaHref = `${_base}${_course.routeBase}/${_area.key}/`;
const _unitHref = `${_areaHref}${_unit.key}/`;
const _lessonHref = (lessonKey: string) => `${_unitHref}${lessonKey}/`;
const _exerciseHref = `${_unitHref}exercise/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`高校${_course.title}「${_unit.title}」の小単元一覧。1ページ1技能で学習し、最後に単元末演習で弱点を確認します。`}
    />
    <title>{_unit.title} | {_area.title} | {_course.title}</title>
  </head>
  <body>
    <main class="lesson-shell">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href={_courseHomeHref}>{_course.title}</a>
        <span aria-hidden="true">/</span>
        <a href={_areaHref}>{_area.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{_unit.title}</span>
      </nav>

      <header class="lesson-hero unit-hero">
        <p class="lesson-kicker">{_area.title}</p>
        <h1>{_unit.title}</h1>
        <p>{_unit.description}</p>
      </header>

      <section class="lesson-section unit-guide" aria-labelledby="guide-title">
        <p class="section-label">LEARNING FLOW</p>
        <h2 id="guide-title">小さく区切って順番に学ぶ</h2>
        <p class="unit-guide-description">
          各ページは1つの技能だけを扱います。考え方を確認し、細かい途中式の例題を見た直後に練習し、3問の確認演習で自力で解けるか確かめます。
        </p>
        <div class="learning-flow lesson-flow" aria-label="各小単元の流れ">
          <span>考え方</span>
          <span aria-hidden="true">→</span>
          <span>例題</span>
          <span aria-hidden="true">→</span>
          <span>直後の練習</span>
          <span aria-hidden="true">→</span>
          <span>3問確認</span>
          <span aria-hidden="true">→</span>
          <span>まとめ</span>
        </div>
      </section>

      <section class="lesson-section" aria-labelledby="lessons-title">
        <div class="section-heading lesson-heading">
          <div>
            <p class="section-label">LESSONS</p>
            <h2 id="lessons-title">小単元</h2>
          </div>
          <p>上から順に進めると、前の技能を使いながら学べます。</p>
        </div>

        <ol class="lesson-index-list">
          {
            _unit.lessons.map((lesson, index) => (
              <li>
                <a href={_lessonHref(lesson.key)}>
                  <span class="lesson-index-number">{String(index + 1).padStart(2, "0")}</span>
                  <span class="lesson-index-content">
                    <strong>{lesson.title}</strong>
                    <span>{lesson.description}</span>
                  </span>
                  <span class="lesson-index-meta">5〜10分</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="lesson-section unit-guide" aria-labelledby="unit-exercise-link-title">
        <p class="section-label">UNIT EXERCISE</p>
        <h2 id="unit-exercise-link-title">最後に単元全体を確認する</h2>
        <p class="unit-guide-description">
          基礎12問・応用3問・難問1問を自動採点し、各問題と小単元の対応から復習すべき技能を確認します。
        </p>
        <a class="primary-button" href={_exerciseHref}>単元末演習を始める</a>
      </section>

      <nav class="lesson-navigation" aria-label="教材ナビゲーション">
        <a href={_courseHomeHref}>← {_course.title}の目次へ</a>
        <a href={_lessonHref(_unit.lessons[0].key)}>最初の小単元から始める →</a>
      </nav>
    </main>
  </body>
</html>
