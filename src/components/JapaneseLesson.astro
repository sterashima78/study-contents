---
import type { JapaneseArea, JapaneseLesson as JapaneseLessonData, JapaneseUnit } from "../content/japanese/types";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import LanguagePoint from "./japanese/LanguagePoint.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PracticeQuestion from "./japanese/PracticeQuestion.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ReadingExample from "./japanese/ReadingExample.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import BreadcrumbTrail from "./ui/BreadcrumbTrail.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageFooter from "./ui/PageFooter.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "./ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SummaryPoints from "./ui/SummaryPoints.astro";

type LessonLink = {
  label: string;
  href: string;
};

type Props = {
  area: JapaneseArea;
  unit: JapaneseUnit;
  lesson: JapaneseLessonData;
  previous?: LessonLink;
  next?: LessonLink;
};

const {
  area: _area,
  unit: _unit,
  lesson: _lesson,
  previous: _previous,
  next: _next,
} = Astro.props as Props;
const _base = import.meta.env.BASE_URL;
const _classical = _area.key !== "gendai";
---

<StudyPage
  title={`${_lesson.title} | ${_area.title} | 国語 | 学習コンテンツ`}
  description={_lesson.goal}
>
  <BreadcrumbTrail
    items={[
      { label: "科目一覧", href: _base },
      { label: "国語", href: `${_base}japanese/` },
      { label: _area.title, href: `${_base}japanese/${_area.key}/` },
      { label: _unit.title, href: `${_base}japanese/${_area.key}/${_unit.key}/` },
      { label: _lesson.title },
    ]}
  />

  <ContentHero kicker={`${_area.kicker} / LESSON`} title={_lesson.title} description={_lesson.goal} compact />

  <ContentSection labelledby="point-title" compact>
    <SectionHeading
      label="READING POINT"
      title="読み方・ルール"
      id="point-title"
      description="最初に、このページで使う判断の手順を確認します。"
    />
    <LanguagePoint title={_lesson.title} paragraphs={_lesson.overview} points={_lesson.points} />
  </ContentSection>

  <ContentSection labelledby="example-title" compact>
    <SectionHeading
      label="EXAMPLE"
      title="短い例で確認"
      id="example-title"
      description="答えだけでなく、本文や文法のどこを根拠に判断するかを順に確認します。"
    />
    <ReadingExample example={_lesson.example} classical={_classical} />
  </ContentSection>

  <ContentSection labelledby="practice-title" compact>
    <SectionHeading
      label="PRACTICE"
      title="自分で判断する"
      id="practice-title"
      description="例題と同じ観点を使い、まず自分で答えてから解説を開きます。"
    />
    <PracticeQuestion
      prompt={_lesson.practice.prompt}
      choices={_lesson.practice.choices}
      answer={_lesson.practice.answer}
      explanation={_lesson.practice.explanation}
    />
  </ContentSection>

  <ContentSection labelledby="summary-title" compact>
    <SectionHeading label="SUMMARY" title="まとめ" id="summary-title" />
    <SummaryPoints items={_lesson.summary} />
  </ContentSection>

  <PageNavigation
    previous={_previous}
    center={{ label: `${_unit.title}へ戻る`, href: `${_base}japanese/${_area.key}/${_unit.key}/` }}
    next={_next}
  />

  <PageFooter
    items={[`高校 国語 / ${_area.title}`, `${_unit.title} / ${_lesson.title}`]}
    homeHref={_base}
  />
</StudyPage>
