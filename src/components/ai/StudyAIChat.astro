  }

  .study-ai-notice {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border-soft);
    background: var(--surface-subtle);
    color: var(--color-muted-strong);
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .study-ai-notice p {
    margin: 0;
  }

  .study-ai-notice p + p {
    margin-top: 0.2rem;
  }

  .study-ai-messages {
    overflow-y: auto;
    padding: 0.9rem 1rem;
