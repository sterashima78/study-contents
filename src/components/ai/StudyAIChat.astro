    padding: 0.72rem 1rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: 999px;
    color: var(--surface);
    background: var(--color-accent-strong);
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
    box-shadow: 0 0.5rem 1.6rem rgb(40 38 34 / 18%);
  }

