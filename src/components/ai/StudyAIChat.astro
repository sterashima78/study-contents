<div class="study-ai" data-study-ai-root data-study-ai-exclude>
  <button
    class="study-ai-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="study-ai-panel"
    data-study-ai-trigger
  >
    AIに質問
  </button>

  <aside
    class="study-ai-panel"
    id="study-ai-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="study-ai-title"
    hidden
    data-study-ai-panel
  >
    <header class="study-ai-header">
      <div>
        <p class="study-ai-kicker">LOCAL AI TUTOR</p>
        <h2 id="study-ai-title">この教材について質問</h2>
      </div>
      <div class="study-ai-header-actions">
        <button type="button" class="study-ai-text-button" data-study-ai-clear>履歴を消す</button>
        <button type="button" class="study-ai-close" aria-label="AIチャットを閉じる" data-study-ai-close>
          ×
        </button>
      </div>
    </header>

    <div class="study-ai-notice">
      <p>回答は端末内のAIモデルで生成します。初回利用時はモデルのダウンロードが必要です。</p>
      <p>AIは誤ることがあります。教材本文と照らして確認してください。</p>
    </div>

    <div
      class="study-ai-messages"
      role="log"
      aria-live="polite"
      aria-relevant="additions text"
      data-study-ai-messages
    ></div>

    <div class="study-ai-runtime">
      <p class="study-ai-status" data-study-ai-status>質問を送信するとAIモデルを読み込みます。</p>
      <progress class="study-ai-progress" max="1" value="0" hidden data-study-ai-progress></progress>
      <details class="study-ai-diagnostics" hidden data-study-ai-diagnostics>
        <summary>診断情報</summary>
        <p>質問内容や教材本文、会話履歴は含みません。</p>
        <pre data-study-ai-diagnostics-text></pre>
      </details>
    </div>

    <form class="study-ai-form" data-study-ai-form>
      <label for="study-ai-input">質問</label>
      <textarea
        id="study-ai-input"
        name="question"
        rows="3"
        maxlength="1000"
        placeholder="例: この公式をなぜ使うの？"
        required
        data-study-ai-input
      ></textarea>
      <div class="study-ai-form-actions">
        <button type="button" class="study-ai-stop" hidden data-study-ai-stop>停止</button>
        <button type="submit" class="study-ai-send" data-study-ai-send>送信</button>
      </div>
    </form>
  </aside>
</div>

<script>
  import {
    buildStudyAIDiagnostics,
    getStudyAIEngine,
    interruptStudyAI,
    supportsStudyAI,
  } from "../../lib/ai/browser-engine";
  import { buildStudyContext } from "../../lib/ai/study-context";
  import { buildStudySystemPrompt } from "../../lib/ai/system-prompt";

  type ChatMessage = {
    role: "user" | "assistant";
    content: string;
  };

  const root = document.querySelector<HTMLElement>("[data-study-ai-root]");
  if (root) {
    const trigger = root.querySelector<HTMLButtonElement>("[data-study-ai-trigger]");
    const panel = root.querySelector<HTMLElement>("[data-study-ai-panel]");
    const closeButton = root.querySelector<HTMLButtonElement>("[data-study-ai-close]");
    const clearButton = root.querySelector<HTMLButtonElement>("[data-study-ai-clear]");
    const messages = root.querySelector<HTMLElement>("[data-study-ai-messages]");
    const status = root.querySelector<HTMLElement>("[data-study-ai-status]");
    const progress = root.querySelector<HTMLProgressElement>("[data-study-ai-progress]");
    const diagnostics = root.querySelector<HTMLDetailsElement>("[data-study-ai-diagnostics]");
    const diagnosticsText = root.querySelector<HTMLElement>("[data-study-ai-diagnostics-text]");
    const form = root.querySelector<HTMLFormElement>("[data-study-ai-form]");
    const input = root.querySelector<HTMLTextAreaElement>("[data-study-ai-input]");
    const sendButton = root.querySelector<HTMLButtonElement>("[data-study-ai-send]");
    const stopButton = root.querySelector<HTMLButtonElement>("[data-study-ai-stop]");

    if (
      trigger &&
      panel &&
      closeButton &&
      clearButton &&
      messages &&
      status &&
      progress &&
      diagnostics &&
      diagnosticsText &&
      form &&
      input &&
      sendButton &&
      stopButton
    ) {
      const storageKey = `study-ai-chat:${window.location.pathname}`;
      let history = loadHistory(storageKey);
      let generating = false;

      const scrollToLatest = () => {
        messages.scrollTop = messages.scrollHeight;
      };

      const appendMessage = (message: ChatMessage) => {
        const article = document.createElement("article");
        article.className = `study-ai-message is-${message.role}`;
        const label = document.createElement("p");
        label.className = "study-ai-message-label";
        label.textContent = message.role === "user" ? "あなた" : "AIチューター";
        const body = document.createElement("p");
        body.className = "study-ai-message-body";
        body.textContent = message.content;
        article.append(label, body);
        messages.append(article);
        scrollToLatest();
        return body;
      };

      const renderHistory = () => {
        messages.replaceChildren();
        if (history.length === 0) {
          appendMessage({
            role: "assistant",
            content: "このページの内容をもとに説明します。分からない箇所をそのまま質問してください。",
          });
          return;
        }
        for (const message of history) appendMessage(message);
      };

      const setGenerating = (value: boolean) => {
        generating = value;
        input.disabled = value;
        sendButton.disabled = value;
        stopButton.hidden = !value;
      };

      const clearDiagnostics = () => {
        diagnostics.hidden = true;
        diagnostics.open = false;
        diagnosticsText.textContent = "";
      };

      const openPanel = () => {
        panel.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        if (!supportsStudyAI()) {
          status.textContent =
            "このブラウザはWebGPUに対応していないため、端末内AIを利用できません。";
          input.disabled = true;
          sendButton.disabled = true;
        }
        window.setTimeout(() => input.focus(), 0);
      };

      const closePanel = () => {
        panel.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      };

      trigger.addEventListener("click", () => {
        if (panel.hidden) openPanel();
        else closePanel();
      });
      closeButton.addEventListener("click", closePanel);

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !panel.hidden) closePanel();
      });

      clearButton.addEventListener("click", () => {
        history = [];
        saveHistory(storageKey, history);
        renderHistory();
        clearDiagnostics();
        status.textContent = "会話履歴を消去しました。";
      });

      stopButton.addEventListener("click", async () => {
        if (!generating) return;
        stopButton.disabled = true;
        status.textContent = "生成を停止しています…";
        try {
          await interruptStudyAI();
        } finally {
          stopButton.disabled = false;
        }
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (generating || !supportsStudyAI()) return;
        const question = input.value.trim();
        if (!question) return;

        const userMessage: ChatMessage = { role: "user", content: question };
        history.push(userMessage);
        history = history.slice(-10);
        saveHistory(storageKey, history);
        appendMessage(userMessage);
        input.value = "";
        clearDiagnostics();
        setGenerating(true);

        const assistantBody = appendMessage({ role: "assistant", content: "考えています…" });
        let answer = "";
        let finishReason: string | null = null;
        try {
          const engine = await getStudyAIEngine((report) => {
            progress.hidden = false;
            progress.value = Number.isFinite(report.progress) ? report.progress : 0;
            const percent = Math.round(progress.value * 100);
            status.textContent = `AIモデルを読み込み中… ${percent}%`;
          });
          progress.hidden = true;
          status.textContent = "このページの内容を参照して回答しています…";

          const recentHistory = history.slice(-3).map((message) => ({
            ...message,
            content: message.content.slice(0, 600),
          }));
          const stream = await engine.chat.completions.create({
            messages: [
              { role: "system", content: buildStudySystemPrompt(buildStudyContext(question)) },
              ...recentHistory,
            ],
            stream: true,
            temperature: 0.4,
            top_p: 0.9,
            max_tokens: 512,
            enable_thinking: false,
          });

          for await (const chunk of stream) {
            const choice = chunk.choices[0];
            answer += choice?.delta?.content ?? "";
            finishReason = choice?.finish_reason ?? finishReason;
            assistantBody.textContent = visibleAssistantText(answer) || "考えています…";
            scrollToLatest();
          }

          const visibleAnswer = visibleAssistantText(answer).trim();
          if (!visibleAnswer) throw new Error("The model returned an empty response.");
          const completedAnswer =
            finishReason === "length"
              ? `${visibleAnswer}\n\n回答が長いためここで区切りました。「続き」と入力してください。`
              : visibleAnswer;
          assistantBody.textContent = completedAnswer;
          history.push({ role: "assistant", content: completedAnswer });
          history = history.slice(-10);
          saveHistory(storageKey, history);
          status.textContent =
            finishReason === "length"
              ? "回答が長いため途中で区切りました。続きから再開できます。"
              : "端末内AIで回答しました。";
        } catch (error) {
          console.error("Study AI failed", error);
          progress.hidden = true;
          assistantBody.textContent = studyAIErrorMessage(error);
          diagnosticsText.textContent = await buildStudyAIDiagnostics(error);
          diagnostics.hidden = false;
          diagnostics.open = true;
          status.textContent = "AIの実行に失敗しました。診断情報を確認してください。";
        } finally {
          setGenerating(false);
          input.focus();
        }
      });

      renderHistory();
    }
  }

  function visibleAssistantText(value: string) {
    return value
      .replace(/<think>[\s\S]*?<\/think>\s*/gi, "")
      .replace(/^<think>[\s\S]*$/gi, "")
      .trimStart();
  }

  function loadHistory(key: string): ChatMessage[] {
    try {
      const raw = sessionStorage.getItem(key);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed
        .filter(
          (item): item is ChatMessage =>
            item &&
            (item.role === "user" || item.role === "assistant") &&
            typeof item.content === "string",
        )
        .map((item) => ({ ...item, content: item.content.slice(0, 4000) }))
        .slice(-10);
    } catch {
      return [];
    }
  }

  function saveHistory(key: string, history: ChatMessage[]) {
    try {
      sessionStorage.setItem(key, JSON.stringify(history));
    } catch {
      // Storage can be unavailable in privacy modes. Chat still works without persistence.
    }
  }

  function studyAIErrorMessage(error: unknown) {
    const message = error instanceof Error ? error.message : String(error);
    if (/WebGPU|GPUAdapter|shader-f16/i.test(message)) {
      return "この端末のWebGPU環境ではAIモデルを実行できませんでした。診断情報を確認してください。";
    }
    if (/device lost|device hung|disposed/i.test(message)) {
      return "WebGPUの処理が停止しました。ブラウザを再起動してから、診断情報を確認してください。";
    }
    if (/out of memory|memory allocation|allocation failed|OOM/i.test(message)) {
      return "AIモデルの実行に必要なメモリを確保できなかった可能性があります。診断情報を確認してください。";
    }
    if (/failed to fetch|network|http error/i.test(message)) {
      return "AIモデルの取得に失敗した可能性があります。通信状態と診断情報を確認してください。";
    }
    if (/onnx|inference session|session creation/i.test(message)) {
      return "ONNXモデルの初期化に失敗した可能性があります。診断情報を確認してください。";
    }
    return "AIの実行に失敗しました。診断情報を確認してください。";
  }
</script>

<style>
