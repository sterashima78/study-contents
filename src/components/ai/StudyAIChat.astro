    outline-offset: 0.2rem;
  }

  .study-ai-panel {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: 5.2rem;
    z-index: 41;
    display: grid;
    grid-template-rows: auto auto minmax(8rem, 1fr) auto auto;
    width: min(29rem, calc(100vw - 2rem));
    height: min(40rem, calc(100vh - 7rem));
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: 0 1rem 3rem rgb(40 38 34 / 20%);
  }

  .study-ai-panel[hidden] {
    display: none;
  }

  .study-ai-header {
