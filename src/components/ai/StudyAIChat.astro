  }

  .study-ai-text-button {
    padding: 0.42rem 0.55rem;
    color: var(--color-muted-strong);
    font-size: 0.7rem;
  }

  .study-ai-close {
    width: 2rem;
    height: 2rem;
    padding: 0;
    font-size: 1.2rem;
