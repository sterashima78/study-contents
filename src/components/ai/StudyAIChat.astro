    justify-content: space-between;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .study-ai-kicker {
    margin: 0 0 0.18rem;
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

