---
import { findAdvancedTopicSet } from "../content/entrance/advanced-topic-sets";
import {
  getCourseCurriculumKey,
  getCourseScopeLabel,
  type MathCourseInfo,
  math1Course,
} from "../content/math-courses";
import type { MathArea } from "../content/math1/types";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import BreadcrumbTrail from "./ui/BreadcrumbTrail.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "./ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "./ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";

type AdvancedLink = {
  href: string;
  patternCount: number;
};

type Props = {
  area: MathArea;
  course?: MathCourseInfo;
  advanced?: AdvancedLink;
};

const { area: _area, course: _course = math1Course, advanced: _advanced } = Astro.props;
const _base = import.meta.env.BASE_URL;
const _courseHomeHref = `${_base}${_course.homePath}`;
const _areaHref = `${_base}${_course.routeBase}/${_area.key}/`;
const _lessonCount = _area.units.reduce((sum, unit) => sum + unit.lessons.length, 0);
const _advancedTopicSet = findAdvancedTopicSet(_course.key, _area.key);
const _scopeLabel = getCourseScopeLabel(_course);
const _curriculumKey = getCourseCurriculumKey(_course);
const _resolvedAdvanced =
  _advanced ??
  (_advancedTopicSet
    ? {
        href: `${_base}${_course.routeBase}/entrance/${_area.key}/`,
        patternCount: _advancedTopicSet.patterns.length,
      }
    : undefined);
const _unitItems = _area.units.map((unit, index) => ({
  marker: String(index + 1).padStart(2, "0"),
  title: unit.title,
  href: `${_areaHref}${unit.key}/`,
  description: unit.description,
  meta: `${unit.lessons.length}小教材`,
}));
---

<StudyPage
  title={`${_area.title} | ${_course.title}`}
  description={`${_scopeLabel}「${_area.title}」の単元一覧。${_lessonCount}個の小教材で学習します。`}
  curriculumKey={_curriculumKey}
>
  <BreadcrumbTrail items={[{ label: _course.title, href: _courseHomeHref }, { label: _area.title }]} />
  <ContentHero kicker={_course.kicker} title={_area.title} description={_area.description} />

  <ContentSection labelledby="units-title">
    <SectionHeading
      label="UNITS"
      title="学習する単元"
      id="units-title"
      description={`${_lessonCount}個の小教材を、単元ごとに順番に学習します。`}
    />
    <ContentIndex items={_unitItems} />
  </ContentSection>

  {
    _resolvedAdvanced && (
      <ContentSection labelledby="advanced-title">
        <SectionHeading
          label="APPLICATION & ADVANCED"
          title="応用・発展へ進む"
          id="advanced-title"
          description="基礎技能を組み合わせ、問題文から解法を選ぶ練習をパターンごとに行います。"
        />
        <ContentIndex
          items={[
            {
              marker: "A",
              title: `${_area.title} 応用・発展`,
              href: _resolvedAdvanced.href,
              description: "考え方 → 例題 → ステップ練習 → 実践の順で、1パターン1ページで学びます。",
              meta: `${_resolvedAdvanced.patternCount}パターン`,
            },
          ]}
        />
      </ContentSection>
    )
  }

  <PageNavigation
    previous={{ label: `← ${_course.title}の目次へ`, href: _courseHomeHref }}
    next={{ label: "最初の単元から始める →", href: `${_areaHref}${_area.units[0].key}/` }}
  />
</StudyPage>
