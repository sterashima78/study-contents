---
import type { EnglishCourseInfo } from "../content/english/course";
import type { EnglishArea } from "../content/english/types";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ActionPanel from "./ui/ActionPanel.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "./ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import LearningFlow from "./ui/LearningFlow.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageFooter from "./ui/PageFooter.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";

type Props = {
  course: EnglishCourseInfo;
  areas: EnglishArea[];
};

const { course: _course, areas: _areas } = Astro.props as Props;
const _base = import.meta.env.BASE_URL;
const _areaItems = _areas.map((area, index) => {
  const lessonCount = area.units.reduce((sum, unit) => sum + unit.lessons.length, 0);
  return {
    marker: String(index + 1).padStart(2, "0"),
    title: area.title,
    href: `${_base}${_course.routeBase}/${area.key}/`,
    description: area.description,
    links: area.units.map((unit) => ({
      label: unit.title,
      href: `${_base}${_course.routeBase}/${area.key}/${unit.key}/`,
    })),
    meta: `${lessonCount}小教材公開`,
  };
});
const _totalLessonCount = _areas.reduce(
  (sum, area) => sum + area.units.reduce((unitSum, unit) => unitSum + unit.lessons.length, 0),
  0,
);
---

<StudyPage
  title="英語 | 学習コンテンツ"
  description="高校英語の学習コンテンツ。英語基礎、英文解釈、長文読解、論理・表現をオリジナル英文で学べます。"
  width="wide"
>
  <ContentHero
    kicker={_course.kicker}
    title={_course.title}
    description="文法事項を単独で暗記するだけでなく、英文の構造を読み、情報を取り出し、論理的に表現するところまでを一続きで学びます。"
    variant="display"
  >
    <LearningFlow
      label="各小単元の学習の流れ"
      steps={["要点", "英文・例文", "構造分析", "直後の練習", "まとめ"]}
    />
  </ContentHero>

  <ContentSection labelledby="curriculum-title">
    <SectionHeading
      label="CONTENTS"
      title={`学習する${_areas.length}つの領域`}
      id="curriculum-title"
      description={`全${_totalLessonCount}小教材。基礎から読解・表現へ進み、1ページ1技能で学習します。`}
    />
    <ContentIndex items={_areaItems} variant="grid" />
  </ContentSection>

  <ActionPanel
    label="RIGHTS"
    title="オリジナル英文で学ぶ"
    description="この英語コースに収録する英文・例文・設問・解説は、このリポジトリ向けに作成したオリジナル教材です。教科書、市販問題集、入試問題、記事本文の転載は行いません。"
  />

  <PageFooter
    items={["高校 英語", "英語基礎・英文解釈・長文読解・論理／表現を16小教材で学習できます。"]}
    homeHref={_base}
  />
</StudyPage>
