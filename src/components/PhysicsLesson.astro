---
import { designPracticeSteps } from "../content/answer-input-design";
import { type MathCourseInfo, physicsBasicsCourse, physicsCourse } from "../content/math-courses";
import type { MathArea, MathLesson, MathUnit } from "../content/math1/types";
import { getPhysicsFormulaDerivation } from "../content/physics/formula-derivations";
import { getPhysicsBasicsFormulaDerivation } from "../content/physics-basics/formula-derivations";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PhysicsExerciseSet from "./PhysicsExerciseSet.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import BreadcrumbTrail from "./ui/BreadcrumbTrail.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ConceptCard from "./ui/ConceptCard.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import GuidedPractice from "./ui/GuidedPractice.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "./ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SummaryPoints from "./ui/SummaryPoints.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import WorkedExample from "./ui/WorkedExample.astro";

type Props = {
  area: MathArea;
  unit: MathUnit;
  lesson: MathLesson;
  course?: MathCourseInfo;
  physicsLevel?: "basics" | "physics";
};

const {
  area: _area,
  unit: _unit,
  lesson: _lesson,
  course: _course = physicsBasicsCourse,
  physicsLevel: _physicsLevel = "basics",
} = Astro.props;
const _base = import.meta.env.BASE_URL;
const _resolvedCourse = _physicsLevel === "physics" ? physicsCourse : _course;
const _courseHomeHref = `${_base}${_resolvedCourse.homePath}`;
const _lessonIndex = _unit.lessons.findIndex((item) => item.key === _lesson.key);
const _previousLesson = _lessonIndex > 0 ? _unit.lessons[_lessonIndex - 1] : undefined;
const _nextLesson =
  _lessonIndex < _unit.lessons.length - 1 ? _unit.lessons[_lessonIndex + 1] : undefined;
const _areaHref = `${_base}${_resolvedCourse.routeBase}/${_area.key}/`;
const _unitHref = `${_areaHref}${_unit.key}/`;
const _unitExerciseHref = `${_unitHref}exercise/`;
const _lessonHref = (lessonKey: string) => `${_unitHref}${lessonKey}/`;
const _practiceSteps = designPracticeSteps(_resolvedCourse.key, _lesson.practice.steps);
const _formulaDerivation =
  _physicsLevel === "physics"
    ? getPhysicsFormulaDerivation(_lesson.key)
    : getPhysicsBasicsFormulaDerivation(_lesson.key);
---

<StudyPage
  title={`${_lesson.title} | ${_unit.title} | ${_resolvedCourse.title}`}
  description={`高校${_resolvedCourse.title}「${_lesson.title}」の教材。考え方、式の根拠、例題、直後の練習、3問確認で学習します。`}
>
  <BreadcrumbTrail
    items={[
      { label: _resolvedCourse.title, href: _courseHomeHref },
      { label: _area.title, href: _areaHref },
      { label: _unit.title, href: _unitHref },
      { label: _lesson.title },
    ]}
  />
  <ContentHero
    kicker={`${_area.title} · ${String(_lessonIndex + 1).padStart(2, "0")}`}
    title={_lesson.title}
    description={_lesson.description}
    compact
  />

  <ContentSection labelledby="goal-title" compact>
    <SectionHeading label="GOAL" title="このページでできるようになること" id="goal-title" />
    <SummaryPoints items={_lesson.goals} />
  </ContentSection>

  <ContentSection labelledby="rule-title">
    <SectionHeading
      label="RULE"
      title="考え方・物理法則"
      id="rule-title"
      description="物理量の意味、向き、単位、成り立つ条件を確認してから式を使います。"
    />
    <div class="concept-list">
      {_lesson.concepts.map((concept) => <ConceptCard {...concept} />)}
    </div>
    {
      _formulaDerivation && (
        <div class="derivation">
          <WorkedExample
            label="DERIVATION"
            title={_formulaDerivation.title}
            introduction={_formulaDerivation.introduction}
            steps={_formulaDerivation.steps.map((step) => ({
              expression: step.expression,
              note: step.note,
            }))}
          />
        </div>
      )
    }
  </ContentSection>

  <ContentSection labelledby="example-title">
    <SectionHeading label="EXAMPLE" title={_lesson.example.title} id="example-title" />
    <WorkedExample
      problem={_lesson.example.problem}
      steps={_lesson.example.steps.map((step) => ({ expression: step.expression, note: step.note }))}
    />
    <GuidedPractice
      title={_lesson.practice.title}
      problem={_lesson.practice.problem}
      steps={_practiceSteps}
      hint={_lesson.practice.hint}
      position="例題の直後に確認"
      successMessage="すべて正解です。物理量の意味と計算手順を再現できています。"
      errorMessage="単位と符号も含めて例題と比べてください。"
    />
  </ContentSection>

  <PhysicsExerciseSet
    mode="lesson"
    areaKey={_area.key}
    unitKey={_unit.key}
    lessonKey={_lesson.key}
    physicsLevel={_physicsLevel}
    courseRoute={_resolvedCourse.routeBase}
  />

  <ContentSection labelledby="summary-title" compact>
    <SectionHeading label="SUMMARY" title="このページのポイント" id="summary-title" />
    <SummaryPoints items={_lesson.summary} />
  </ContentSection>

  <PageNavigation
    previous={
      _previousLesson
        ? { label: `← ${_previousLesson.title}`, href: _lessonHref(_previousLesson.key) }
        : { label: `← ${_unit.title}の目次`, href: _unitHref }
    }
    center={{ label: `${_unit.title}の小単元一覧`, href: _unitHref }}
    next={
      _nextLesson
        ? { label: `${_nextLesson.title} →`, href: _lessonHref(_nextLesson.key) }
        : { label: "単元末演習へ →", href: _unitExerciseHref }
    }
  />
</StudyPage>

<style>
  .concept-list {
    display: grid;
    gap: 1rem;
  }

  .derivation {
    margin-top: 1rem;
  }
</style>
