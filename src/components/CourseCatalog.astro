---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "./ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ExperimentalNotice from "./ui/ExperimentalNotice.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageFooter from "./ui/PageFooter.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";

type CourseItem = {
  title: string;
  kicker: string;
  href: string;
  description: string;
  areas: string[];
  lessonCount: number;
};

type Props = {
  courses: CourseItem[];
};

const { courses: _courses } = Astro.props as Props;
const _items = _courses.map((course, index) => ({
  marker: String(index + 1).padStart(2, "0"),
  kicker: course.kicker,
  title: course.title,
  href: course.href,
  description: course.description,
  tags: course.areas,
  meta: `${course.lessonCount}教材`,
  action: "目次へ →",
}));
---

<StudyPage
  title="高校学習コンテンツ"
  description="高校の数学・理科・英語・国語を、単元ごとの短い解説、例題、練習で学べる学習コンテンツです。"
  width="wide"
>
  <ContentHero
    kicker="HIGH SCHOOL STUDY NOTES"
    title="高校の学びを、ひとつずつ。"
    description="科目を選び、短い解説と例題・練習を順に進めます。必要なところから、ノートをめくるように学べます。"
    variant="display"
  />

  <ContentSection labelledby="courses-title" compact>
    <SectionHeading
      label="COURSES"
      title="科目からはじめる"
      id="courses-title"
      description="学びたい科目を選んでください。各科目の目次から、領域・単元・小単元へ進めます。"
    />
    <ContentIndex items={_items} variant="grid" density="compact" />
  </ContentSection>

  <ExperimentalNotice />

  <PageFooter items={["高校学習コンテンツ", "短い解説と演習を、必要なところから。"]} />
</StudyPage>
