---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "./ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ExperimentalNotice from "./ui/ExperimentalNotice.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageFooter from "./ui/PageFooter.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";

type CourseItem = {
  title: string;
  kicker: string;
  href: string;
  description: string;
  areas: string[];
  lessonCount: number;
};

type CourseGroup = {
  label: string;
  title: string;
  id: string;
  description: string;
  courses: CourseItem[];
};

type Props = {
  middleSchoolCourses: CourseItem[];
  highSchoolGroups: CourseGroup[];
  middleSchoolOverviewHref?: string;
};

const _base = import.meta.env.BASE_URL;
const {
  middleSchoolCourses: _middleSchoolCourses,
  highSchoolGroups: _highSchoolGroups,
  middleSchoolOverviewHref: _middleSchoolOverviewHref = `${_base}middle-school/`,
} = Astro.props as Props;

const _toItems = (courses: CourseItem[], action: string) =>
  courses.map((course, index) => ({
    marker: String(index + 1).padStart(2, "0"),
    kicker: course.kicker,
    title: course.title,
    href: course.href,
    description: course.description,
    tags: course.areas,
    meta: `${course.lessonCount}教材`,
    action,
  }));

const _middleSchoolItems = _toItems(_middleSchoolCourses, "教科の目次へ →");
---

<StudyPage
  title="学習コンテンツ"
  description="生成AIを使って、中学校・高等学校範囲の学習コンテンツを構成・改善する実験です。"
  width="wide"
>
  <ContentHero
    kicker="EXPERIMENTAL STUDY CONTENTS"
    title="学習コンテンツ"
    description="生成AIを使って、中学校・高等学校範囲の学習コンテンツを構成・改善する実験です。教材は学校段階ごとに整理し、学びたい教科・科目からはじめる構成です。"
    variant="display"
  />

  <ExperimentalNotice />

  <ContentSection labelledby="middle-school-title" compact>
    <SectionHeading
      label="LOWER SECONDARY"
      title="中学校の教科からはじめる"
      id="middle-school-title"
      description="数学・理科・英語はいずれも1〜3年を公開しています。学びたい教科から直接進めます。"
    />
    <ContentIndex items={_middleSchoolItems} variant="grid" density="compact" />
    <p class="overview-link">
      <a href={_middleSchoolOverviewHref}>中学校の教材全体を見る →</a>
    </p>
  </ContentSection>

  {
    _highSchoolGroups.map((group) => (
      <ContentSection labelledby={group.id} compact>
        <SectionHeading
          label={`UPPER SECONDARY · ${group.label}`}
          title={group.title}
          id={group.id}
          description={group.description}
        />
        <ContentIndex items={_toItems(group.courses, "目次へ →")} variant="grid" density="compact" />
      </ContentSection>
    ))
  }

  <PageFooter items={["学習コンテンツ", "生成AIを使った実験的な学習コンテンツ"]} />
</StudyPage>

<style>
  .overview-link {
    margin: 0.85rem 0 0;
    text-align: right;
  }

  .overview-link a {
    color: var(--color-link);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.22em;
  }

  .overview-link a:focus-visible {
    border-radius: 0.1rem;
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .overview-link a:hover {
      color: var(--color-link-hover);
    }
  }
</style>
