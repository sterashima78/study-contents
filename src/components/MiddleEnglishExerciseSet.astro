---
import "../styles/exercise.css";

type Props = {
  mode: "lesson" | "unit";
  routeBase: string;
  areaKey: string;
  unitKey: string;
  lessonKey?: string;
};

const {
  mode: _mode,
  routeBase: _routeBase,
  areaKey: _areaKey,
  unitKey: _unitKey,
  lessonKey: _lessonKey,
} = Astro.props;
const _base = import.meta.env.BASE_URL;
const _isUnit = _mode === "unit";
---

<section
  class:list={["exercise-set", _isUnit && "unit-exercise-set"]}
  data-middle-english-exercise-set
  data-mode={_mode}
  data-route-base={_routeBase}
  data-area-key={_areaKey}
  data-unit-key={_unitKey}
  data-lesson-key={_lessonKey}
  data-base={_base}
  aria-labelledby={_isUnit ? "middle-english-unit-exercise-title" : "middle-english-lesson-check-title"}
>
  <div class="exercise-heading">
    <div>
      <h2 id={_isUnit ? "middle-english-unit-exercise-title" : "middle-english-lesson-check-title"}>
        {_isUnit ? "単元末演習" : "理解を確認する3問"}
      </h2>
    </div>
    <p>
      {
        _isUnit
          ? "基礎・応用・難問を全8問で採点し、小単元ごとの理解度を確認します。"
          : "例題と練習のあと、誘導なしで3問解いて語順と形を確認します。"
      }
    </p>
  </div>

  <div class="exercise-toolbar">
    <p class="exercise-count-note">
      {_isUnit ? "全8問 · 対応小単元を各問題に表示" : "全3問 · すべてこの小単元の確認問題"}
    </p>
    <button type="button" class="secondary-button exercise-regenerate">別の問題を作る</button>
  </div>

  <form class="exercise-form">
    <div class="exercise-list" data-exercise-list></div>
    <div class="exercise-actions">
      <button type="submit" class="primary-button">採点する</button>
      <button type="reset" class="secondary-button">回答を消す</button>
    </div>
  </form>

  <p class="feedback exercise-feedback" aria-live="polite"></p>
  <section class="exercise-diagnostic" data-exercise-diagnostic hidden aria-labelledby="middle-english-diagnostic-title">
    <h3 id="middle-english-diagnostic-title">小単元ごとの理解度</h3>
    <p>正答率が低い小単元から復習すると、語順や形の混同を絞れます。</p>
    <div class="diagnostic-list" data-diagnostic-list></div>
  </section>

  <noscript>演習問題の生成と採点には JavaScript が必要です。</noscript>
</section>

<script>
  import {
    generateMiddleEnglish1LessonExercises,
    generateMiddleEnglish1UnitExercises,
    type MiddleEnglishExercise,
  } from "../content/middle-school/english/grade1/exercise-registry";

  const normalizeAnswer = (value: string) =>
    value
      .trim()
      .toLowerCase()
      .replaceAll("’", "'")
      .replaceAll("‘", "'")
      .replaceAll(/\s+/g, " ")
      .replaceAll(/\s+([?.!,])/g, "$1");

  const difficultyLabel: Record<MiddleEnglishExercise["difficulty"], string> = {
    basic: "基礎",
    applied: "応用",
    challenge: "難問",
  };

  const createElement = <K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    if (text !== undefined) element.textContent = text;
    return element;
  };

  for (const section of document.querySelectorAll<HTMLElement>("[data-middle-english-exercise-set]")) {
    const mode = section.dataset.mode;
    const routeBase = section.dataset.routeBase;
    const areaKey = section.dataset.areaKey;
    const unitKey = section.dataset.unitKey;
    const lessonKey = section.dataset.lessonKey;
    const base = section.dataset.base ?? "/";
    const form = section.querySelector<HTMLFormElement>(".exercise-form");
    const list = section.querySelector<HTMLElement>("[data-exercise-list]");
    const feedback = section.querySelector<HTMLElement>(".exercise-feedback");
    const regenerate = section.querySelector<HTMLButtonElement>(".exercise-regenerate");
    const diagnostic = section.querySelector<HTMLElement>("[data-exercise-diagnostic]");
    const diagnosticList = section.querySelector<HTMLElement>("[data-diagnostic-list]");
    if (!routeBase || !areaKey || !unitKey || !form || !list || !feedback || !regenerate || !diagnostic || !diagnosticList) {
      continue;
    }

    let exercises: MiddleEnglishExercise[] = [];

    const makeExercises = () =>
      mode === "unit"
        ? generateMiddleEnglish1UnitExercises(unitKey)
        : lessonKey
          ? generateMiddleEnglish1LessonExercises(unitKey, lessonKey)
          : [];

    const renderExercises = () => {
      exercises = makeExercises();
      list.replaceChildren();
      diagnostic.hidden = true;
      diagnosticList.replaceChildren();
      feedback.textContent = "";
      feedback.className = "feedback exercise-feedback";

      for (const [index, exercise] of exercises.entries()) {
        const article = createElement("article", "exercise-question");
        const header = createElement("div", "exercise-question-header");
        header.append(
          createElement("span", "exercise-number", `問${index + 1}`),
          createElement(
            "span",
            `exercise-difficulty difficulty-${exercise.difficulty}`,
            difficultyLabel[exercise.difficulty],
          ),
        );
        const prompt = createElement("p", "exercise-prompt", exercise.prompt);
        const mapping = createElement(
          "p",
          "exercise-mapping",
          `対応: ${exercise.lessonTitles.join(" / ")}`,
        );
        const answerBlock = createElement("div", "exercise-answer-label");
        const answerId = `middle-english-answer-${exercise.id}-${index}`;
        const label = createElement("label", undefined, "答え");
        label.htmlFor = answerId;
        const input = document.createElement("input");
        input.id = answerId;
        input.type = "text";
        input.className = "exercise-answer-editor exercise-text-input";
        input.autocomplete = "off";
        input.spellcheck = false;
        input.required = true;
        input.dataset.answerEditor = "text";
        input.setAttribute("aria-label", `問${index + 1}の英語の答え`);
        answerBlock.append(label, input);
        article.append(header, prompt, mapping, answerBlock);

        if (exercise.hint) {
          const details = createElement("details", "exercise-hint");
          details.append(
            createElement("summary", undefined, "ヒント"),
            createElement("p", undefined, exercise.hint),
          );
          article.append(details);
        }
        list.append(article);
      }
    };

    const renderDiagnostic = (
      results: Map<string, { title: string; correct: number; total: number }>,
    ) => {
      diagnosticList.replaceChildren();
      const sorted = [...results.entries()].sort(
        ([, a], [, b]) => a.correct / a.total - b.correct / b.total,
      );
      for (const [key, result] of sorted) {
        const item = createElement("article", "diagnostic-item");
        const ratio = result.total === 0 ? 0 : result.correct / result.total;
        const link = createElement("a", "diagnostic-link", "この小単元を復習する");
        link.href = `${base}${routeBase}/${areaKey}/${unitKey}/${key}/`;
        item.append(
          createElement("h4", undefined, result.title),
          createElement("p", "diagnostic-score", `${result.correct}/${result.total} 正解`),
          createElement(
            "p",
            ratio === 1 ? "diagnostic-status is-strong" : "diagnostic-status is-weak",
            ratio === 1 ? "理解できています" : "復習候補",
          ),
          link,
        );
        diagnosticList.append(item);
      }
      diagnostic.hidden = false;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      let correctCount = 0;
      const lessonResults = new Map<string, { title: string; correct: number; total: number }>();

      for (const [index, article] of [...list.querySelectorAll<HTMLElement>(".exercise-question")].entries()) {
        const exercise = exercises[index];
        if (!exercise) continue;
        const input = article.querySelector<HTMLInputElement>("input[data-answer-editor='text']");
        const answer = normalizeAnswer(input?.value ?? "");
        const isCorrect = exercise.answers.map(normalizeAnswer).includes(answer);
        article.classList.toggle("is-correct", isCorrect);
        article.classList.toggle("is-error", !isCorrect);
        input?.classList.toggle("is-correct", isCorrect);
        input?.classList.toggle("is-error", !isCorrect);
        if (isCorrect) correctCount += 1;

        for (const [lessonIndex, key] of exercise.lessonKeys.entries()) {
          const current = lessonResults.get(key) ?? {
            title: exercise.lessonTitles[lessonIndex] ?? key,
            correct: 0,
            total: 0,
          };
          current.total += 1;
          if (isCorrect) current.correct += 1;
          lessonResults.set(key, current);
        }
      }

      feedback.textContent = `全${exercises.length}問中 ${correctCount}問正解です。`;
      feedback.className = `feedback exercise-feedback ${correctCount === exercises.length ? "is-correct" : "is-error"}`;
      if (mode === "unit") renderDiagnostic(lessonResults);
    });

    form.addEventListener("reset", () => {
      window.setTimeout(() => {
        for (const article of list.querySelectorAll<HTMLElement>(".exercise-question")) {
          article.classList.remove("is-correct", "is-error");
          const input = article.querySelector<HTMLInputElement>("input[data-answer-editor='text']");
          input?.classList.remove("is-correct", "is-error");
        }
        feedback.textContent = "";
        feedback.className = "feedback exercise-feedback";
        diagnostic.hidden = true;
        diagnosticList.replaceChildren();
      }, 0);
    });

    regenerate.addEventListener("click", () => {
      renderExercises();
      feedback.textContent = "別の問題を生成しました。";
    });

    renderExercises();
  }
</script>
