---
type Props = {
  kicker: string;
  title: string;
  description: string;
  variant?: "display" | "lesson";
  compact?: boolean;
};

const {
  kicker: _kicker,
  title: _title,
  description: _description,
  variant: _variant = "lesson",
  compact: _compact = false,
} = Astro.props;
---

<header class:list={["hero", `variant-${_variant}`, _compact && "is-compact"]}>
  <p class="kicker">{_kicker}</p>
  <h1>{_title}</h1>
  <p class="description">{_description}</p>
  <slot />
</header>

<style>
  .hero {
    max-width: 58rem;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .hero.is-compact {
    padding-bottom: clamp(2.6rem, 6vw, 4rem);
  }

  .kicker {
    margin: 0 0 0.8rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0 0 1.4rem;
    font-size: clamp(2.4rem, 7vw, 5.2rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .variant-display h1 {
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .description {
    max-width: 50rem;
    margin: 0;
    color: var(--color-muted-strong);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.9;
  }

  .variant-display .description {
    max-width: 44rem;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
</style>
