---
type Props = {
  kicker?: string;
  title: string;
  description: string;
  variant?: "display" | "lesson";
  compact?: boolean;
};

const {
  title: _title,
  description: _description,
  variant: _variant = "lesson",
  compact: _compact = false,
} = Astro.props;
---

<header class:list={["hero", `variant-${_variant}`, _compact && "is-compact"]}>
  <h1>{_title}</h1>
  <p class="description">{_description}</p>
  <slot />
</header>

<style>
  .hero {
    max-width: 58rem;
    padding-bottom: clamp(2.6rem, 6vw, 4.4rem);
  }

  .hero.is-compact {
    padding-bottom: clamp(2rem, 5vw, 3.2rem);
  }

  .variant-display {
    max-width: 50rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  h1 {
    max-width: 15em;
    margin: 0 0 1.2rem;
    color: var(--color-text-strong);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .variant-display h1 {
    max-width: 11em;
    margin-bottom: 1rem;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  .description {
    max-width: 46rem;
    margin: 0;
    color: var(--color-muted-strong);
    font-size: clamp(0.98rem, 1.8vw, 1.08rem);
    line-height: 2;
  }

  .variant-display .description {
    max-width: 37rem;
    font-size: clamp(0.94rem, 1.7vw, 1.02rem);
    line-height: 1.85;
  }

  @media (max-width: 760px) {
    h1 {
      font-size: clamp(2rem, 10vw, 3.1rem);
    }

    .variant-display h1 {
      font-size: clamp(2.2rem, 10vw, 3rem);
      line-height: 1.16;
    }

    .description {
      line-height: 1.85;
    }

    .variant-display {
      padding-bottom: 1.9rem;
    }
  }
</style>
