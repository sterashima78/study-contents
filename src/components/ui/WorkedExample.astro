---
import type { DiagramScene } from "../../lib/diagram/types";
import { hasFragileMathGlyphs, toPortableMathText } from "../../lib/math-display";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import DiagramView from "../diagram/DiagramView.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StaticMath from "./StaticMath.astro";

type WorkedStep = {
  expression?: string;
  note?: string;
  text?: string;
  diagram?: DiagramScene;
};

type Props = {
  label?: string;
  title?: string;
  introduction?: string;
  problem?: string;
  strategy?: string;
  steps: WorkedStep[];
  answer?: string;
  diagram?: DiagramScene;
};

const {
  title: _title,
  introduction: _introduction,
  problem: _problem,
  strategy: _strategy,
  steps: _steps,
  answer: _answer,
  diagram: _diagram,
} = Astro.props;
---

<article class="worked-example">
  {_title && <h3>{_title}</h3>}
  {_introduction && <p class="introduction">{toPortableMathText(_introduction)}</p>}
  {_problem && <p class="problem">{toPortableMathText(_problem)}</p>}
  {_strategy && <p class="strategy"><strong>方針:</strong> {toPortableMathText(_strategy)}</p>}
  {_diagram && <DiagramView scene={_diagram} />}
  <ol class="steps">
    {
      _steps.map((step) => (
        <li>
          {step.expression && (
            <div class="expression">
              {hasFragileMathGlyphs(step.expression) ? (
                <StaticMath value={step.expression} block />
              ) : (
                toPortableMathText(step.expression)
              )}
            </div>
          )}
          {step.text && <div class="text-step">{toPortableMathText(step.text)}</div>}
          {step.note && <p>{toPortableMathText(step.note)}</p>}
          {step.diagram && (
            <div class="step-diagram">
              <DiagramView scene={step.diagram} />
            </div>
          )}
        </li>
      ))
    }
  </ol>
  {_answer && <p class="answer">{toPortableMathText(_answer)}</p>}
</article>

<style>
  .worked-example {
    padding: clamp(1.25rem, 3vw, 1.9rem);
    border: 1px solid var(--color-border-soft);
    border-radius: 0.3rem;
    background: var(--surface);
  }

  h3 {
    margin: 0 0 0.75rem;
    color: var(--color-text-strong);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .introduction,
  .strategy {
    color: var(--color-muted-strong);
    line-height: 1.85;
  }

  .problem {
    margin: 1rem 0 1.1rem;
    padding: 0.95rem 1rem;
    border-left: 2px solid var(--color-accent-light);
    color: var(--color-text-strong);
    background: var(--surface-subtle);
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-size: clamp(1.12rem, 3vw, 1.5rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 700;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: worked-step;
  }

  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.65rem 0.9rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border-soft);
    counter-increment: worked-step;
  }

  .steps li::before {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-accent-strong);
    content: counter(worked-step);
    font-family: "Times New Roman", serif;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .steps li:first-child {
    border-top: 0;
  }

  .expression,
  .text-step {
    align-self: center;
    padding: 0.35rem 0;
    color: var(--color-text-strong);
    font-size: clamp(1.02rem, 2.6vw, 1.24rem);
    font-weight: 700;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .expression {
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .steps p {
    grid-column: 2;
    margin: 0;
    color: var(--color-muted-strong);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .step-diagram {
    grid-column: 2;
    min-width: 0;
  }

  .answer {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-accent-strong);
    background: var(--surface-accent);
    font-weight: 700;
    line-height: 1.8;
  }

  @media (max-width: 520px) {
    .worked-example {
      padding: 1.1rem;
    }

    .problem {
      font-size: 1.08rem;
      text-align: left;
    }
  }
</style>
