---
type WorkedStep = {
  expression?: string;
  note?: string;
  text?: string;
};

type Props = {
  label?: string;
  title?: string;
  introduction?: string;
  problem?: string;
  strategy?: string;
  steps: WorkedStep[];
  answer?: string;
};

const {
  label: _label,
  title: _title,
  introduction: _introduction,
  problem: _problem,
  strategy: _strategy,
  steps: _steps,
  answer: _answer,
} = Astro.props;
---

<article class="worked-example">
  {_label && <p class="label">{_label}</p>}
  {_title && <h3>{_title}</h3>}
  {_introduction && <p class="introduction">{_introduction}</p>}
  {_problem && <p class="problem">{_problem}</p>}
  {_strategy && <p class="strategy"><strong>方針:</strong> {_strategy}</p>}
  <ol class="steps">
    {
      _steps.map((step) => (
        <li>
          {step.expression && <div class="expression">{step.expression}</div>}
          {step.text && <div class="text-step">{step.text}</div>}
          {step.note && <p>{step.note}</p>}
        </li>
      ))
    }
  </ol>
  {_answer && <p class="answer">{_answer}</p>}
</article>

<style>
  .worked-example {
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border: 1px solid var(--color-border-soft);
    border-radius: 1.15rem;
    background: rgb(255 255 255 / 82%);
  }

  .label {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h3 {
    margin: 0 0 0.8rem;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .introduction,
  .strategy {
    color: var(--color-muted-strong);
    line-height: 1.8;
  }

  .problem {
    margin: 0 0 1.3rem;
    padding: 1.1rem;
    border-radius: 0.8rem;
    background: var(--surface-accent);
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-size: clamp(1.2rem, 3.5vw, 1.7rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 700;
    line-height: 1.7;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: worked-step;
  }

  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.7rem 1rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--color-border-soft);
    counter-increment: worked-step;
  }

  .steps li::before {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--color-accent-medium);
    content: counter(worked-step);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .steps li:first-child {
    border-top: 0;
  }

  .expression,
  .text-step {
    align-self: center;
    padding: 0.8rem 1rem;
    border-radius: 0.65rem;
    color: var(--color-accent-strong);
    background: var(--surface-accent);
    font-size: clamp(1.05rem, 2.8vw, 1.3rem);
    font-weight: 700;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .expression {
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .steps p {
    grid-column: 2;
    margin: 0;
    color: var(--color-muted-strong);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .answer {
    margin: 1rem 0 0;
    padding: 1rem;
    border-radius: 0.85rem;
    color: var(--color-accent-strong);
    background: var(--surface-accent);
    font-weight: 700;
    line-height: 1.8;
  }

  @media (max-width: 520px) {
    .steps li {
      grid-template-columns: 1.8rem minmax(0, 1fr);
      gap: 0.6rem 0.75rem;
    }

    .steps li::before {
      width: 1.8rem;
      height: 1.8rem;
    }
  }
</style>
