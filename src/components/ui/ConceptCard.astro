---
import type { ConceptTable } from "../../content/concept-table";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { hasFragileMathGlyphs, toPortableMathText } from "../../lib/math-display";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StaticMath from "./StaticMath.astro";

type Props = {
  title: string;
  body: string[];
  formulas?: string[];
  points?: string[];
  table?: ConceptTable;
};

const {
  title: _title,
  body: _body,
  formulas: _formulas,
  points: _points,
  table: _table,
} = Astro.props;
const _hasRowHeaders = _table?.rows.some((row) => row.header !== undefined) ?? false;
---

<article class="concept-card">
  <h3>{_title}</h3>
  {_body.map((paragraph) => <p>{toPortableMathText(paragraph)}</p>)}
  {
    _formulas && _formulas.length > 0 && (
      <div class="formulas">
        {_formulas.map((formula) =>
          hasFragileMathGlyphs(formula) ? (
            <div class="formula">
              <StaticMath value={formula} block />
            </div>
          ) : (
            <p class="formula-plain">{formula}</p>
          ),
        )}
      </div>
    )
  }
  {
    _table && _table.rows.length > 0 && (
      <div class="concept-table-shell">
        <table class="concept-table">
          {_table.caption && <caption>{toPortableMathText(_table.caption)}</caption>}
          {_table.headers && _table.headers.length > 0 && (
            <thead>
              <tr>
                {_hasRowHeaders && <th class="corner-cell" scope="col" aria-label="行見出し" />}
                {_table.headers.map((header) => (
                  <th scope="col">
                    {hasFragileMathGlyphs(header) ? (
                      <StaticMath value={header} />
                    ) : (
                      toPortableMathText(header)
                    )}
                  </th>
                ))}
              </tr>
            </thead>
          )}
          <tbody>
            {_table.rows.map((row) => (
              <tr>
                {_hasRowHeaders && (
                  <th scope="row" class:list={{ "empty-row-header": row.header === undefined }}>
                    {row.header === undefined ? (
                      <span class="visually-hidden">見出しなし</span>
                    ) : hasFragileMathGlyphs(row.header) ? (
                      <StaticMath value={row.header} />
                    ) : (
                      toPortableMathText(row.header)
                    )}
                  </th>
                )}
                {row.cells.map((cell) => (
                  <td>
                    {hasFragileMathGlyphs(cell) ? (
                      <StaticMath value={cell} />
                    ) : (
                      toPortableMathText(cell)
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {
    _points && _points.length > 0 && (
      <ol class="points">{_points.map((point) => <li>{toPortableMathText(point)}</li>)}</ol>
    )
  }
</article>

<style>
  .concept-card {
    min-width: 0;
    max-width: 100%;
    padding: clamp(1.25rem, 3vw, 1.8rem);
    border: 1px solid var(--color-border-soft);
    border-radius: 0.3rem;
    background: var(--surface);
  }

  h3 {
    margin: 0 0 0.75rem;
    color: var(--color-text-strong);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.55;
  }

  p {
    max-width: 58rem;
    margin: 0.55rem 0 0;
    color: var(--color-muted-strong);
    line-height: 1.9;
  }

  .formulas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    min-width: 0;
    max-width: 100%;
    gap: 0.45rem;
    margin-top: 1.15rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-border-soft);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .formulas p,
  .formula {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0.25rem 0.15rem;
    color: var(--color-text-strong);
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-size: clamp(1.04rem, 2.5vw, 1.28rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 700;
  }

  .formula {
    overflow: hidden;
  }

  .formula-plain {
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
  }

  .concept-table-shell {
    width: 100%;
    max-width: 100%;
    margin-top: 1.15rem;
    overflow-x: auto;
    border: 1px solid var(--color-border-soft);
    border-radius: 0.25rem;
  }

  .concept-table {
    width: 100%;
    min-width: max-content;
    border-collapse: collapse;
    color: var(--color-text-strong);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .concept-table caption {
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--color-border-soft);
    color: var(--color-muted-strong);
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.6;
    text-align: left;
  }

  .concept-table th,
  .concept-table td {
    padding: 0.72rem 0.9rem;
    border-right: 1px solid var(--color-border-soft);
    border-bottom: 1px solid var(--color-border-soft);
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
  }

  .concept-table th {
    font-weight: 700;
  }

  .concept-table th:last-child,
  .concept-table td:last-child {
    border-right: 0;
  }

  .concept-table tbody tr:last-child th,
  .concept-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .corner-cell,
  .empty-row-header {
    min-width: 2.5rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .points {
    display: grid;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding-left: 1.4rem;
    color: var(--color-text-soft);
    font-weight: 650;
    line-height: 1.75;
  }
</style>
