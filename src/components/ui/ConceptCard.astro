---
import { hasFragileMathGlyphs, toPortableMathText } from "../../lib/math-display";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StaticMath from "./StaticMath.astro";

type Props = {
  title: string;
  body: string[];
  formulas?: string[];
  points?: string[];
};

const { title: _title, body: _body, formulas: _formulas, points: _points } = Astro.props;
---

<article class="concept-card">
  <h3>{_title}</h3>
  {_body.map((paragraph) => <p>{toPortableMathText(paragraph)}</p>)}
  {
    _formulas && _formulas.length > 0 && (
      <div class="formulas">
        {_formulas.map((formula) =>
          hasFragileMathGlyphs(formula) ? (
            <div class="formula">
              <StaticMath value={formula} block />
            </div>
          ) : (
            <p>{formula}</p>
          ),
        )}
      </div>
    )
  }
  {
    _points && _points.length > 0 && (
      <ol class="points">{_points.map((point) => <li>{toPortableMathText(point)}</li>)}</ol>
    )
  }
</article>

<style>
  .concept-card {
    padding: clamp(1.25rem, 3vw, 1.8rem);
    border: 1px solid var(--color-border-soft);
    border-radius: 0.3rem;
    background: var(--surface);
  }

  h3 {
    margin: 0 0 0.75rem;
    color: var(--color-text-strong);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.55;
  }

  p {
    max-width: 58rem;
    margin: 0.55rem 0 0;
    color: var(--color-muted-strong);
    line-height: 1.9;
  }

  .formulas {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.15rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-border-soft);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .formulas p,
  .formula {
    margin: 0;
    padding: 0.25rem 0.15rem;
    color: var(--color-text-strong);
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-size: clamp(1.04rem, 2.5vw, 1.28rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 700;
  }

  .points {
    display: grid;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding-left: 1.4rem;
    color: var(--color-text-soft);
    font-weight: 650;
    line-height: 1.75;
  }
</style>
