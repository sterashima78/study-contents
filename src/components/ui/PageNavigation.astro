---
type NavLink = {
  label: string;
  href: string;
};

type Props = {
  previous?: NavLink;
  center?: NavLink;
  next?: NavLink;
};

const { previous: _previous, center: _center, next: _next } = Astro.props;
---

<nav class="navigation" aria-label="教材ナビゲーション">
  <div class="previous">{_previous && <a href={_previous.href}>{_previous.label}</a>}</div>
  <div class="center">{_center && <a href={_center.href}>{_center.label}</a>}</div>
  <div class="next">{_next && <a href={_next.href}>{_next.label}</a>}</div>
</nav>

<style>
  .navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  a {
    display: inline-flex;
    min-height: 2.6rem;
    padding: 0.55rem 0.75rem;
    align-items: center;
    color: var(--color-link);
    font-weight: 700;
    text-decoration: none;
  }

  .center a {
    color: var(--color-muted-strong);
    font-size: 0.75rem;
  }

  .next {
    text-align: right;
  }

  .next a {
    border: 1px solid var(--color-accent-medium);
    border-radius: 0.25rem;
    color: #fff;
    background: var(--color-accent-medium);
  }

  a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .previous a:hover,
    .center a:hover {
      color: var(--color-link-hover);
      background: var(--surface-subtle);
    }

    .next a:hover {
      border-color: var(--color-accent-strong);
      background: var(--color-accent-strong);
    }
  }

  @media (max-width: 760px) {
    .navigation {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.6rem;
      padding-top: 1rem;
    }

    .previous a,
    .next a {
      width: 100%;
      min-height: 3rem;
      justify-content: center;
      border: 1px solid var(--color-border-strong);
      border-radius: 0.25rem;
    }

    .previous a {
      color: var(--color-text-soft);
      background: var(--surface);
    }

    .next {
      text-align: left;
    }

    .next a {
      border-color: var(--color-accent-medium);
    }

    .center {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: center;
    }

    .center a {
      min-height: 2.2rem;
      justify-content: center;
    }
  }
</style>
