---
type NavLink = {
  label: string;
  href: string;
};

type Props = {
  previous?: NavLink;
  center?: NavLink;
  next?: NavLink;
};

const { previous: _previous, center: _center, next: _next } = Astro.props;
---

<nav class="navigation" aria-label="教材ナビゲーション">
  <div>{_previous && <a href={_previous.href}>{_previous.label}</a>}</div>
  <div class="center">{_center && <a href={_center.href}>{_center.label}</a>}</div>
  <div class="next">{_next && <a href={_next.href}>{_next.label}</a>}</div>
</nav>

<style>
  .navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  a {
    color: var(--color-link);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .center a {
    color: var(--color-muted-strong);
    font-size: 0.78rem;
  }

  .next {
    text-align: right;
  }

  a:focus-visible {
    border-radius: 0.2rem;
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  @media (max-width: 760px) {
    .navigation {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .next {
      text-align: left;
    }

    .center {
      order: 3;
    }
  }
</style>
