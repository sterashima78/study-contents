---
type Props = {
  items: string[];
  homeHref?: string;
};

const { items: _items, homeHref: _homeHref } = Astro.props;
---

<footer class="footer">
  {_items.map((item) => <p>{item}</p>)}
  {_homeHref && <p><a href={_homeHref}>科目一覧へ</a></p>}
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(2.8rem, 6vw, 4.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-muted);
    font-size: 0.74rem;
    line-height: 1.7;
  }

  p {
    margin: 0;
  }

  a {
    color: var(--color-link);
    font-weight: 700;
    text-underline-offset: 0.22em;
  }

  a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  @media (max-width: 720px) {
    .footer {
      flex-direction: column;
      gap: 0.45rem;
    }
  }
</style>
