---
type LinkItem = {
  label: string;
  href?: string;
};

type IndexItem = {
  marker?: string;
  kicker?: string;
  title: string;
  href: string;
  description?: string;
  meta?: string;
  links?: LinkItem[];
  tags?: string[];
  badge?: string;
  badgeTone?: "default" | "advanced";
  action?: string;
};

type Props = {
  items: IndexItem[];
  variant?: "grid" | "rows";
};

const { items: _items, variant: _variant = "rows" } = Astro.props;
---

<ol class:list={["index", `variant-${_variant}`]}>
  {
    _items.map((item) => (
      <li class="item">
        <div class="heading">
          {item.marker && <span class="marker" aria-hidden="true">{item.marker}</span>}
          <div class="title-group">
            {item.kicker && <p class="kicker">{item.kicker}</p>}
            <h3><a href={item.href}>{item.title}</a></h3>
          </div>
          {item.badge && <span class:list={["badge", item.badgeTone === "advanced" && "is-advanced"]}>{item.badge}</span>}
        </div>
        {item.description && <p class="description">{item.description}</p>}
        {item.links && item.links.length > 0 && (
          <ul class="links">
            {item.links.map((link) => <li>{link.href ? <a href={link.href}>{link.label}</a> : link.label}</li>)}
          </ul>
        )}
        {item.tags && item.tags.length > 0 && (
          <ul class="tags" aria-label={`${item.title}の項目`}>
            {item.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
        <div class="footer">
          {item.meta && <span class="meta">{item.meta}</span>}
          {item.action && <a class="action" href={item.href}>{item.action}</a>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .index {
    display: grid;
    gap: 0.65rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .variant-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 0;
  }

  .item {
    border: 1px solid var(--color-border-soft);
    border-radius: 0.35rem;
    background: var(--surface);
  }

  .variant-rows .item {
    padding: 1rem 1.1rem;
  }

  .variant-grid .item {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: clamp(1.25rem, 2.5vw, 1.7rem);
  }

  .heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: start;
  }

  .variant-grid .heading {
    padding-bottom: 0.95rem;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .marker {
    min-width: 2.3rem;
    padding-top: 0.08rem;
    color: var(--color-accent);
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .variant-grid .marker {
    min-width: 1.8rem;
    padding-top: 0.2rem;
    color: var(--color-accent-light);
  }

  .kicker {
    margin: 0 0 0.28rem;
    color: var(--color-muted);
    font-size: 0.67rem;
    font-weight: 750;
    letter-spacing: 0.13em;
  }

  h3 {
    margin: 0;
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .variant-grid h3 {
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    line-height: 1.4;
  }

  h3 a,
  .links a,
  .action {
    color: var(--color-link);
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.22em;
  }

  h3 a {
    color: var(--color-text-strong);
    text-decoration: none;
  }

  .description {
    margin: 1rem 0 0.9rem;
    color: var(--color-muted-strong);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .variant-rows .description {
    margin: 0.35rem 0 0 3.15rem;
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .links,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links {
    display: grid;
    gap: 0.5rem;
  }

  .links li {
    position: relative;
    padding-left: 0.9rem;
    color: var(--color-text-soft);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .links li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 0.26rem;
    height: 1px;
    background: var(--color-accent-light);
    content: "";
  }

  .tags li {
    padding: 0.28rem 0.5rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 0.3rem;
    color: var(--color-muted-strong);
    background: var(--surface-subtle);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .badge {
    padding: 0.24rem 0.48rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.25rem;
    color: var(--color-accent-strong);
    background: var(--surface-accent);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .badge.is-advanced {
    border-color: #d8cdbb;
    color: #6e5635;
    background: #f8f3e9;
  }

  .footer {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 1rem;
  }

  .variant-rows .footer {
    margin-left: 3.15rem;
    padding-top: 0.45rem;
  }

  .meta {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 650;
  }

  .action {
    font-size: 0.78rem;
    font-weight: 700;
  }

  a:focus-visible {
    border-radius: 0.1rem;
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .item {
      transition: border-color 140ms ease, background-color 140ms ease;
    }

    .item:hover {
      border-color: var(--color-border-strong);
      background: var(--surface-subtle);
    }

    h3 a:hover,
    .links a:hover,
    .action:hover {
      color: var(--color-link-hover);
    }
  }

  @media (max-width: 760px) {
    .variant-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .variant-rows .heading {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .variant-rows .badge {
      grid-column: 2;
      width: fit-content;
    }

    .variant-rows .description,
    .variant-rows .footer {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .item {
      transition: none;
    }
  }
</style>
