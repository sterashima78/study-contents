---
type CurriculumReferenceData = {
  courseTitle: string;
  subjectTitle: string;
  curriculumCourse: string;
  guidelineTitle: string;
  guidelineUrl: string;
  commentaryTitle: string;
  commentaryUrl: string;
  lastVerified: string;
  note?: string;
};

type Props = {
  reference: CurriculumReferenceData;
};

const { reference: _reference } = Astro.props as Props;
---

<aside
  class="curriculum-reference"
  data-curriculum-reference
  data-curriculum-course={_reference.curriculumCourse}
  aria-labelledby="curriculum-reference-title"
>
  <p class="reference-label">CURRICULUM REFERENCE</p>
  <h2 id="curriculum-reference-title">学習指導要領との対応</h2>
  <p class="reference-scope">
    対応の確認先: {_reference.guidelineTitle} {_reference.subjectTitle}「{_reference.curriculumCourse}」
  </p>
  {
    _reference.note && <p class="reference-note">{_reference.note}</p>
  }
  <p class="reference-note">
    教材ページ名は学習指導要領の見出しをそのまま転記したものではありません。公式資料との照合先として示しています。
  </p>
  <nav class="reference-links" aria-label={`${_reference.courseTitle}の学習指導要領公式資料`}>
    <a href={_reference.guidelineUrl} target="_blank" rel="noopener noreferrer">
      学習指導要領（文部科学省）
    </a>
    <a href={_reference.commentaryUrl} target="_blank" rel="noopener noreferrer">
      {_reference.commentaryTitle}
    </a>
  </nav>
  <p class="verified-date">参照先確認日: {_reference.lastVerified}</p>
</aside>

<style>
  .curriculum-reference {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding: 1.15rem 0 0;
    border-top: 1px solid var(--color-border-soft);
  }

  .reference-label {
    margin: 0 0 0.35rem;
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.16em;
  }

  h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 600;
  }

  .reference-scope,
  .reference-note,
  .verified-date {
    max-width: 60rem;
    color: var(--color-text-soft);
    line-height: 1.75;
  }

  .reference-scope {
    margin: 0.65rem 0 0;
    font-size: 0.88rem;
    font-weight: 650;
  }

  .reference-note {
    margin: 0.4rem 0 0;
    font-size: 0.84rem;
  }

  .reference-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: 0.8rem;
  }

  .reference-links a {
    color: var(--color-link);
    font-size: 0.84rem;
    font-weight: 700;
    text-underline-offset: 0.22em;
  }

  .reference-links a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .verified-date {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .reference-links a:hover {
      color: var(--color-link-hover);
    }
  }
</style>
