---
type Props = {
  labelledby?: string;
  compact?: boolean;
};

const { labelledby: _labelledby, compact: _compact = false } = Astro.props;
---

<section class:list={["section", _compact && "is-compact"]} aria-labelledby={_labelledby}>
  <slot />
</section>

<style>
  .section {
    padding: clamp(2.8rem, 6vw, 4.6rem) 0;
    border-top: 1px solid var(--color-border-soft);
    scroll-margin-top: 1rem;
  }

  .section.is-compact {
    padding-top: clamp(2.1rem, 4vw, 3rem);
    padding-bottom: clamp(2.3rem, 5vw, 3.4rem);
  }

  @media (max-width: 760px) {
    .section {
      padding: 2.4rem 0;
    }

    .section.is-compact {
      padding: 1.9rem 0 2.2rem;
    }
  }
</style>
