---
type Props = {
  labelledby?: string;
  compact?: boolean;
};

const { labelledby: _labelledby, compact: _compact = false } = Astro.props;
---

<section class:list={["section", _compact && "is-compact"]} aria-labelledby={_labelledby}>
  <slot />
</section>

<style>
  .section {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-top: 1px solid var(--color-border);
  }

  .section.is-compact {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }
</style>
