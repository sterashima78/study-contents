---
type Props = {
  label: string;
  title: string;
  description?: string;
  id?: string;
};

const { label: _label, title: _title, description: _description, id: _id } = Astro.props;
---

<div class="heading">
  <div>
    <p class="label">{_label}</p>
    <h2 id={_id}>{_title}</h2>
  </div>
  {_description && <p class="description">{_description}</p>}
</div>

<style>
  .heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
    gap: 2rem;
    align-items: start;
    margin-bottom: 2rem;
  }

  .label {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.8rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .description {
    margin: 0.2rem 0 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.8;
  }

  @media (max-width: 760px) {
    .heading {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
