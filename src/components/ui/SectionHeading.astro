---
type Props = {
  label?: string;
  title: string;
  description?: string;
  id?: string;
};

const { title: _title, description: _description, id: _id } = Astro.props;
---

<div class="heading">
  <div>
    <h2 id={_id}>{_title}</h2>
  </div>
  {_description && <p class="description">{_description}</p>}
</div>

<style>
  .heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 25rem);
    gap: clamp(1.2rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: 1.8rem;
  }

  h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: clamp(1.55rem, 3.4vw, 2.35rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .description {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.85;
  }

  @media (max-width: 760px) {
    .heading {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-bottom: 1.4rem;
    }
  }
</style>
