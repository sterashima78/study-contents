---
import { getCurriculumReference } from "../../content/curriculum-references.js";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import CurriculumReference from "./CurriculumReference.astro";

type Props = {
  title: string;
  description: string;
  width?: "standard" | "wide";
};

const { title: _title, description: _description, width: _width = "standard" } = Astro.props;
const _baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const _relativePath = Astro.url.pathname.startsWith(_baseUrl)
  ? Astro.url.pathname.slice(_baseUrl.length)
  : Astro.url.pathname.replace(/^\/+/, "");
const _courseKey = _relativePath.split("/").find(Boolean);
const _curriculumReference = getCurriculumReference(_courseKey);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={_description} />
    <title>{_title}</title>
  </head>
  <body>
    <main class:list={["study-page", _width === "wide" && "is-wide"]}>
      <slot />
      {_curriculumReference && <CurriculumReference reference={_curriculumReference} />}
    </main>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background:
      radial-gradient(circle at top right, rgb(200 222 204 / 45%), transparent 32rem), #f4f6f2;
  }

  .study-page {
    width: min(100%, 76rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.1rem, 4vw, 3rem) 3rem;
    color: #172033;
    font-family:
      Inter, "Hiragino Sans", "Yu Gothic", ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;

    --color-text: #172033;
    --color-text-strong: #26382c;
    --color-text-soft: #34443a;
    --color-muted: #66746b;
    --color-muted-strong: #526158;
    --color-accent: #3f7050;
    --color-accent-light: #688474;
    --color-accent-medium: #4b7559;
    --color-accent-strong: #285f3a;
    --color-link: #245c37;
    --color-link-hover: #183f26;
    --color-border: #cfd7d0;
    --color-border-strong: #ccd8ce;
    --color-border-soft: #d5ddd6;
    --surface: #ffffff;
    --surface-subtle: #f7f9f6;
    --surface-accent: #f1f5f1;
    --focus-ring: rgb(63 112 80 / 28%);
  }

  .study-page,
  .study-page :global(*) {
    box-sizing: border-box;
  }

  .study-page :global(button),
  .study-page :global(input),
  .study-page :global(textarea),
  .study-page :global(select) {
    font: inherit;
  }

  .study-page.is-wide {
    width: min(100%, 78rem);
    padding-top: clamp(2rem, 5vw, 5rem);
  }

  @media (max-width: 760px) {
    .study-page {
      padding-top: 1rem;
    }

    .study-page.is-wide {
      padding-top: 2rem;
    }
  }
</style>
