---
import { getCurriculumReference } from "../../content/curriculum-references.js";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyAIChat from "../ai/StudyAIChat.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import CurriculumReference from "./CurriculumReference.astro";

type Props = {
  title: string;
  description: string;
  width?: "standard" | "wide";
  curriculumKey?: string;
};

const {
  title: _title,
  description: _description,
  width: _width = "standard",
  curriculumKey: _explicitCurriculumKey,
} = Astro.props;
const _baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const _relativePath = Astro.url.pathname.startsWith(_baseUrl)
  ? Astro.url.pathname.slice(_baseUrl.length)
  : Astro.url.pathname.replace(/^\/+/, "");
const _courseKey = _relativePath.split("/").find(Boolean);
const _curriculumReference = getCurriculumReference(_explicitCurriculumKey ?? _courseKey);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={_description} />
    <title>{_title}</title>
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#page-top">本文へ移動</a>
      <header class="site-header">
        <div class="site-header-inner">
          <a class="brand" href={_baseUrl}>学習コンテンツ</a>
          <nav class="site-nav" aria-label="共通ナビゲーション">
            <a href={_baseUrl}>科目を選ぶ</a>
            <a href={`${_baseUrl}practice/`}>演習</a>
            <a href={`${_baseUrl}progress/`}>学習記録</a>
            <a href="#page-top">ページ先頭</a>
          </nav>
        </div>
      </header>
      <main id="page-top" class:list={["study-page", _width === "wide" && "is-wide"]}>
        <slot />
        {_curriculumReference && <CurriculumReference reference={_curriculumReference} />}
      </main>
      <StudyAIChat />
    </div>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: #f8f7f3;
  }

  .site-shell {
    min-height: 100vh;
    color: #282622;
    font-family:
      "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans CJK JP", ui-sans-serif,
      system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;

    --color-text: #282622;
    --color-text-strong: #1f1d1a;
    --color-text-soft: #514d46;
    --color-muted: #777168;
    --color-muted-strong: #5e5952;
    --color-accent: #7a6749;
    --color-accent-light: #806d4f;
    --color-accent-medium: #756246;
    --color-accent-strong: #655438;
    --color-link: #5f4e34;
    --color-link-hover: #40331f;
    --color-border: #d9d4cb;
    --color-border-strong: #cec7bc;
    --color-border-soft: #e8e4dc;
    --surface: #fff;
    --surface-subtle: #fbfaf7;
    --surface-accent: #f3f0e9;
    --focus-ring: rgb(122 103 73 / 30%);
  }

  .site-shell,
  .site-shell :global(*) {
    box-sizing: border-box;
  }

  .site-shell :global(button),
  .site-shell :global(input),
  .site-shell :global(textarea),
  .site-shell :global(select) {
    font: inherit;
  }

  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 20;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-strong);
    background: var(--surface);
    font-size: 0.82rem;
    font-weight: 700;
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    border-bottom: 1px solid var(--color-border-soft);
    background: rgb(255 255 255 / 94%);
  }

  .site-header-inner {
    display: flex;
    width: min(100%, 86rem);
    min-height: 3.6rem;
    margin: 0 auto;
    padding: 0 clamp(1.1rem, 4vw, 3rem);
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .brand,
  .site-nav a {
    color: var(--color-text-strong);
    text-decoration: none;
  }

  .brand {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .site-nav {
    display: flex;
    gap: 1.4rem;
    align-items: center;
    font-size: 0.78rem;
  }

  .site-nav a {
    color: var(--color-muted-strong);
    font-weight: 650;
  }

  .brand:focus-visible,
  .site-nav a:focus-visible,
  .skip-link:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  .study-page {
    width: min(100%, 72rem);
    margin: 0 auto;
    padding: clamp(2.4rem, 6vw, 4.8rem) clamp(1.1rem, 4vw, 3rem) 3.5rem;
    color: var(--color-text);
    line-height: 1.75;
  }

  .study-page.is-wide {
    width: min(100%, 82rem);
    padding-top: clamp(2.6rem, 5vw, 4.8rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover,
    .site-nav a:hover {
      color: var(--color-link);
    }
  }

  @media (max-width: 760px) {
    .site-header-inner {
      min-height: 3.25rem;
      gap: 1rem;
    }

    .brand {
      font-size: 0.86rem;
    }

    .site-nav {
      gap: 0.8rem;
      font-size: 0.72rem;
    }

    .site-nav a:last-child {
      display: none;
    }

    .study-page,
    .study-page.is-wide {
      padding-top: 1.65rem;
      padding-bottom: 2.5rem;
    }
  }

  @media (max-width: 520px) {
    .site-nav a:first-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
