---
type GuidedInputKind = "text" | "math" | "radio" | "select" | "checkbox";

type GuidedOption = {
  value: string;
  label: string;
};

type GuidedStep = {
  prompt: string;
  answers: string[];
  placeholder?: string;
  input?: GuidedInputKind;
  options?: GuidedOption[];
};

type Props = {
  title: string;
  problem?: string;
  statement?: string[];
  question?: string;
  steps: GuidedStep[];
  hint: string;
  position?: string;
  defaultInput?: GuidedInputKind;
  successMessage?: string;
  errorMessage?: string;
};

const {
  title: _title,
  problem: _problem,
  statement: _statement,
  question: _question,
  steps: _steps,
  hint: _hint,
  position: _position,
  defaultInput: _defaultInput = "text",
  successMessage: _successMessage = "すべて正解です。解答手順を自分で再現できています。",
  errorMessage: _errorMessage = "合っていない段階を例題と比べて確認してください。",
} = Astro.props;
---

<article
  class="guided-practice"
  data-guided-practice
  data-success-message={_successMessage}
  data-error-message={_errorMessage}
>
  <div class="header">
    <h3>{_title}</h3>
    {_position && <p class="position">{_position}</p>}
  </div>

  {_problem && <p class="problem">{_problem}</p>}
  {_statement && <div class="statement">{_statement.map((paragraph) => <p>{paragraph}</p>)}</div>}
  {_question && <p class="question">{_question}</p>}

  <form class="form">
    <ol class="fields">
      {
        _steps.map((step, index) => {
          const input = step.input ?? _defaultInput;
          const promptId = `guided-practice-prompt-${index}-${step.prompt.length}`;
          const groupName = `guided-practice-choice-${index}-${step.prompt.length}`;
          return (
            <li data-guided-step data-input={input} data-answers={JSON.stringify(step.answers)}>
              <p class="step-prompt" id={promptId}>{step.prompt}</p>
              <div class="answer-area">
                {
                  input === "math" ? (
                    <>
                      <div
                        class="math-field-host"
                        data-guided-math-field
                        data-prompt-id={promptId}
                        data-aria-label={`練習問題 ${index + 1}: ${step.prompt}`}
                      />
                      {step.placeholder && <p class="input-example">入力例: {step.placeholder}</p>}
                    </>
                  ) : input === "select" ? (
                    <select
                      class="answer-control guided-select"
                      data-answer-control
                      aria-labelledby={promptId}
                      required
                    >
                      <option value="">選択してください</option>
                      {step.options?.map((option) => <option value={option.value}>{option.label}</option>)}
                    </select>
                  ) : input === "radio" || input === "checkbox" ? (
                    <fieldset class="choice-fieldset answer-control" data-answer-control>
                      <legend class="visually-hidden">{step.prompt}</legend>
                      <div class="choice-options">
                        {step.options?.map((option, optionIndex) => (
                          <label class="choice-option">
                            <input
                              type={input === "radio" ? "radio" : "checkbox"}
                              name={input === "radio" ? groupName : `${groupName}-${optionIndex}`}
                              value={option.value}
                              required={input === "radio"}
                            />
                            <span>{option.label}</span>
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  ) : (
                    <input
                      type="text"
                      class="answer-control guided-text-input"
                      data-answer-control
                      autocomplete="off"
                      spellcheck="false"
                      placeholder={step.placeholder ?? "答えを入力"}
                      aria-labelledby={promptId}
                      required
                    />
                  )
                }
              </div>
            </li>
          );
        })
      }
    </ol>
    <div class="actions">
      <button type="submit" class="primary">答え合わせ</button>
      <button type="button" class="secondary hint-button">ヒント</button>
      <button type="reset" class="secondary">やり直す</button>
    </div>
  </form>
  <p class="hint" hidden>{_hint}</p>
  <p class="feedback" aria-live="polite"></p>
</article>

<script>
  import { MathfieldElement } from "mathlive";
  import "mathlive/fonts.css";

  MathfieldElement.soundsDirectory = null;

  const normalizeGuidedAnswer = (value: string) => {
    let normalized = value
      .trim()
      .toLowerCase()
      .replaceAll(/\s+/g, "")
      .replaceAll("\\left", "")
      .replaceAll("\\right", "")
      .replaceAll(/\\[,;:!]/g, "")
      .replaceAll("\\ ", "")
      .replaceAll("\\cdot", "*")
      .replaceAll("\\times", "*")
      .replaceAll("\\pm", "±")
      .replaceAll("\\leqslant", "≤")
      .replaceAll("\\leq", "≤")
      .replaceAll("\\le", "≤")
      .replaceAll("\\geqslant", "≥")
      .replaceAll("\\geq", "≥")
      .replaceAll("\\ge", "≥")
      .replaceAll("\\Rightarrow", "⇒")
      .replaceAll("\\implies", "⇒")
      .replaceAll("\\lbrace", "{")
      .replaceAll("\\rbrace", "}")
      .replaceAll("\\{", "{")
      .replaceAll("\\}", "}")
      .replaceAll("−", "-")
      .replaceAll("–", "-")
      .replaceAll("—", "-")
      .replaceAll("×", "*")
      .replaceAll("·", "*")
      .replaceAll("，", ",")
      .replaceAll("（", "(")
      .replaceAll("）", ")")
      .replaceAll("｛", "{")
      .replaceAll("｝", "}")
      .replaceAll("オーム", "ω")
      .replaceAll("ohm", "ω")
      .replaceAll("°c", "℃");

    let previous = "";
    while (previous !== normalized) {
      previous = normalized;
      normalized = normalized.replace(/\\sqrt\{([^{}]+)\}/g, "√$1");
    }
    previous = "";
    while (previous !== normalized) {
      previous = normalized;
      normalized = normalized.replace(/\\frac\{([^{}]+)\}\{([^{}]+)\}/g, "$1/$2");
    }
    normalized = normalized.replaceAll("^{2}", "²").replaceAll("^2", "²");
    return normalized.startsWith("=") ? normalized.slice(1) : normalized;
  };

  const readStepAnswer = (step: HTMLElement, input: string) => {
    if (input === "math") {
      const field = step.querySelector("math-field");
      return field instanceof MathfieldElement ? field.value : "";
    }
    if (input === "select") {
      const select = step.querySelector("select[data-answer-control]");
      return select instanceof HTMLSelectElement ? select.value : "";
    }
    if (input === "radio") {
      const checked = step.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      return checked?.value ?? "";
    }
    if (input === "checkbox") {
      return [...step.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')].map((item) => item.value);
    }
    const text = step.querySelector("input[data-answer-control]");
    return text instanceof HTMLInputElement ? text.value : "";
  };

  const markStep = (step: HTMLElement, isCorrect: boolean) => {
    step.classList.toggle("is-correct", isCorrect);
    step.classList.toggle("is-error", !isCorrect);
    const control = step.querySelector<HTMLElement>("[data-answer-control], math-field");
    if (!control) return;
    control.classList.toggle("is-correct", isCorrect);
    control.classList.toggle("is-error", !isCorrect);
    if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof MathfieldElement) {
      control.setAttribute("aria-invalid", String(!isCorrect));
    }
  };

  for (const card of document.querySelectorAll("[data-guided-practice]")) {
    if (!(card instanceof HTMLElement) || card.dataset.guidedReady === "true") continue;
    card.dataset.guidedReady = "true";
    const form = card.querySelector("form");
    const feedback = card.querySelector(".feedback");
    const hint = card.querySelector(".hint");
    const hintButton = card.querySelector(".hint-button");
    if (
      !(form instanceof HTMLFormElement) ||
      !(feedback instanceof HTMLElement) ||
      !(hint instanceof HTMLElement) ||
      !(hintButton instanceof HTMLButtonElement)
    ) continue;

    for (const host of card.querySelectorAll("[data-guided-math-field]")) {
      if (!(host instanceof HTMLElement)) continue;
      const field = new MathfieldElement();
      field.className = "answer-control guided-math-input";
      field.dataset.answerControl = "math";
      field.placeholder = "\\text{答えを入力}";
      field.mathVirtualKeyboardPolicy = "auto";
      const promptId = host.dataset.promptId;
      if (promptId) field.setAttribute("aria-labelledby", promptId);
      const ariaLabel = host.dataset.ariaLabel;
      if (ariaLabel) field.setAttribute("aria-label", ariaLabel);
      host.replaceWith(field);
    }

    hintButton.addEventListener("click", () => {
      hint.hidden = !hint.hidden;
      hintButton.textContent = hint.hidden ? "ヒント" : "ヒントを閉じる";
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const steps = [...form.querySelectorAll("[data-guided-step]")].filter(
        (step): step is HTMLElement => step instanceof HTMLElement,
      );
      let correctCount = 0;

      for (const step of steps) {
        const rawAnswers = step.dataset.answers;
        const input = step.dataset.input ?? "text";
        if (!rawAnswers) continue;
        const answers = (JSON.parse(rawAnswers) as string[]).map(normalizeGuidedAnswer);
        const value = readStepAnswer(step, input);
        const isCorrect = Array.isArray(value)
          ? value.map(normalizeGuidedAnswer).sort().join("\u0000") === answers.slice().sort().join("\u0000")
          : answers.includes(normalizeGuidedAnswer(value));
        markStep(step, isCorrect);
        if (isCorrect) correctCount += 1;
      }

      if (correctCount === steps.length) {
        feedback.textContent = card.dataset.successMessage ?? "すべて正解です。";
        feedback.className = "feedback is-correct";
      } else {
        const detail = `全 ${steps.length} 段階のうち ${correctCount} 段階が合っています。`;
        feedback.textContent = `${detail}${card.dataset.errorMessage ?? ""}`;
        feedback.className = "feedback is-error";
      }
    });

    form.addEventListener("reset", () => {
      window.setTimeout(() => {
        for (const field of form.querySelectorAll("math-field")) {
          if (field instanceof MathfieldElement) field.value = "";
        }
        for (const step of form.querySelectorAll("[data-guided-step]")) step.classList.remove("is-correct", "is-error");
        for (const control of form.querySelectorAll<HTMLElement>("[data-answer-control], math-field")) {
          control.classList.remove("is-correct", "is-error");
          control.removeAttribute("aria-invalid");
        }
        feedback.textContent = "";
        feedback.className = "feedback";
        hint.hidden = true;
        hintButton.textContent = "ヒント";
      }, 0);
    });
  }
</script>

<style>
  .guided-practice {
    margin-top: 1rem;
    padding: clamp(1.25rem, 3vw, 1.9rem);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.3rem;
    background: var(--surface);
  }

  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: start;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  h3 {
    margin: 0;
    color: var(--color-text-strong);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", ui-serif, serif;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .position {
    margin: 0;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 0.25rem;
    color: var(--color-muted-strong);
    background: var(--surface-subtle);
    font-size: 0.7rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .problem,
  .question {
    margin: 0 0 1.2rem;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--color-accent-light);
    color: var(--color-text-strong);
    background: var(--surface-subtle);
    font-family: "Times New Roman", "Yu Mincho", serif;
    font-size: clamp(1.1rem, 3vw, 1.48rem);
    font-weight: 700;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .statement {
    color: var(--color-text-soft);
    line-height: 1.9;
  }

  .statement p {
    margin: 0.5rem 0;
  }

  .form {
    display: grid;
    gap: 1rem;
  }

  .fields {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: practice-step;
  }

  .fields li {
    display: grid;
    grid-template-columns: minmax(14rem, 0.9fr) minmax(12rem, 1.1fr);
    gap: 0.75rem 1rem;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-border-soft);
    counter-increment: practice-step;
  }

  .step-prompt {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .step-prompt::before {
    margin-right: 0.45rem;
    color: var(--color-accent);
    content: counter(practice-step) ".";
    font-family: "Times New Roman", serif;
    font-weight: 700;
  }

  .answer-area {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .answer-control {
    width: 100%;
    min-height: 2.9rem;
    box-sizing: border-box;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.25rem;
    color: var(--color-text-strong);
    background: #fff;
  }

  .guided-text-input,
  .guided-select {
    padding: 0.6rem 0.75rem;
    font-family: "Times New Roman", "Yu Mincho", serif;
  }

  .guided-math-input {
    display: block;
    padding: 0.55rem 0.7rem;
    font-size: 1rem;
  }

  .guided-math-input:focus-within,
  .guided-text-input:focus,
  .guided-select:focus {
    border-color: var(--color-accent);
    outline: 3px solid var(--focus-ring);
    outline-offset: 1px;
  }

  .input-example {
    margin: 0;
    color: var(--color-muted-strong);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .choice-fieldset {
    min-width: 0;
    margin: 0;
    padding: 0.55rem 0.65rem;
  }

  .choice-options {
    display: grid;
    gap: 0.45rem;
  }

  .choice-option {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    color: var(--color-text-soft);
    font-size: 0.84rem;
    line-height: 1.5;
    cursor: pointer;
  }

  .choice-option input {
    width: 1rem;
    height: 1rem;
    margin: 0.15rem 0 0;
    accent-color: var(--color-accent-medium);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .answer-control.is-correct {
    border-color: #56745c;
    background: #f3f7f3;
  }

  .answer-control.is-error {
    border-color: #9a6259;
    background: #fff7f5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.2rem;
  }

  button {
    min-height: 2.85rem;
    padding: 0.65rem 0.95rem;
    border-radius: 0.25rem;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }

  .primary {
    border: 1px solid var(--color-accent-medium);
    color: #fff;
    background: var(--color-accent-medium);
  }

  .secondary {
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-soft);
    background: var(--surface);
  }

  button:focus-visible,
  .choice-option input:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 0.2rem;
  }

  .hint,
  .feedback {
    margin: 1rem 0 0;
    padding: 0.8rem 0.9rem;
    border-left: 2px solid var(--color-border-strong);
    font-size: 0.84rem;
    line-height: 1.75;
  }

  .hint {
    color: #655c3f;
    background: #f8f4e8;
  }

  .feedback:empty {
    display: none;
  }

  .feedback.is-correct {
    color: #35523b;
    background: #eff5f0;
  }

  .feedback.is-error {
    color: #6f4039;
    background: #f9efed;
  }

  @media (hover: hover) and (pointer: fine) {
    .primary:hover {
      border-color: var(--color-accent-strong);
      background: var(--color-accent-strong);
    }

    .secondary:hover {
      background: var(--surface-accent);
    }
  }

  @media (max-width: 760px) {
    .fields li {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .guided-practice {
      padding: 1.05rem;
    }

    .actions > button {
      flex: 1 1 calc(50% - 0.55rem);
    }

    .actions > .primary {
      flex-basis: 100%;
    }
  }
</style>
