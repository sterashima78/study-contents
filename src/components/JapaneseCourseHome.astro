---
import type { JapaneseArea } from "../content/japanese/types";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "./ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageFooter from "./ui/PageFooter.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";

type Props = {
  areas: JapaneseArea[];
};

const { areas: _areas } = Astro.props as Props;
const _base = import.meta.env.BASE_URL;
const _items = _areas.map((area, index) => {
  const lessonCount = area.units.reduce((sum, unit) => sum + unit.lessons.length, 0);
  return {
    marker: String(index + 1).padStart(2, "0"),
    kicker: area.kicker,
    title: area.title,
    href: `${_base}japanese/${area.key}/`,
    description: area.description,
    links: area.units.map((unit) => ({
      label: unit.title,
      href: `${_base}japanese/${area.key}/${unit.key}/`,
    })),
    meta: `${lessonCount}小教材公開`,
  };
});
const _totalLessonCount = _areas.reduce(
  (sum, area) => sum + area.units.reduce((unitSum, unit) => unitSum + unit.lessons.length, 0),
  0,
);
---

<StudyPage
  title="国語 | 学習コンテンツ"
  description="現代文・古文・漢文を、読み方のルールと根拠を確認しながら1ページ1技能で学ぶ高校国語教材です。"
  width="wide"
>
  <ContentHero
    kicker="JAPANESE"
    title="国語"
    description="現代文・古文・漢文を、文章のどこを根拠に読むか、どの文法・句法を使うかが分かる小さな教材に分けて学びます。"
    variant="display"
  />

  <ContentSection labelledby="japanese-areas-title">
    <SectionHeading
      label="CONTENTS"
      title="現代文・古文・漢文"
      id="japanese-areas-title"
      description={`全${_totalLessonCount}小教材。知識だけでなく、本文中の根拠や判断の手順を確認できる構成です。`}
    />
    <ContentIndex items={_items} variant="grid" />
  </ContentSection>

  <PageFooter
    items={["高校 国語", "現代文・古文・漢文を1ページ1技能で学ぶ実験的教材"]}
    homeHref={_base}
  />
</StudyPage>
