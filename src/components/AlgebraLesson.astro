---
import type { AlgebraUnit, Lesson } from "../content/math1/algebra";
import { getLessonNeighbors } from "../content/math1/algebra";
import "../styles/global.css";
import "../styles/lesson.css";

type Props = {
  unit: AlgebraUnit;
  lesson: Lesson;
};

const { unit, lesson } = Astro.props;
const base = import.meta.env.BASE_URL;
const lessonIndex = unit.lessons.findIndex((item) => item.key === lesson.key);
const neighbors = getLessonNeighbors(unit.key, lesson.key);
const unitHref = `${base}math1/algebra/${unit.key}/`;
const lessonHref = (targetUnit: string, targetLesson: string) =>
  `${base}math1/algebra/${targetUnit}/${targetLesson}/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`高校数学I「${lesson.title}」の教材。細かい途中式、例題直後の練習問題、まとめで学習します。`} />
    <title>{lesson.title} | {unit.title} | 数学I</title>
  </head>
  <body>
    <main class="lesson-shell">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href={base}>数学I</a>
        <span aria-hidden="true">/</span>
        <a href={unitHref}>{unit.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{lesson.title}</span>
      </nav>

      <header class="lesson-hero compact-hero">
        <p class="lesson-kicker">数と式 · {String(lessonIndex + 1).padStart(2, "0")}</p>
        <h1>{lesson.title}</h1>
        <p>{lesson.description}</p>
      </header>

      <section class="lesson-section goal-section" aria-labelledby="goal-title">
        <p class="section-label">GOAL</p>
        <h2 id="goal-title">このページでできるようになること</h2>
        <ul class="goal-list">
          {lesson.goals.map((goal) => <li>{goal}</li>)}
        </ul>
      </section>

      <section class="lesson-section" aria-labelledby="rule-title">
        <div class="section-heading lesson-heading">
          <div>
            <p class="section-label">RULE</p>
            <h2 id="rule-title">考え方・ルール</h2>
          </div>
          <p>このページで使う考え方だけに絞って確認します。</p>
        </div>

        <div class="concept-grid single-column-grid">
          {
            lesson.concepts.map((concept) => (
              <article class="concept-card">
                <h3>{concept.title}</h3>
                {concept.body.map((paragraph) => <p>{paragraph}</p>)}
                {concept.formulas && (
                  <div class="formula-stack">
                    {concept.formulas.map((formula) => <p class="formula">{formula}</p>)}
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="lesson-section example-practice-section" aria-labelledby="example-title">
        <p class="section-label">EXAMPLE</p>
        <h2 id="example-title">{lesson.example.title}</h2>

        <article class="worked-example detailed-example">
          <p class="question-expression example-question">{lesson.example.problem}</p>
          <ol class="worked-steps">
            {
              lesson.example.steps.map((step) => (
                <li>
                  <div class="calculation answer-line">{step.expression}</div>
                  <p>{step.note}</p>
                </li>
              ))
            }
          </ol>
        </article>

        <article class="practice-card immediate-practice" data-guided-practice>
          <div class="practice-card-header">
            <div>
              <p class="practice-label">PRACTICE</p>
              <h3>{lesson.practice.title}</h3>
            </div>
            <p class="practice-position">例題の直後に確認</p>
          </div>

          <p class="question-expression">{lesson.practice.problem}</p>
          <form class="guided-practice-form">
            <ol class="guided-fields">
              {
                lesson.practice.steps.map((step, index) => (
                  <li>
                    <label>
                      <span>{step.prompt}</span>
                      <input
                        type="text"
                        autocomplete="off"
                        spellcheck="false"
                        placeholder={step.placeholder ?? "答えを入力"}
                        data-answers={JSON.stringify(step.answers)}
                        aria-label={`練習問題 ${index + 1}: ${step.prompt}`}
                        required
                      />
                    </label>
                  </li>
                ))
              }
            </ol>
            <div class="practice-actions">
              <button type="submit" class="primary-button">答え合わせ</button>
              <button type="button" class="secondary-button hint-button">ヒント</button>
              <button type="reset" class="secondary-button">やり直す</button>
            </div>
          </form>
          <p class="hint practice-hint" hidden>{lesson.practice.hint}</p>
          <p class="feedback practice-feedback" aria-live="polite"></p>
        </article>
      </section>

      <section class="lesson-section summary-section" aria-labelledby="summary-title">
        <p class="section-label">SUMMARY</p>
        <h2 id="summary-title">このページのポイント</h2>
        <ul class="summary-list">
          {lesson.summary.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <nav class="lesson-navigation" aria-label="教材ナビゲーション">
        <div>
          {neighbors.previous ? (
            <a href={lessonHref(neighbors.previous.unit.key, neighbors.previous.lesson.key)}>
              ← {neighbors.previous.lesson.title}
            </a>
          ) : (
            <a href={unitHref}>← {unit.title}の目次</a>
          )}
        </div>
        <a class="unit-index-link" href={unitHref}>{unit.title}の小単元一覧</a>
        <div>
          {neighbors.next ? (
            <a href={lessonHref(neighbors.next.unit.key, neighbors.next.lesson.key)}>
              {neighbors.next.lesson.title} →
            </a>
          ) : (
            <a href={base}>数学Iの目次へ →</a>
          )}
        </div>
      </nav>
    </main>

    <script>
      const normalizeAnswer = (value) =>
        value
          .trim()
          .toLowerCase()
          .replaceAll(/\s+/g, "")
          .replaceAll("−", "-")
          .replaceAll("–", "-")
          .replaceAll("—", "-")
          .replaceAll("×", "*")
          .replaceAll("·", "*")
          .replaceAll("，", ",")
          .replaceAll("（", "(")
          .replaceAll("）", ")")
          .replaceAll("｛", "{")
          .replaceAll("｝", "}")
          .replaceAll("^2", "²");

      for (const card of document.querySelectorAll("[data-guided-practice]")) {
        if (!(card instanceof HTMLElement)) continue;

        const form = card.querySelector(".guided-practice-form");
        const feedback = card.querySelector(".practice-feedback");
        const hint = card.querySelector(".practice-hint");
        const hintButton = card.querySelector(".hint-button");

        if (
          !(form instanceof HTMLFormElement) ||
          !(feedback instanceof HTMLElement) ||
          !(hint instanceof HTMLElement) ||
          !(hintButton instanceof HTMLButtonElement)
        ) {
          continue;
        }

        hintButton.addEventListener("click", () => {
          hint.hidden = !hint.hidden;
          hintButton.textContent = hint.hidden ? "ヒント" : "ヒントを閉じる";
        });

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const inputs = [...form.querySelectorAll("input[data-answers]")].filter(
            (input) => input instanceof HTMLInputElement,
          );
          let correctCount = 0;

          for (const input of inputs) {
            if (!(input instanceof HTMLInputElement)) continue;
            const rawAnswers = input.dataset.answers;
            if (!rawAnswers) continue;

            const answers = JSON.parse(rawAnswers).map(normalizeAnswer);
            const isCorrect = answers.includes(normalizeAnswer(input.value));
            input.classList.toggle("is-correct", isCorrect);
            input.classList.toggle("is-error", !isCorrect);
            if (isCorrect) correctCount += 1;
          }

          if (correctCount === inputs.length) {
            feedback.textContent = "すべて正解です。例題と同じ手順を自分で再現できています。";
            feedback.className = "feedback practice-feedback is-correct";
          } else {
            feedback.textContent = `全 ${inputs.length} 段階のうち ${correctCount} 段階が合っています。赤く表示された段階を例題と比べて確認してください。`;
            feedback.className = "feedback practice-feedback is-error";
          }
        });

        form.addEventListener("reset", () => {
          window.setTimeout(() => {
            for (const input of form.querySelectorAll("input")) {
              input.classList.remove("is-correct", "is-error");
            }
            feedback.textContent = "";
            feedback.className = "feedback practice-feedback";
            hint.hidden = true;
            hintButton.textContent = "ヒント";
          }, 0);
        });
      }
    </script>
  </body>
</html>
