---
import { type MathCourseInfo, math1Course } from "../content/math-courses";
import type { MathArea, MathUnit } from "../content/math1/types";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ExerciseSet from "./ExerciseSet.astro";
import "../styles/global.css";
import "../styles/lesson.css";

type Props = {
  area: MathArea;
  unit: MathUnit;
  course?: MathCourseInfo;
};

const { area: _area, unit: _unit, course: _course = math1Course } = Astro.props;
const _base = import.meta.env.BASE_URL;
const _courseHomeHref = `${_base}${_course.homePath}`;
const _areaHref = `${_base}${_course.routeBase}/${_area.key}/`;
const _unitHref = `${_areaHref}${_unit.key}/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`高校${_course.title}「${_unit.title}」の単元末演習。基礎・応用・難問を自動採点し、小単元ごとの弱点を確認します。`}
    />
    <title>単元末演習 | {_unit.title} | {_course.title}</title>
  </head>
  <body>
    <main class="lesson-shell">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href={_courseHomeHref}>{_course.title}</a>
        <span aria-hidden="true">/</span>
        <a href={_areaHref}>{_area.title}</a>
        <span aria-hidden="true">/</span>
        <a href={_unitHref}>{_unit.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">単元末演習</span>
      </nav>

      <header class="lesson-hero compact-hero">
        <p class="lesson-kicker">{_area.title} · UNIT EXERCISE</p>
        <h1>{_unit.title}の単元末演習</h1>
        <p>
          単元全体から問題を出し、採点後に小単元別の正答状況を表示します。不正解が多い小単元は復習リンクから戻れます。
        </p>
      </header>

      <ExerciseSet mode="unit" courseKey={_course.key} areaKey={_area.key} unitKey={_unit.key} />

      <nav class="lesson-navigation" aria-label="教材ナビゲーション">
        <a href={_unitHref}>← {_unit.title}の小単元一覧</a>
        <a href={_courseHomeHref}>{_course.title}の目次へ →</a>
      </nav>
    </main>
  </body>
</html>
