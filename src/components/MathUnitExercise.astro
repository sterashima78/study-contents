---
import {
  getCourseCurriculumKey,
  getCourseScopeLabel,
  type MathCourseInfo,
  math1Course,
} from "../content/math-courses";
import type { MathArea, MathUnit } from "../content/math1/types";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ExerciseSet from "./ExerciseSet.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MiddleMathExerciseSet from "./MiddleMathExerciseSet.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SocialExerciseSet from "./SocialExerciseSet.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import BreadcrumbTrail from "./ui/BreadcrumbTrail.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "./ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";

type Props = {
  area: MathArea;
  unit: MathUnit;
  course?: MathCourseInfo;
};

const { area: _area, unit: _unit, course: _course = math1Course } = Astro.props;
const _base = import.meta.env.BASE_URL;
const _courseHomeHref = `${_base}${_course.homePath}`;
const _areaHref = `${_base}${_course.routeBase}/${_area.key}/`;
const _unitHref = `${_areaHref}${_unit.key}/`;
const _scopeLabel = getCourseScopeLabel(_course);
const _curriculumKey = getCourseCurriculumKey(_course);
const _socialCourseKey =
  _course.key === "japanese-history" || _course.key === "world-history" || _course.key === "ethics"
    ? _course.key
    : undefined;
const _middleMathCourseKey =
  _course.key === "middle-math1" || _course.key === "middle-math2" || _course.key === "middle-math3"
    ? _course.key
    : undefined;
---

<StudyPage
  title={`単元末演習 | ${_unit.title} | ${_course.title}`}
  description={`${_scopeLabel}「${_unit.title}」の単元末演習。問題を自動採点し、小単元ごとの弱点を確認します。`}
  curriculumKey={_curriculumKey}
>
  <BreadcrumbTrail
    items={[
      { label: _course.title, href: _courseHomeHref },
      { label: _area.title, href: _areaHref },
      { label: _unit.title, href: _unitHref },
      { label: "単元末演習" },
    ]}
  />
  <ContentHero
    kicker={`${_area.title} · UNIT EXERCISE`}
    title={`${_unit.title}の単元末演習`}
    description="単元全体から問題を出し、採点後に小単元別の正答状況を表示します。不正解が多い小単元は復習リンクから戻れます。"
    compact
  />

  {
    _socialCourseKey ? (
      <SocialExerciseSet
        mode="unit"
        courseKey={_socialCourseKey}
        areaKey={_area.key}
        unitKey={_unit.key}
      />
    ) : _middleMathCourseKey ? (
      <MiddleMathExerciseSet
        mode="unit"
        courseKey={_middleMathCourseKey}
        routeBase={_course.routeBase}
        areaKey={_area.key}
        unitKey={_unit.key}
      />
    ) : (
      <ExerciseSet mode="unit" courseKey={_course.key} areaKey={_area.key} unitKey={_unit.key} />
    )
  }

  <PageNavigation
    previous={{ label: `← ${_unit.title}の小単元一覧`, href: _unitHref }}
    next={{ label: `${_course.title}の目次へ →`, href: _courseHomeHref }}
  />
</StudyPage>
