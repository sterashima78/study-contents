---
type PassageSource = {
  title: string;
  author: string;
  provider: string;
  url: string;
};

type Props = {
  title: string;
  paragraphs: string[];
  source?: PassageSource;
};

const { title: _title, paragraphs: _paragraphs, source: _source } = Astro.props as Props;
---

<article class="english-passage" lang="en">
  <h3>{_title}</h3>
  <div class="body">
    {_paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  {
    _source && (
      <footer class="source-note" lang="ja">
        <span>
          出典: {_source.author}「{_source.title}」
        </span>
        <a href={_source.url}>{_source.provider}</a>
        <span>ADR 0073 権利確認済み</span>
      </footer>
    )
  }
</article>

<style>
  .english-passage {
    padding: clamp(1.4rem, 4vw, 2.2rem);
    border: 1px solid var(--color-border-soft);
    border-radius: 1.15rem;
    background: rgb(255 255 255 / 82%);
  }

  h3 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .body {
    display: grid;
    gap: 0.9rem;
  }

  .body p {
    margin: 0;
    color: var(--color-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
    line-height: 1.9;
  }

  .source-note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: 1.2rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .source-note a {
    color: inherit;
  }
</style>
