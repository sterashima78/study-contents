---
import { type MathCourseInfo, math1Course } from "../content/math-courses";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import BreadcrumbTrail from "./ui/BreadcrumbTrail.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "./ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "./ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "./ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MetricList from "./ui/MetricList.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "./ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "./ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "./ui/StudyPage.astro";

type PatternSummary = {
  id: string;
  title: string;
  level: string;
  estimatedMinutes: number;
  skills: string[];
  thinking: { title: string };
};

type TopicSet = {
  topic: string;
  title: string;
  description: string;
  patterns: PatternSummary[];
};

type Props = {
  topicSet: TopicSet;
  areaTitle: string;
  course?: MathCourseInfo;
};

const {
  topicSet: _topicSet,
  areaTitle: _areaTitle,
  course: _course = math1Course,
} = Astro.props as Props;
const _base = import.meta.env.BASE_URL;
const _levelLabel = (level: string) => (level === "advanced" ? "発展" : "応用");
const _patternSlug = (id: string) => id.replace(`${_course.key}-${_topicSet.topic}-pattern-`, "");
const _applicationCount = _topicSet.patterns.filter(
  (pattern) => pattern.level === "application",
).length;
const _advancedCount = _topicSet.patterns.filter((pattern) => pattern.level === "advanced").length;
const _courseHomeHref = `${_base}${_course.homePath}`;
const _areaHref = `${_base}${_course.routeBase}/${_topicSet.topic}/`;
const _topicHref = `${_base}${_course.routeBase}/entrance/${_topicSet.topic}/`;
const _items = _topicSet.patterns.map((pattern, index) => ({
  marker: String(index + 1).padStart(2, "0"),
  title: pattern.title,
  href: `${_topicHref}${_patternSlug(pattern.id)}/`,
  description: pattern.thinking.title,
  tags: pattern.skills,
  badge: _levelLabel(pattern.level),
  badgeTone: pattern.level === "advanced" ? ("advanced" as const) : ("default" as const),
  meta: `目安 ${pattern.estimatedMinutes}分`,
  action: "このパターンを学ぶ →",
}));
---

<StudyPage
  title={`${_topicSet.title} | 学習コンテンツ`}
  description={`${_course.title}「${_areaTitle}」の応用・発展教材。解法パターンごとに考え方、例題、ステップ練習、実践を学びます。`}
>
  <BreadcrumbTrail
    items={[
      { label: "科目一覧", href: _base },
      { label: _course.title, href: _courseHomeHref },
      { label: _areaTitle, href: _areaHref },
      { label: "応用・発展" },
    ]}
  />
  <ContentHero
    kicker="APPLICATION & ADVANCED"
    title={_topicSet.title}
    description={_topicSet.description}
  >
    <MetricList
      ariaLabel="教材の概要"
      items={[
        { value: `${_topicSet.patterns.length}パターン`, label: "1パターン1ページで学習" },
        {
          value: `応用 ${_applicationCount} / 発展 ${_advancedCount}`,
          label: "解法選択と条件整理を重視",
        },
        { value: "完全独自作成", label: "外部問題本文を転載・軽微改変しない" },
      ]}
    />
  </ContentHero>

  <ContentSection labelledby="patterns-title">
    <SectionHeading
      label="PATTERNS"
      title="解法パターンを選ぶ"
      id="patterns-title"
      description="各ページで「考え方・着眼点 → 例題 → ステップ練習 → 実践」の順に学びます。"
    />
    <ContentIndex items={_items} />
  </ContentSection>

  <PageNavigation
    previous={{ label: `← ${_areaTitle}の基礎教材へ戻る`, href: _areaHref }}
    next={{ label: `${_course.title}トップへ →`, href: _courseHomeHref }}
  />
</StudyPage>
