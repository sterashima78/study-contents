      "areaTitle": "極限",
      "title": "極限 発展",
      "description": "不定形を因数分解で解消して極限を求める発展パターンです。",
      "patterns": [
        {
          "id": "math3-limits-pattern-cancel-indeterminate",
          "title": "0/0型は共通因数を作ってから極限を取る",
          "level": "advanced",
          "estimatedMinutes": 16,
          "skills": ["関数の極限", "因数分解", "不定形"],
          "thinking": {
            "title": "代入で0/0になったら式の構造を変えて定義域の穴を除く",
            "body": ["極限ではxがその値に一致する必要はありません。分子・分母に共通因数がある0/0型なら、xが近い範囲で約分できる形へ変形してから極限値を求めます。"],
            "checkpoints": ["直接代入して不定形を確認する", "分子を因数分解する", "共通因数を約分してから代入する"]
          },
          "example": {
            "statement": ["lim(x→2) (x²−4)/(x−2) を考える。"],
            "question": "極限値を求めよ。",
            "solution": {
              "strategy": "x²−4=(x−2)(x+2)を使う。",
              "steps": ["直接代入すると0/0。", "x≠2では (x²−4)/(x−2)=x+2。", "x→2でx+2→4。"],
              "answer": "4。"
            }
          },
          "guidedPractice": {
            "title": "共通因数を消してから代入する",
            "statement": ["lim(x→3) (x²−9)/(x−3) を考える。"],
            "question": "極限値を求めよう。",
            "steps": [
              {"prompt": "分子を因数分解してください。", "answers": ["(x-3)(x+3)"]},
              {"prompt": "約分後の式を書いてください。", "answers": ["x+3"]},
              {"prompt": "極限値を求めてください。", "answers": ["6"]}
            ],
            "hint": "x²−9は平方差です。"
          },
          "practice": {
            "statement": ["lim(x→1) (x³−1)/(x−1) を考える。"],
            "question": "極限値を求めよ。",
            "solution": {
              "steps": ["x³−1=(x−1)(x²+x+1)。", "x≠1で約分するとx²+x+1。", "x→1より3。"],
              "answer": "3。"
            }
          },
          "rights": {"origin": "original", "reviewStatus": "reviewed", "reviewedAt": "2026-08-29"}
        }
      ]
