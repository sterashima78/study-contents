            "steps": [
              {"prompt": "左辺を2sin(x+α)としたときαを求めてください。", "answers": ["30", "30°"]},
              {"prompt": "xを求めてください。", "answers": ["60", "60°"]}
            ],
            "hint": "2sin(x+30°)=√3sinx+cosxです。"
          },
          "practice": {
            "statement": ["0°≤x<360°で sinx−cosx=1 を考える。"],
            "question": "xをすべて求めよ。",
            "solution": {
              "steps": ["sinx−cosx=√2sin(x−45°)。", "sin(x−45°)=1/√2。", "x−45°=45°,135°より x=90°,180°。"],
              "answer": "x=90°、180°。"
            }
          },
          "rights": {"origin": "original", "reviewStatus": "reviewed", "reviewedAt": "2026-08-29"}
