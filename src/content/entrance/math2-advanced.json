          "level": "advanced",
          "estimatedMinutes": 17,
          "skills": ["対数", "方程式", "定義域"],
          "thinking": {
            "title": "真数条件を最初に書き、最後に不適解を除く",
            "body": ["対数方程式では式変形だけで得た解が真数条件を満たさない場合があります。まず各真数が正という条件を取り、対数をまとめて代数方程式を解いた後に照合します。"],
            "checkpoints": ["真数>0を先に書く", "対数の和を積へまとめる", "得た解を定義域で選別する"]
          },
          "example": {
            "statement": ["log₂(x−1)+log₂(x−3)=3 を考える。"],
            "question": "xを求めよ。",
            "solution": {
              "strategy": "定義域x>3を確定してから積の対数へまとめる。",
              "steps": ["真数条件より x>3。", "log₂((x−1)(x−3))=3 より (x−1)(x−3)=8。", "x²−4x−5=0から x=5,−1。定義域より x=5。"],
              "answer": "x=5。"
            }
          },
          "guidedPractice": {
            "title": "真数条件で解を絞る",
            "statement": ["log₃(x−1)+log₃(x+1)=2 を考える。"],
            "question": "定義域と解を求めよう。",
            "steps": [
              {"prompt": "定義域を書いてください。", "answers": ["x>1"]},
              {"prompt": "対数をまとめた後の方程式を書いてください。", "answers": ["x²-1=9", "x^2-1=9"]},
              {"prompt": "最終的な解を書いてください。", "answers": ["√10"]}
            ],
            "hint": "x=−√10は代数方程式の解でも真数条件を満たしません。"
          },
          "practice": {
            "statement": ["log₂x+log₂(x−2)=3 を考える。"],
            "question": "xを求めよ。",
            "solution": {
              "steps": ["定義域はx>2。", "x(x−2)=8より x²−2x−8=0。", "x=4,−2のうち定義域を満たすのは4。"],
              "answer": "x=4。"
            }
          },
          "rights": {"origin": "original", "reviewStatus": "reviewed", "reviewedAt": "2026-08-29"}
        }
