          "example": {
            "statement": ["P(x)=x³+ax+b が x−1 と x+2 の両方で割り切れる。"],
            "question": "a,bを求めよ。",
            "solution": {
              "strategy": "P(1)=0、P(−2)=0を連立する。",
              "steps": ["P(1)=1+a+b=0。", "P(−2)=−8−2a+b=0。", "2式の差から a=−3、さらに b=2。"],
              "answer": "a=−3、b=2。"
            }
          },
          "guidedPractice": {
