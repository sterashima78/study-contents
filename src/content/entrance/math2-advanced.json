            "body": ["動点P(x,y)が2点A,Bから等距離なら PA²=PB² と置くと平方根を使わず整理できます。二次項が消え、垂直二等分線の一次方程式になります。"],
            "checkpoints": ["動点をP(x,y)と置く", "PA²=PB²を書く", "展開して不要な二次項を消す"]
          },
          "example": {
            "statement": ["点A(2,0)、B(0,4)から等距離にある点P(x,y)を考える。"],
            "question": "Pの軌跡の方程式を求めよ。",
            "solution": {
              "strategy": "PA²=PB²を座標で表す。",
              "steps": ["(x−2)²+y²=x²+(y−4)²。", "展開して −4x+4=−8y+16。", "整理して x−2y+3=0。"],
              "answer": "x−2y+3=0。"
            }
          },
          "guidedPractice": {
            "title": "距離の平方を等しく置く",
            "statement": ["A(4,0)、B(0,2)から等距離にあるP(x,y)を考える。"],
            "question": "軌跡を求めよう。",
            "steps": [
              {"prompt": "距離条件を平方した等式で書いてください。", "answers": ["(x-4)²+y²=x²+(y-2)²", "(x-4)^2+y^2=x^2+(y-2)^2"]},
              {"prompt": "整理後の方程式を書いてください。", "answers": ["2x-y-3=0", "2x−y−3=0"]}
            ],
            "hint": "x²とy²は両辺で消えます。"
          },
          "practice": {
            "statement": ["A(−2,0)、B(0,6)から等距離にある点P(x,y)の軌跡を考える。"],
            "question": "軌跡の方程式を求めよ。",
            "solution": {
              "steps": ["(x+2)²+y²=x²+(y−6)²。", "4x+4=−12y+36。", "x+3y−8=0。"],
              "answer": "x+3y−8=0。"
            }
          },
