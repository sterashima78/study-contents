      "topic": "sequences",
      "areaTitle": "数列",
      "title": "数列 発展",
      "description": "差分型の漸化式を和へ直して一般項を求める発展パターンです。",
      "patterns": [
        {
          "id": "mathb-sequences-pattern-difference-sum",
          "title": "aₙ₊₁−aₙを足し上げて一般項を作る",
          "level": "advanced",
          "estimatedMinutes": 18,
          "skills": ["漸化式", "数列の和", "一般項"],
          "thinking": {
            "title": "隣接項の差が分かるなら差を1項目からn−1項目まで足す",
            "body": ["aₙ₊₁=aₙ+f(n) の形では aₙ−a₁ を差の和として表せます。Σf(k)を計算し、初項を戻すと一般項が得られます。"],
            "checkpoints": ["aₙ₊₁−aₙ=f(n)へ直す", "k=1からn−1まで和を取る", "初項を加えて整理する"]
          },
          "example": {
            "statement": ["a₁=1、aₙ₊₁=aₙ+2n+1 とする。"],
            "question": "aₙを求めよ。",
            "solution": {
              "strategy": "差2n+1を1からn−1まで足す。",
              "steps": ["aₙ−a₁=Σ(k=1→n−1)(2k+1)。", "=n(n−1)+(n−1)=n²−1。", "a₁=1より aₙ=n²。"],
              "answer": "aₙ=n²。"
            }
          },
          "guidedPractice": {
            "title": "差の和を一般項へ戻す",
            "statement": ["a₁=2、aₙ₊₁=aₙ+3n とする。"],
            "question": "aₙを求めよう。",
            "steps": [
              {"prompt": "aₙ−2をΣで表してください。", "answers": ["3Σk", "3sumk", "Σ3k"]},
              {"prompt": "aₙをnの式で書いてください。", "answers": ["2+3n(n-1)/2", "3n(n-1)/2+2"]}
            ],
            "hint": "1+2+…+(n−1)=n(n−1)/2です。"
          },
          "practice": {
            "statement": ["a₁=1、aₙ₊₁=aₙ+2n とする。"],
            "question": "aₙを求めよ。",
            "solution": {
              "steps": ["aₙ−1=2Σ(k=1→n−1)k。", "=n(n−1)。", "aₙ=n²−n+1。"],
              "answer": "aₙ=n²−n+1。"
            }
          },
          "rights": {"origin": "original", "reviewStatus": "reviewed", "reviewedAt": "2026-08-29"}
        }
      ]
    },
