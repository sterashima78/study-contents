          "practice": {
            "statement": ["標本比率0.48、標準誤差0.03である。"],
            "question": "同じ近似で95%信頼区間を求めよ。",
            "solution": {
              "steps": ["半幅は2×0.03=0.06。", "0.48−0.06=0.42。", "0.48+0.06=0.54。"],
              "answer": "約0.42〜0.54。"
            }
          },
