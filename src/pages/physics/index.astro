---
import { physicsAreas } from "../../content/physics/catalog";
import "../../styles/global.css";

const _base = import.meta.env.BASE_URL;
const _areas = physicsAreas.map((area, index) => ({
  ...area,
  number: String(index + 1).padStart(2, "0"),
  lessonCount: area.units.reduce((sum, unit) => sum + unit.lessons.length, 0),
}));
const _totalLessonCount = _areas.reduce((sum, area) => sum + area.lessonCount, 0);
const _lessonSummary = `全${_totalLessonCount}小教材。`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="高校物理の学習コンテンツ。様々な運動、波、電気と磁気、原子を、現象・法則・式の根拠・例題・演習をつないで学びます。"
    />
    <title>物理 | 学習コンテンツ</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="hero">
        <p class="eyebrow">PHYSICS</p>
        <h1>物理</h1>
        <p class="lead">
          物理基礎で学んだ運動・波・電気・エネルギーを土台に、平面運動、運動量、円運動、万有引力、光、電磁気、原子・原子核まで発展させます。式だけでなく、成り立つ条件、実験・観測との関係、物理量の意味を確認して進みます。
        </p>
        <div class="learning-flow" aria-label="各小単元の学習の流れ">
          <span>現象と考え方</span>
          <span aria-hidden="true">→</span>
          <span>式の条件・根拠</span>
          <span aria-hidden="true">→</span>
          <span>例題</span>
          <span aria-hidden="true">→</span>
          <span>直後の練習</span>
          <span aria-hidden="true">→</span>
          <span>3問確認</span>
          <span aria-hidden="true">→</span>
          <span>単元末演習</span>
        </div>
      </header>

      <section class="curriculum" aria-labelledby="curriculum-title">
        <div class="section-heading">
          <div>
            <p class="section-label">CONTENTS</p>
            <h2 id="curriculum-title">学習する4つの領域</h2>
          </div>
          <p>{_lessonSummary}現行学習指導要領の「物理」を、4領域・13単元に整理して学習します。</p>
        </div>

        <ol class="unit-grid">
          {
            _areas.map((area) => (
              <li class="unit-card">
                <div class="unit-header">
                  <span class="unit-number" aria-hidden="true">{area.number}</span>
                  <h3><a href={`${_base}physics/${area.key}/`}>{area.title}</a></h3>
                </div>
                <p class="unit-description">{area.description}</p>
                <ul class="topic-list">
                  {area.units.map((unit) => (
                    <li>
                      <a href={`${_base}physics/${area.key}/${unit.key}/`}>{unit.title}</a>
                    </li>
                  ))}
                </ul>
                <p class="preparing available">{area.lessonCount}小教材公開</p>
              </li>
            ))
          }
        </ol>
      </section>

      <footer class="page-footer">
        <p>高校 物理</p>
        <p>現行学習指導要領の「物理」を、4領域・33小教材と単元末演習で学習できます。</p>
        <p><a href={_base}>科目一覧へ</a></p>
      </footer>
    </main>
  </body>
</html>
