---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import AlgebraUnitExercise from "../../../../components/AlgebraUnitExercise.astro";
import { algebraUnits, getAlgebraUnit } from "../../../../content/math1/algebra";

export function getStaticPaths() {
  return algebraUnits.map((unit) => ({ params: { unit: unit.key } }));
}

const { unit: unitKey } = Astro.params;
const unit = unitKey ? getAlgebraUnit(unitKey) : undefined;

if (!unit) {
  return Astro.redirect(import.meta.env.BASE_URL);
}
---

<AlgebraUnitExercise unit={unit} />
