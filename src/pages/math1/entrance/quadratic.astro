---
import _problemSet from "../../../content/entrance/math1-quadratic.json";
import "../../../styles/global.css";
import "../../../styles/entrance.css";
import "../../../styles/entrance-index.css";

const _base = import.meta.env.BASE_URL;
const _applicationCount = _problemSet.patterns.filter(
  (pattern) => pattern.level === "application",
).length;
const _advancedCount = _problemSet.patterns.filter(
  (pattern) => pattern.level === "advanced",
).length;
const _generatorCount = _problemSet.patterns.filter((pattern) => "generatorKey" in pattern).length;
const _levelLabel = (level: string) => (level === "advanced" ? "発展" : "応用");
const _patternSlug = (id: string) => id.replace("math1-quadratic-pattern-", "");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="数学Iの二次関数を、解法パターンごとの個別ページで学ぶ応用・発展教材の一覧です。"
    />
    <title>{_problemSet.title} | 学習コンテンツ</title>
  </head>
  <body>
    <main class="page-shell entrance-page entrance-index-page">
      <header class="entrance-hero">
        <nav class="breadcrumbs" aria-label="パンくずリスト">
          <a href={_base}>科目一覧</a>
          <span aria-hidden="true">/</span>
          <a href={`${_base}math1/`}>数学I</a>
          <span aria-hidden="true">/</span>
          <a href={`${_base}math1/quadratic/`}>二次関数</a>
          <span aria-hidden="true">/</span>
          <span>応用・発展</span>
        </nav>

        <p class="eyebrow">APPLICATION & ADVANCED</p>
        <h1>{_problemSet.title}</h1>
        <p class="lead">{_problemSet.description}</p>

        <ul class="entrance-summary" aria-label="教材の概要">
          <li>
            <strong>{_problemSet.patterns.length}パターン</strong>
            <span>1パターン1ページで学習</span>
          </li>
          <li>
            <strong>応用 {_applicationCount} / 発展 {_advancedCount}</strong>
            <span>必要な判断の多さで難度を分類</span>
          </li>
          <li>
            <strong>{_generatorCount}パターン生成対応</strong>
            <span>同じ着眼点を別条件で反復</span>
          </li>
        </ul>

        <div class="advanced-learning-flow" aria-label="各パターンページの学習の流れ">
          <span>考え方</span>
          <span aria-hidden="true">→</span>
          <span>例題</span>
          <span aria-hidden="true">→</span>
          <span>ステップ練習</span>
          <span aria-hidden="true">→</span>
          <span>実践</span>
          <span aria-hidden="true">→</span>
          <span>別問題で反復</span>
        </div>
      </header>

      <section aria-labelledby="patterns-title">
        <div class="section-heading">
          <div>
            <p class="section-label">PATTERNS</p>
            <h2 id="patterns-title">学ぶパターンを選ぶ</h2>
          </div>
          <p>各パターンは個別ページに分かれています。着眼点を確認して、必要なテーマから学習してください。</p>
        </div>

        <ol class="pattern-index-list">
          {
            _problemSet.patterns.map((pattern, index) => (
              <li class="pattern-index-card">
                <div class="pattern-index-heading">
                  <div>
                    <p class="pattern-number">PATTERN {String(index + 1).padStart(2, "0")}</p>
                    <h3>
                      <a href={`${_base}math1/entrance/quadratic/${_patternSlug(pattern.id)}/`}>
                        {pattern.title}
                      </a>
                    </h3>
                  </div>
                  <div class="pattern-meta">
                    <span class={`level-badge level-${pattern.level}`}>{_levelLabel(pattern.level)}</span>
                    <span>目安 {pattern.estimatedMinutes}分</span>
                  </div>
                </div>

                <p class="pattern-index-description">{pattern.thinking.title}</p>

                <ul class="skill-list" aria-label={`${pattern.title}で使う主な技能`}>
                  {pattern.skills.map((skill) => <li>{skill}</li>)}
                </ul>

                <a
                  class="pattern-index-link"
                  href={`${_base}math1/entrance/quadratic/${_patternSlug(pattern.id)}/`}
                >
                  このパターンを学ぶ →
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <nav class="entrance-footer-nav" aria-label="関連ページ">
        <a href={`${_base}math1/quadratic/`}>二次関数の基礎教材へ戻る</a>
        <a href={`${_base}math1/`}>数学Iトップへ</a>
      </nav>
    </main>
  </body>
</html>
