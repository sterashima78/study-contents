---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ApplicationDiagram from "../../../components/ApplicationDiagram.astro";
import _problemSet from "../../../content/entrance/math1-quadratic.json";
import "../../../styles/global.css";
import "../../../styles/entrance.css";

const _base = import.meta.env.BASE_URL;
const _applicationCount = _problemSet.patterns.filter(
  (pattern) => pattern.level === "application",
).length;
const _advancedCount = _problemSet.patterns.filter(
  (pattern) => pattern.level === "advanced",
).length;
const _generatorCount = _problemSet.patterns.filter((pattern) => "generatorKey" in pattern).length;
const _levelLabel = (level: string) => (level === "advanced" ? "発展" : "応用");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="数学Iの二次関数を、考え方・例題・ステップ練習・実践の順で学ぶ応用・発展教材。独自問題の生成と図解にも対応します。"
    />
    <title>{_problemSet.title} | 学習コンテンツ</title>
  </head>
  <body>
    <main class="page-shell entrance-page">
      <header class="entrance-hero">
        <nav class="breadcrumbs" aria-label="パンくずリスト">
          <a href={_base}>科目一覧</a>
          <span aria-hidden="true">/</span>
          <a href={`${_base}math1/`}>数学I</a>
          <span aria-hidden="true">/</span>
          <a href={`${_base}math1/quadratic/`}>二次関数</a>
          <span aria-hidden="true">/</span>
          <span>応用・発展</span>
        </nav>

        <p class="eyebrow">APPLICATION & ADVANCED</p>
        <h1>{_problemSet.title}</h1>
        <p class="lead">{_problemSet.description}</p>

        <ul class="entrance-summary" aria-label="教材の概要">
          <li>
            <strong>{_problemSet.patterns.length}パターン</strong>
            <span>解法を選ぶ着眼点ごとに学習</span>
          </li>
          <li>
            <strong>応用 {_applicationCount} / 発展 {_advancedCount}</strong>
            <span>基礎から段階的に難度を上げる</span>
          </li>
          <li>
            <strong>{_generatorCount}パターン生成対応</strong>
            <span>同じ考え方を別条件で反復</span>
          </li>
        </ul>

        <div class="advanced-learning-flow" aria-label="応用・発展教材の学習の流れ">
          <span>考え方</span>
          <span aria-hidden="true">→</span>
          <span>例題</span>
          <span aria-hidden="true">→</span>
          <span>ステップ練習</span>
          <span aria-hidden="true">→</span>
          <span>実践</span>
          <span aria-hidden="true">→</span>
          <span>別問題で反復</span>
        </div>

        <p class="rights-note">
          問題文・設定・数値・解答・解説・図は、このリポジトリ向けに新規作成しています。問題生成も外部問題の文章を組み替えるのではなく、独自の数学的パターンと制約から行います。
        </p>
      </header>

      <section aria-labelledby="patterns-title">
        <div class="section-heading">
          <div>
            <p class="section-label">PATTERNS</p>
            <h2 id="patterns-title">解法パターンを身につける</h2>
          </div>
          <p>
            まず「何を見て解法を選ぶか」を確認し、例題と誘導付き練習で手順を再現してから、誘導の少ない実践問題へ進みます。
          </p>
        </div>

        <ol class="application-pattern-list">
          {
            _problemSet.patterns.map((pattern, index) => (
              <li class="application-pattern" id={pattern.id}>
                <header class="pattern-header">
                  <div>
                    <p class="pattern-number">PATTERN {String(index + 1).padStart(2, "0")}</p>
                    <h2>{pattern.title}</h2>
                  </div>
                  <div class="pattern-meta">
                    <span class={`level-badge level-${pattern.level}`}>{_levelLabel(pattern.level)}</span>
                    <span>目安 {pattern.estimatedMinutes}分</span>
                  </div>
                </header>

                <ul class="skill-list" aria-label="このパターンで使う主な技能">
                  {pattern.skills.map((skill) => <li>{skill}</li>)}
                </ul>

                <section class="pattern-block thinking-block" aria-labelledby={`${pattern.id}-thinking`}>
                  <p class="pattern-section-label">THINKING</p>
                  <h3 id={`${pattern.id}-thinking`}>考え方・着眼点</h3>
                  <h4>{pattern.thinking.title}</h4>
                  {pattern.thinking.body.map((paragraph) => <p>{paragraph}</p>)}
                  <ol class="checkpoint-list">
                    {pattern.thinking.checkpoints.map((checkpoint) => <li>{checkpoint}</li>)}
                  </ol>
                </section>

                {
                  "diagram" in pattern && pattern.diagram && (
                    <ApplicationDiagram diagram={pattern.diagram} />
                  )
                }

                <section class="pattern-block example-block" aria-labelledby={`${pattern.id}-example`}>
                  <p class="pattern-section-label">EXAMPLE</p>
                  <h3 id={`${pattern.id}-example`}>例題</h3>
                  <div class="problem-body">
                    {pattern.example.statement.map((paragraph) => <p>{paragraph}</p>)}
                    <p class="problem-question">{pattern.example.question}</p>
                  </div>
                  <div class="worked-solution">
                    <h4>方針</h4>
                    <p>{pattern.example.solution.strategy}</p>
                    <ol class="worked-steps">
                      {pattern.example.solution.steps.map((step) => <li>{step}</li>)}
                    </ol>
                    <p class="solution-answer">{pattern.example.solution.answer}</p>
                  </div>
                </section>

                <section
                  class="pattern-block guided-block"
                  aria-labelledby={`${pattern.id}-guided`}
                  data-guided-practice
                >
                  <p class="pattern-section-label">STEP PRACTICE</p>
                  <h3 id={`${pattern.id}-guided`}>ステップバイステップの練習</h3>
                  <h4>{pattern.guidedPractice.title}</h4>
                  <div class="problem-body">
                    {pattern.guidedPractice.statement.map((paragraph) => <p>{paragraph}</p>)}
                    <p class="problem-question">{pattern.guidedPractice.question}</p>
                  </div>
                  <form class="guided-practice-form">
                    <ol class="guided-fields">
                      {pattern.guidedPractice.steps.map((step, stepIndex) => (
                        <li>
                          <label>
                            <span>{step.prompt}</span>
                            <input
                              type="text"
                              autocomplete="off"
                              spellcheck="false"
                              placeholder={step.placeholder}
                              data-answers={JSON.stringify(step.answers)}
                              aria-label={`${pattern.title} ステップ${stepIndex + 1}: ${step.prompt}`}
                              required
                            />
                          </label>
                        </li>
                      ))}
                    </ol>
                    <div class="practice-actions">
                      <button type="submit" class="primary-button">答え合わせ</button>
                      <button type="button" class="secondary-button hint-button">ヒント</button>
                      <button type="reset" class="secondary-button">やり直す</button>
                    </div>
                  </form>
                  <p class="hint practice-hint" hidden>{pattern.guidedPractice.hint}</p>
                  <p class="feedback practice-feedback" aria-live="polite" />
                </section>

                <section class="pattern-block practice-block" aria-labelledby={`${pattern.id}-practice`}>
                  <p class="pattern-section-label">PRACTICE</p>
                  <h3 id={`${pattern.id}-practice`}>実践</h3>
                  <div class="problem-body">
                    {pattern.practice.statement.map((paragraph) => <p>{paragraph}</p>)}
                    <p class="problem-question">{pattern.practice.question}</p>
                  </div>
                  <details class="solution">
                    <summary>実践問題の解答・解説を表示</summary>
                    <div class="solution-content">
                      <ol>
                        {pattern.practice.solution.steps.map((step) => <li>{step}</li>)}
                      </ol>
                      <p class="solution-answer">{pattern.practice.solution.answer}</p>
                    </div>
                  </details>
                </section>

                {
                  "generatorKey" in pattern && pattern.generatorKey && (
                    <section
                      class="pattern-block generator-block"
                      data-generator
                      data-generator-key={pattern.generatorKey}
                    >
                      <p class="pattern-section-label">GENERATED PRACTICE</p>
                      <div class="generator-heading">
                        <div>
                          <h3>同じパターンでもう1問</h3>
                          <p>このパターンの成立条件を保ったまま、数値や条件を変えた独自問題を生成します。</p>
                        </div>
                        <button type="button" class="secondary-button generator-button">
                          別の実践問題を生成
                        </button>
                      </div>
                      <div class="generated-problem" data-generated-content hidden>
                        <div class="problem-body" data-generated-statement />
                        <p class="problem-question" data-generated-question />
                        <details class="solution" data-generated-solution>
                          <summary>生成問題の解答・解説を表示</summary>
                          <div class="solution-content">
                            <ol data-generated-steps />
                            <p class="solution-answer" data-generated-answer />
                          </div>
                        </details>
                      </div>
                      <p class="generator-feedback" aria-live="polite" />
                    </section>
                  )
                }
              </li>
            ))
          }
        </ol>
      </section>

      <nav class="entrance-footer-nav" aria-label="関連ページ">
        <a href={`${_base}math1/quadratic/`}>二次関数の基礎教材へ戻る</a>
        <a href={`${_base}math1/`}>数学Iトップへ</a>
      </nav>
    </main>

    <script>
      import { generateMath1QuadraticPractice } from "../../../content/entrance/math1-quadratic-generators";

      const normalizeAnswer = (value: string) =>
        value
          .trim()
          .toLowerCase()
          .replaceAll(/\s+/g, "")
          .replaceAll("−", "-")
          .replaceAll("–", "-")
          .replaceAll("—", "-")
          .replaceAll("×", "*")
          .replaceAll("·", "*")
          .replaceAll("，", ",")
          .replaceAll("（", "(")
          .replaceAll("）", ")")
          .replaceAll("^2", "²");

      for (const block of document.querySelectorAll("[data-guided-practice]")) {
        if (!(block instanceof HTMLElement)) continue;
        const form = block.querySelector(".guided-practice-form");
        const feedback = block.querySelector(".practice-feedback");
        const hint = block.querySelector(".practice-hint");
        const hintButton = block.querySelector(".hint-button");
        if (
          !(form instanceof HTMLFormElement) ||
          !(feedback instanceof HTMLElement) ||
          !(hint instanceof HTMLElement) ||
          !(hintButton instanceof HTMLButtonElement)
        ) continue;

        hintButton.addEventListener("click", () => {
          hint.hidden = !hint.hidden;
          hintButton.textContent = hint.hidden ? "ヒント" : "ヒントを閉じる";
        });

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const inputs = [...form.querySelectorAll("input[data-answers]")].filter(
            (input): input is HTMLInputElement => input instanceof HTMLInputElement,
          );
          let correctCount = 0;

          for (const input of inputs) {
            const rawAnswers = input.dataset.answers;
            if (!rawAnswers) continue;
            const answers = (JSON.parse(rawAnswers) as string[]).map(normalizeAnswer);
            const isCorrect = answers.includes(normalizeAnswer(input.value));
            input.classList.toggle("is-correct", isCorrect);
            input.classList.toggle("is-error", !isCorrect);
            if (isCorrect) correctCount += 1;
          }

          if (correctCount === inputs.length) {
            feedback.textContent = "すべて正解です。着眼点から解答手順まで再現できています。";
            feedback.className = "feedback practice-feedback is-correct";
          } else {
            feedback.textContent = `全 ${inputs.length} 段階のうち ${correctCount} 段階が合っています。例題の判断順序と比べて確認してください。`;
            feedback.className = "feedback practice-feedback is-error";
          }
        });

        form.addEventListener("reset", () => {
          window.setTimeout(() => {
            for (const input of form.querySelectorAll("input")) {
              input.classList.remove("is-correct", "is-error");
            }
            feedback.textContent = "";
            feedback.className = "feedback practice-feedback";
            hint.hidden = true;
            hintButton.textContent = "ヒント";
          }, 0);
        });
      }

      for (const block of document.querySelectorAll("[data-generator]")) {
        if (!(block instanceof HTMLElement)) continue;
        const button = block.querySelector(".generator-button");
        const content = block.querySelector("[data-generated-content]");
        const statement = block.querySelector("[data-generated-statement]");
        const question = block.querySelector("[data-generated-question]");
        const steps = block.querySelector("[data-generated-steps]");
        const answer = block.querySelector("[data-generated-answer]");
        const solution = block.querySelector("[data-generated-solution]");
        const feedback = block.querySelector(".generator-feedback");
        if (
          !(button instanceof HTMLButtonElement) ||
          !(content instanceof HTMLElement) ||
          !(statement instanceof HTMLElement) ||
          !(question instanceof HTMLElement) ||
          !(steps instanceof HTMLOListElement) ||
          !(answer instanceof HTMLElement) ||
          !(solution instanceof HTMLDetailsElement) ||
          !(feedback instanceof HTMLElement)
        ) continue;

        button.addEventListener("click", () => {
          const key = block.dataset.generatorKey;
          if (!key) return;
          const generated = generateMath1QuadraticPractice(key);
          if (!generated) {
            feedback.textContent = "このパターンの生成器を読み込めませんでした。";
            return;
          }

          statement.replaceChildren(
            ...generated.statement.map((text) => {
              const paragraph = document.createElement("p");
              paragraph.textContent = text;
              return paragraph;
            }),
          );
          question.textContent = generated.question;
          steps.replaceChildren(
            ...generated.solution.steps.map((text) => {
              const item = document.createElement("li");
              item.textContent = text;
              return item;
            }),
          );
          answer.textContent = generated.solution.answer;
          solution.open = false;
          content.hidden = false;
          feedback.textContent =
            "別の条件で実践問題を生成しました。まず解答を閉じたまま解いてください。";
        });
      }
    </script>
  </body>
</html>
