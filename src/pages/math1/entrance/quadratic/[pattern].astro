---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import AdvancedPatternPage from "../../../../components/AdvancedPatternPage.astro";
import problemSet from "../../../../content/entrance/math1-quadratic.json";
import { math1Course } from "../../../../content/math-courses";

export function getStaticPaths() {
  return problemSet.patterns.map((pattern, patternIndex) => ({
    params: { pattern: pattern.id.replace("math1-quadratic-pattern-", "") },
    props: { pattern, patternIndex },
  }));
}

type Pattern = (typeof problemSet.patterns)[number];
type Props = { pattern: Pattern; patternIndex: number };
const { pattern: _pattern, patternIndex: _patternIndex } = Astro.props as Props;
---

<AdvancedPatternPage
  topicSet={problemSet}
  areaTitle="二次関数"
  pattern={_pattern}
  patternIndex={_patternIndex}
  course={math1Course}
/>
