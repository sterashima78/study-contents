---
import _problemSet from "../../../../content/entrance/math1-quadratic.json";
import "../../../../styles/global.css";
import "../../../../styles/entrance.css";

const _patternPrefix = "math1-quadratic-pattern-";
const _patternSlug = (id: string) => id.replace(_patternPrefix, "");

export function getStaticPaths() {
  return _problemSet.patterns.map((pattern, index) => ({
    params: { pattern: _patternSlug(pattern.id) },
    props: { pattern, index },
  }));
}

type Pattern = (typeof _problemSet.patterns)[number];
type Props = {
  pattern: Pattern;
  index: number;
};

const { pattern: _pattern, index: _patternIndex } = Astro.props as Props;
const _base = import.meta.env.BASE_URL;
const _levelLabel = _pattern.level === "advanced" ? "発展" : "応用";
const _previousPattern =
  _patternIndex > 0 ? _problemSet.patterns[_patternIndex - 1] : undefined;
const _nextPattern =
  _patternIndex < _problemSet.patterns.length - 1
    ? _problemSet.patterns[_patternIndex + 1]
    : undefined;
const _patternHref = (pattern: Pattern) =>
  `${_base}math1/entrance/quadratic/${_patternSlug(pattern.id)}/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`数学I二次関数の${_levelLabel}パターン「${_pattern.title}」。考え方、例題、ステップ練習、実践の順で学びます。`}
    />
    <title>{_pattern.title} | 二次関数 応用・発展 | 学習コンテンツ</title>
  </head>
  <body>
    <main class="page-shell entrance-page">
      <header class="entrance-hero">
        <nav class="breadcrumbs" aria-label="パンくずリスト">
          <a href={_base}>科目一覧</a>
          <span aria-hidden="true">/</span>
          <a href={`${_base}math1/`}>数学I</a>
          <span aria-hidden="true">/</span>
          <a href={`${_base}math1/quadratic/`}>二次関数</a>
          <span aria-hidden="true">/</span>
          <a href={`${_base}math1/entrance/quadratic/`}>応用・発展</a>
          <span aria-hidden="true">/</span>
          <span>{_pattern.title}</span>
        </nav>

        <p class="pattern-number">PATTERN {String(_patternIndex + 1).padStart(2, "0")}</p>
        <div class="pattern-header">
          <div>
            <p class="eyebrow">APPLICATION & ADVANCED</p>
            <h1>{_pattern.title}</h1>
          </div>
          <div class="pattern-meta">
            <span class={`level-badge level-${_pattern.level}`}>{_levelLabel}</span>
            <span>目安 {_pattern.estimatedMinutes}分</span>
          </div>
        </div>

        <ul class="skill-list" aria-label="このパターンで使う主な技能">
          {_pattern.skills.map((skill) => <li>{skill}</li>)}
        </ul>

        <div class="advanced-learning-flow" aria-label="このページの学習の流れ">
          <span>考え方</span>
          <span aria-hidden="true">→</span>
          <span>例題</span>
          <span aria-hidden="true">→</span>
          <span>ステップ練習</span>
          <span aria-hidden="true">→</span>
          <span>実践</span>
          {"generatorKey" in _pattern && _pattern.generatorKey && <span aria-hidden="true">→</span>}
          {"generatorKey" in _pattern && _pattern.generatorKey && <span>別問題で反復</span>}
        </div>
      </header>

      <article class="application-pattern single-pattern-page">
        <section class="pattern-block thinking-block" aria-labelledby="thinking-title">
          <p class="pattern-section-label">THINKING</p>
          <h2 id="thinking-title">考え方・着眼点</h2>
          <h3>{_pattern.thinking.title}</h3>
          {_pattern.thinking.body.map((paragraph) => <p>{paragraph}</p>)}
          <ol class="checkpoint-list">
            {_pattern.thinking.checkpoints.map((checkpoint) => <li>{checkpoint}</li>)}
          </ol>
        </section>

        <section class="pattern-block example-block" aria-labelledby="example-title">
          <p class="pattern-section-label">EXAMPLE</p>
          <h2 id="example-title">例題</h2>
          <div class="problem-body">
            {_pattern.example.statement.map((paragraph) => <p>{paragraph}</p>)}
            <p class="problem-question">{_pattern.example.question}</p>
          </div>
          <div class="worked-solution">
            <h3>方針</h3>
            <p>{_pattern.example.solution.strategy}</p>
            <ol class="worked-steps">
              {_pattern.example.solution.steps.map((step) => <li>{step}</li>)}
            </ol>
            <p class="solution-answer">{_pattern.example.solution.answer}</p>
          </div>
        </section>

        <section class="pattern-block guided-block" aria-labelledby="guided-title" data-guided-practice>
          <p class="pattern-section-label">STEP PRACTICE</p>
          <h2 id="guided-title">ステップバイステップの練習</h2>
          <h3>{_pattern.guidedPractice.title}</h3>
          <div class="problem-body">
            {_pattern.guidedPractice.statement.map((paragraph) => <p>{paragraph}</p>)}
            <p class="problem-question">{_pattern.guidedPractice.question}</p>
          </div>
          <form class="guided-practice-form">
            <ol class="guided-fields">
              {_pattern.guidedPractice.steps.map((step, stepIndex) => (
                <li>
                  <label>
                    <span>{step.prompt}</span>
                    <input
                      type="text"
                      autocomplete="off"
                      spellcheck="false"
                      placeholder={step.placeholder}
                      data-answers={JSON.stringify(step.answers)}
                      aria-label={`${_pattern.title} ステップ${stepIndex + 1}: ${step.prompt}`}
                      required
                    />
                  </label>
                </li>
              ))}
            </ol>
            <div class="practice-actions">
              <button type="submit" class="primary-button">答え合わせ</button>
              <button type="button" class="secondary-button hint-button">ヒント</button>
              <button type="reset" class="secondary-button">やり直す</button>
            </div>
          </form>
          <p class="hint practice-hint" hidden>{_pattern.guidedPractice.hint}</p>
          <p class="feedback practice-feedback" aria-live="polite" />
        </section>

        <section class="pattern-block practice-block" aria-labelledby="practice-title">
          <p class="pattern-section-label">PRACTICE</p>
          <h2 id="practice-title">実践</h2>
          <div class="problem-body">
            {_pattern.practice.statement.map((paragraph) => <p>{paragraph}</p>)}
            <p class="problem-question">{_pattern.practice.question}</p>
          </div>
          <details class="solution">
            <summary>実践問題の解答・解説を表示</summary>
            <div class="solution-content">
              <ol>
                {_pattern.practice.solution.steps.map((step) => <li>{step}</li>)}
              </ol>
              <p class="solution-answer">{_pattern.practice.solution.answer}</p>
            </div>
          </details>
        </section>

        {
          "generatorKey" in _pattern && _pattern.generatorKey && (
            <section
              class="pattern-block generator-block"
              data-generator
              data-generator-key={_pattern.generatorKey}
              aria-labelledby="generator-title"
            >
              <p class="pattern-section-label">GENERATED PRACTICE</p>
              <div class="generator-heading">
                <div>
                  <h2 id="generator-title">同じパターンでもう1問</h2>
                  <p>成立条件を保ったまま、数値や条件を変えた独自問題を生成します。</p>
                </div>
                <button type="button" class="secondary-button generator-button">
                  別の実践問題を生成
                </button>
              </div>
              <div class="generated-problem" data-generated-content hidden>
                <div class="problem-body" data-generated-statement />
                <p class="problem-question" data-generated-question />
                <details class="solution" data-generated-solution>
                  <summary>生成問題の解答・解説を表示</summary>
                  <div class="solution-content">
                    <ol data-generated-steps />
                    <p class="solution-answer" data-generated-answer />
                  </div>
                </details>
              </div>
              <p class="generator-feedback" aria-live="polite" />
            </section>
          )
        }
      </article>

      <nav class="lesson-navigation entrance-pattern-navigation" aria-label="パターンナビゲーション">
        <div>
          {_previousPattern ? (
            <a href={_patternHref(_previousPattern)}>← {_previousPattern.title}</a>
          ) : (
            <a href={`${_base}math1/entrance/quadratic/`}>← パターン一覧</a>
          )}
        </div>
        <a class="unit-index-link" href={`${_base}math1/entrance/quadratic/`}>パターン一覧</a>
        <div>
          {_nextPattern ? (
            <a href={_patternHref(_nextPattern)}>{_nextPattern.title} →</a>
          ) : (
            <a href={`${_base}math1/quadratic/`}>二次関数の基礎教材へ →</a>
          )}
        </div>
      </nav>
    </main>

    <script>
      import { generateMath1QuadraticPractice } from "../../../../content/entrance/math1-quadratic-generators";

      const normalizeAnswer = (value: string) =>
        value
          .trim()
          .toLowerCase()
          .replaceAll(/\s+/g, "")
          .replaceAll("−", "-")
          .replaceAll("–", "-")
          .replaceAll("—", "-")
          .replaceAll("×", "*")
          .replaceAll("·", "*")
          .replaceAll("，", ",")
          .replaceAll("（", "(")
          .replaceAll("）", ")")
          .replaceAll("^2", "²");

      for (const block of document.querySelectorAll("[data-guided-practice]")) {
        if (!(block instanceof HTMLElement)) continue;
        const form = block.querySelector(".guided-practice-form");
        const feedback = block.querySelector(".practice-feedback");
        const hint = block.querySelector(".practice-hint");
        const hintButton = block.querySelector(".hint-button");
        if (
          !(form instanceof HTMLFormElement) ||
          !(feedback instanceof HTMLElement) ||
          !(hint instanceof HTMLElement) ||
          !(hintButton instanceof HTMLButtonElement)
        ) continue;

        hintButton.addEventListener("click", () => {
          hint.hidden = !hint.hidden;
          hintButton.textContent = hint.hidden ? "ヒント" : "ヒントを閉じる";
        });

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const inputs = [...form.querySelectorAll("input[data-answers]")].filter(
            (input): input is HTMLInputElement => input instanceof HTMLInputElement,
          );
          let correctCount = 0;

          for (const input of inputs) {
            const rawAnswers = input.dataset.answers;
            if (!rawAnswers) continue;
            const answers = (JSON.parse(rawAnswers) as string[]).map(normalizeAnswer);
            const isCorrect = answers.includes(normalizeAnswer(input.value));
            input.classList.toggle("is-correct", isCorrect);
            input.classList.toggle("is-error", !isCorrect);
            if (isCorrect) correctCount += 1;
          }

          if (correctCount === inputs.length) {
            feedback.textContent = "すべて正解です。着眼点から解答手順まで再現できています。";
            feedback.className = "feedback practice-feedback is-correct";
          } else {
            feedback.textContent = `全 ${inputs.length} 段階のうち ${correctCount} 段階が合っています。例題の判断順序と比べて確認してください。`;
            feedback.className = "feedback practice-feedback is-error";
          }
        });

        form.addEventListener("reset", () => {
          window.setTimeout(() => {
            for (const input of form.querySelectorAll("input")) {
              input.classList.remove("is-correct", "is-error");
            }
            feedback.textContent = "";
            feedback.className = "feedback practice-feedback";
            hint.hidden = true;
            hintButton.textContent = "ヒント";
          }, 0);
        });
      }

      for (const block of document.querySelectorAll("[data-generator]")) {
        if (!(block instanceof HTMLElement)) continue;
        const button = block.querySelector(".generator-button");
        const content = block.querySelector("[data-generated-content]");
        const statement = block.querySelector("[data-generated-statement]");
        const question = block.querySelector("[data-generated-question]");
        const steps = block.querySelector("[data-generated-steps]");
        const answer = block.querySelector("[data-generated-answer]");
        const solution = block.querySelector("[data-generated-solution]");
        const feedback = block.querySelector(".generator-feedback");
        if (
          !(button instanceof HTMLButtonElement) ||
          !(content instanceof HTMLElement) ||
          !(statement instanceof HTMLElement) ||
          !(question instanceof HTMLElement) ||
          !(steps instanceof HTMLOListElement) ||
          !(answer instanceof HTMLElement) ||
          !(solution instanceof HTMLDetailsElement) ||
          !(feedback instanceof HTMLElement)
        ) continue;

        button.addEventListener("click", () => {
          const key = block.dataset.generatorKey;
          if (!key) return;
          const generated = generateMath1QuadraticPractice(key);
          if (!generated) {
            feedback.textContent = "このパターンの生成器を読み込めませんでした。";
            return;
          }

          statement.replaceChildren(
            ...generated.statement.map((text) => {
              const paragraph = document.createElement("p");
              paragraph.textContent = text;
              return paragraph;
            }),
          );
          question.textContent = generated.question;
          steps.replaceChildren(
            ...generated.solution.steps.map((text) => {
              const item = document.createElement("li");
              item.textContent = text;
              return item;
            }),
          );
          answer.textContent = generated.solution.answer;
          solution.open = false;
          content.hidden = false;
          feedback.textContent =
            "別の条件で実践問題を生成しました。まず解答を閉じたまま解いてください。";
        });
      }
    </script>
  </body>
</html>
