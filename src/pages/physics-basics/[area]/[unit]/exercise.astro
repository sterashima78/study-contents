---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PhysicsUnitExercise from "../../../../components/PhysicsUnitExercise.astro";
import type { MathArea, MathUnit } from "../../../../content/math1/types";
import { physicsBasicsAreas } from "../../../../content/physics-basics/catalog";

export function getStaticPaths() {
  return physicsBasicsAreas.flatMap((area) =>
    area.units.map((unit) => ({
      params: { area: area.key, unit: unit.key },
      props: { area, unit },
    })),
  );
}

type Props = {
  area: MathArea;
  unit: MathUnit;
};

const { area: _area, unit: _unit } = Astro.props;
---

<PhysicsUnitExercise area={_area} unit={_unit} />
