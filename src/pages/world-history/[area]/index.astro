---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MathAreaIndex from "../../../components/MathAreaIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { worldHistoryCourse } from "../../../content/math-courses";
import type { MathArea } from "../../../content/math1/types";
import { worldHistoryAreas } from "../../../content/world-history/catalog";

export function getStaticPaths() {
  return worldHistoryAreas.map((area) => ({
    params: { area: area.key },
    props: { area },
  }));
}

type Props = {
  area: MathArea;
};

const { area: _area } = Astro.props;
---

<MathAreaIndex area={_area} course={worldHistoryCourse} />
