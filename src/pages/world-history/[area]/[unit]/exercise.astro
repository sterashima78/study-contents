---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MathUnitExercise from "../../../../components/MathUnitExercise.astro";
import { worldHistoryAreas } from "../../../../content/world-history/catalog";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { worldHistoryCourse } from "../../../../content/math-courses";
import type { MathArea, MathUnit } from "../../../../content/math1/types";

export function getStaticPaths() {
  return worldHistoryAreas.flatMap((area) =>
    area.units.map((unit) => ({
      params: { area: area.key, unit: unit.key },
      props: { area, unit },
    })),
  );
}

type Props = {
  area: MathArea;
  unit: MathUnit;
};

const { area: _area, unit: _unit } = Astro.props;
---

<MathUnitExercise area={_area} unit={_unit} course={worldHistoryCourse} />
