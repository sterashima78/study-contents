import { worldHistoryAreas } from "../content/world-history/catalog";

type CountableArea = {
  units: ReadonlyArray<{
    lessons: ReadonlyArray<unknown>;
  }>;
};

const _base = import.meta.env.BASE_URL;
const _lessonCount = (areas: ReadonlyArray<CountableArea>) =>
  areas.reduce(
    (sum, area) => sum + area.units.reduce((unitSum, unit) => unitSum + unit.lessons.length, 0),
    0,
  );

const _middleSchoolCourses = [
  {
    title: "中学数学",
    kicker: "JUNIOR HIGH MATHEMATICS",
    href: `${_base}middle-school/math/`,
    description:
      "1〜3年の数と式、図形、関数、データの活用を、学年ごとの既習事項に合わせて学びます。",
    areas: ["1〜3年", "数と式", "図形", "関数", "データの活用"],
    lessonCount:
      _lessonCount(middleMath1Areas) +
      _lessonCount(middleMath2Areas) +
      _lessonCount(middleMath3Areas),
  },
  {
    title: "中学理科",
    kicker: "JUNIOR HIGH SCIENCE",
    href: `${_base}middle-school/science/`,
    description: "1〜3年のエネルギー・粒子・生命・地球を、観察・実験や資料と結びつけて学びます。",
    areas: ["1〜3年", "エネルギー", "粒子", "生命", "地球"],
    lessonCount:
      _lessonCount(middleScience1Areas) +
      _lessonCount(middleScience2Areas) +
      _lessonCount(middleScience3Areas),
  },
  {
    title: "中学英語",
    kicker: "JUNIOR HIGH ENGLISH",
    href: `${_base}middle-school/english/`,
    description:
      "1〜3年の基本文から現在完了・受け身・関係代名詞まで、読む・書く・聞く・話す活動へつなげます。",
    areas: ["1〜3年", "基本文", "文法", "読解・表現"],
    lessonCount:
      _lessonCount(middleEnglish1CompleteAreas) +
      _lessonCount(middleEnglish2Areas) +
      _lessonCount(middleEnglish3Areas),
  },
];

const _mathCourses = [
