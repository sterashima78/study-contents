---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import CourseCatalog from "../components/CourseCatalog.astro";
import { biologyAreas } from "../content/biology/catalog";
import { biologyBasicAreas } from "../content/biology-basic/catalog";
import { chemistryAreas } from "../content/chemistry/catalog";
import { chemistryBasicAreas } from "../content/chemistry-basic/catalog";
import { englishAreas } from "../content/english/catalog";
import { ethicsAreas } from "../content/ethics/catalog";
import { japaneseAreas } from "../content/japanese/catalog";
import { japaneseHistoryAreas } from "../content/japanese-history/catalog";
import { math1Areas } from "../content/math1/catalog";
import { math2Areas } from "../content/math2/catalog";
import { math3Areas } from "../content/math3/catalog";
import { mathAAreas } from "../content/matha/catalog";
import { mathBAreas } from "../content/mathb/catalog";
import { mathCAreas } from "../content/mathc/catalog";
import { middleMath1Areas } from "../content/middle-school/math/grade1/catalog";
import { middleMath2Areas } from "../content/middle-school/math/grade2/catalog";
import { middleMath3Areas } from "../content/middle-school/math/grade3/catalog";
import { physicsAreas } from "../content/physics/catalog";
import { physicsBasicsAreas } from "../content/physics-basics/catalog";
import { worldHistoryAreas } from "../content/world-history/catalog";

type CountableArea = {
  units: ReadonlyArray<{
    lessons: ReadonlyArray<unknown>;
  }>;
};

const _base = import.meta.env.BASE_URL;
const _lessonCount = (areas: ReadonlyArray<CountableArea>) =>
  areas.reduce(
    (sum, area) => sum + area.units.reduce((unitSum, unit) => unitSum + unit.lessons.length, 0),
    0,
  );
const _middleMathLessonCount =
  _lessonCount(middleMath1Areas) + _lessonCount(middleMath2Areas) + _lessonCount(middleMath3Areas);
const _courses = [
  {
    title: "中学校",
    kicker: "LOWER SECONDARY",
    href: `${_base}middle-school/`,
    description: "中学数学1〜3年の全4領域を公開。理科・英語へ順次拡張します。",
    areas: ["中学数学 1年", "中学数学 2年", "中学数学 3年"],
    lessonCount: _middleMathLessonCount,
  },
  {
    title: "数学I",
    kicker: "MATHEMATICS I",
    href: `${_base}math1/`,
    description: "数と式、図形と計量、二次関数、データの分析。高校数学の基本を整理します。",
    areas: math1Areas.map((area) => area.title),
    lessonCount: _lessonCount(math1Areas),
  },
  {
    title: "数学A",
    kicker: "MATHEMATICS A",
    href: `${_base}matha/`,
    description: "場合の数と確率、図形の性質、数学と人間の活動。数え方と論証を中心に学びます。",
    areas: mathAAreas.map((area) => area.title),
    lessonCount: _lessonCount(mathAAreas),
  },
  {
    title: "数学II",
    kicker: "MATHEMATICS II",
    href: `${_base}math2/`,
    description: "式、図形と方程式、指数・対数、三角関数、微分・積分へ進みます。",
    areas: math2Areas.map((area) => area.title),
    lessonCount: _lessonCount(math2Areas),
  },
  {
    title: "数学B",
    kicker: "MATHEMATICS B",
    href: `${_base}mathb/`,
    description: "数列、統計的な推測、数学と社会生活。変化やデータを捉える考え方を学びます。",
    areas: mathBAreas.map((area) => area.title),
    lessonCount: _lessonCount(mathBAreas),
  },
  {
    title: "数学C",
    kicker: "MATHEMATICS C",
    href: `${_base}mathc/`,
    description: "ベクトル、平面上の曲線、複素数平面。図形を式で扱う力を深めます。",
    areas: mathCAreas.map((area) => area.title),
    lessonCount: _lessonCount(mathCAreas),
  },
  {
    title: "数学III",
    kicker: "MATHEMATICS III",
    href: `${_base}math3/`,
    description: "極限、微分法、積分法。公式の意味と計算の流れを確かめながら学びます。",
    areas: math3Areas.map((area) => area.title),
    lessonCount: _lessonCount(math3Areas),
  },
  {
    title: "化学基礎",
    kicker: "BASIC CHEMISTRY",
    href: `${_base}chemistry-basic/`,
    description: "物質の構成と変化を、粒子・量・実験の視点から学びます。",
    areas: chemistryBasicAreas.map((area) => area.title),
    lessonCount: _lessonCount(chemistryBasicAreas),
  },
  {
    title: "化学",
    kicker: "CHEMISTRY",
    href: `${_base}chemistry/`,
    description: "状態と平衡、反応、無機・有機、高分子を、構造と量の関係から学びます。",
    areas: chemistryAreas.map((area) => area.title),
    lessonCount: _lessonCount(chemistryAreas),
  },
  {
    title: "物理基礎",
    kicker: "BASIC PHYSICS",
    href: `${_base}physics-basics/`,
    description: "運動、力とエネルギー、波、熱、電気を、現象と式を結びつけて学びます。",
    areas: physicsBasicsAreas.map((area) => area.title),
    lessonCount: _lessonCount(physicsBasicsAreas),
  },
  {
    title: "物理",
    kicker: "PHYSICS",
    href: `${_base}physics/`,
    description: "運動、波、電気と磁気、原子を、法則の意味と計算の流れから学びます。",
    areas: physicsAreas.map((area) => area.title),
    lessonCount: _lessonCount(physicsAreas),
  },
  {
    title: "生物基礎",
    kicker: "BASIC BIOLOGY",
    href: `${_base}biology-basic/`,
    description: "細胞、体内環境、生態系を、生命の共通性と多様性から学びます。",
    areas: biologyBasicAreas.map((area) => area.title),
    lessonCount: _lessonCount(biologyBasicAreas),
  },
  {
    title: "生物",
    kicker: "BIOLOGY",
    href: `${_base}biology/`,
    description: "進化、代謝、遺伝情報、発生、環境応答、生態を、資料と仕組みから学びます。",
    areas: biologyAreas.map((area) => area.title),
    lessonCount: _lessonCount(biologyAreas),
  },
  {
    title: "日本史",
    kicker: "JAPANESE HISTORY",
    href: `${_base}japanese-history/`,
    description:
      "古代から現代までの日本の歴史を、政治・社会・経済・文化と東アジアとの関係から学びます。",
    areas: japaneseHistoryAreas.map((area) => area.title),
    lessonCount: _lessonCount(japaneseHistoryAreas),
  },
  {
    title: "世界史",
    kicker: "WORLD HISTORY",
    href: `${_base}world-history/`,
    description: "古代文明から現代世界までを、地域間交流・比較・因果関係をつないで学びます。",
    areas: worldHistoryAreas.map((area) => area.title),
    lessonCount: _lessonCount(worldHistoryAreas),
  },
  {
    title: "倫理",
    kicker: "ETHICS",
    href: `${_base}ethics/`,
    description:
      "青年期、古今東西の思想、現代の倫理的諸課題を、概念の比較と理由づけを通して学びます。",
    areas: ethicsAreas.map((area) => area.title),
    lessonCount: _lessonCount(ethicsAreas),
  },
  {
    title: "英語",
    kicker: "ENGLISH",
    href: `${_base}english/`,
    description: "英文法・解釈・長文読解・論理表現を、英文を読み解く手順から学びます。",
    areas: englishAreas.map((area) => area.title),
    lessonCount: _lessonCount(englishAreas),
  },
  {
    title: "国語",
    kicker: "JAPANESE",
    href: `${_base}japanese/`,
    description: "現代文・古文・漢文を、本文の根拠、文法、句法に沿って読み解きます。",
    areas: japaneseAreas.map((area) => area.title),
    lessonCount: _lessonCount(japaneseAreas),
  },
];
---

<CourseCatalog courses={_courses} />
