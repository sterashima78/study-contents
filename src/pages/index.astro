---
import "../styles/global.css";

const _units = [
  {
    number: "01",
    title: "数と式",
    description: "数や式の扱い方を整理し、数学Iの計算と論理の土台をつくります。",
    topics: ["式の展開と因数分解", "実数", "一次不等式", "集合と命題"],
  },
  {
    number: "02",
    title: "図形と計量",
    description: "三角比を使って、角度・長さ・面積を数量として捉えます。",
    topics: ["三角比", "三角比の相互関係", "正弦定理・余弦定理", "図形の計量"],
  },
  {
    number: "03",
    title: "二次関数",
    description: "グラフと式を行き来しながら、変化の特徴や条件を読み取ります。",
    topics: ["二次関数とグラフ", "最大・最小", "二次方程式とグラフ", "二次不等式"],
  },
  {
    number: "04",
    title: "データの分析",
    description: "データの散らばりや関係を数値とグラフで捉え、判断につなげます。",
    topics: ["データの散らばり", "分散・標準偏差", "散布図・相関係数", "仮説検定の考え方"],
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="高校数学Iの学習コンテンツ。数と式、図形と計量、二次関数、データの分析を順に学べます。"
    />
    <title>数学I | 学習コンテンツ</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="hero">
        <p class="eyebrow">MATHEMATICS I</p>
        <h1>数学I</h1>
        <p class="lead">
          基礎から順に、要点を理解し、問題を解き、解答の考え方まで確認するための学習コンテンツです。
        </p>
        <div class="learning-flow" aria-label="各単元の学習の流れ">
          <span>要点</span>
          <span aria-hidden="true">→</span>
          <span>練習問題</span>
          <span aria-hidden="true">→</span>
          <span>詳しい解答</span>
        </div>
      </header>

      <section class="curriculum" aria-labelledby="curriculum-title">
        <div class="section-heading">
          <div>
            <p class="section-label">CONTENTS</p>
            <h2 id="curriculum-title">学習する4つの領域</h2>
          </div>
          <p>上から順に学習すると、前の内容を使いながら理解を積み重ねられます。</p>
        </div>

        <ol class="unit-grid">
          {
            _units.map((unit) => (
              <li class="unit-card">
                <div class="unit-header">
                  <span class="unit-number" aria-hidden="true">{unit.number}</span>
                  <h3>{unit.title}</h3>
                </div>
                <p class="unit-description">{unit.description}</p>
                <ul class="topic-list">
                  {unit.topics.map((topic) => <li>{topic}</li>)}
                </ul>
                <p class="preparing">教材を準備中</p>
              </li>
            ))
          }
        </ol>
      </section>

      <footer class="page-footer">
        <p>高校 数学I</p>
        <p>学習指導要領の内容に沿って順次追加します。</p>
      </footer>
    </main>
  </body>
</html>
