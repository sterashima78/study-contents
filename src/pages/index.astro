const _highSchoolGroups = [
  {
    label: "MATHEMATICS",
    title: "高校数学",
    id: "high-school-mathematics-title",
    description: "数学I・A・II・B・III・Cから、学びたい科目を選びます。",
    courses: _mathCourses,
  },
  {
    label: "SCIENCE",
