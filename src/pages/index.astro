---
import { math1Areas } from "../content/math1/catalog";
import { mathAAreas } from "../content/matha/catalog";
import "../styles/global.css";

const _base = import.meta.env.BASE_URL;
const _courses = [
  {
    title: "数学I",
    kicker: "MATHEMATICS I",
    href: `${_base}math1/`,
    description: "数と式、図形と計量、二次関数、データの分析を、1ページ1技能の小さな教材で学びます。",
    areas: math1Areas.map((area) => area.title),
    lessonCount: math1Areas.reduce(
      (sum, area) => sum + area.units.reduce((unitSum, unit) => unitSum + unit.lessons.length, 0),
      0,
    ),
  },
  {
    title: "数学A",
    kicker: "MATHEMATICS A",
    href: `${_base}matha/`,
    description: "場合の数と確率、図形の性質、数学と人間の活動を、1ページ1技能の小さな教材で学びます。",
    areas: mathAAreas.map((area) => area.title),
    lessonCount: mathAAreas.reduce(
      (sum, area) => sum + area.units.reduce((unitSum, unit) => unitSum + unit.lessons.length, 0),
      0,
    ),
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="高校数学の学習コンテンツ。数学Iと数学Aから学びたい科目を選び、小単元ごとの教材と演習に進めます。"
    />
    <title>高校数学 | 学習コンテンツ</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="hero">
        <p class="eyebrow">HIGH SCHOOL MATHEMATICS</p>
        <h1>学習コンテンツ</h1>
        <p class="lead">
          学びたい科目を選び、領域、単元、小単元の順に進みます。各小単元では考え方から例題、練習、確認問題までを一続きで学習できます。
        </p>
      </header>

      <section class="curriculum" aria-labelledby="courses-title">
        <div class="section-heading">
          <div>
            <p class="section-label">COURSES</p>
            <h2 id="courses-title">学習する科目</h2>
          </div>
          <p>科目ごとに独立した目次から、学びたい領域と単元を選択できます。</p>
        </div>

        <ol class="course-grid">
          {
            _courses.map((course, index) => (
              <li class="course-card">
                <a class="course-card-link" href={course.href}>
                  <div class="course-card-heading">
                    <span class="course-number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <div>
                      <p class="course-kicker">{course.kicker}</p>
                      <h3>{course.title}</h3>
                    </div>
                  </div>
                  <p class="course-description">{course.description}</p>
                  <ul class="course-area-list" aria-label={`${course.title}の領域`}>
                    {course.areas.map((area) => <li>{area}</li>)}
                  </ul>
                  <p class="course-meta">{course.lessonCount}小教材公開</p>
                  <span class="course-action">科目の目次を見る →</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <footer class="page-footer">
        <p>高校数学 学習コンテンツ</p>
        <p>科目を入口として、領域・単元・小単元へ進む構成です。</p>
      </footer>
    </main>
  </body>
</html>
