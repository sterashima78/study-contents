---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MathAreaIndex from "../../../components/MathAreaIndex.astro";
import { chemistryBasicAreas } from "../../../content/chemistry-basic/catalog";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { chemistryBasicCourse } from "../../../content/math-courses";
import type { MathArea } from "../../../content/math1/types";

export function getStaticPaths() {
  return chemistryBasicAreas.map((area) => ({
    params: { area: area.key },
    props: { area },
  }));
}

type Props = {
  area: MathArea;
};

const { area: _area } = Astro.props;
---

<MathAreaIndex area={_area} course={chemistryBasicCourse} />
