---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MathUnitIndex from "../../../../components/MathUnitIndex.astro";
import { chemistryBasicAreas } from "../../../../content/chemistry-basic/catalog";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { chemistryBasicCourse } from "../../../../content/math-courses";
import type { MathArea, MathUnit } from "../../../../content/math1/types";

export function getStaticPaths() {
  return chemistryBasicAreas.flatMap((area) =>
    area.units.map((unit) => ({
      params: { area: area.key, unit: unit.key },
      props: { area, unit },
    })),
  );
}

type Props = {
  area: MathArea;
  unit: MathUnit;
};

const { area: _area, unit: _unit } = Astro.props;
---

<MathUnitIndex area={_area} unit={_unit} course={chemistryBasicCourse} />
