---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MathLesson from "../../../../components/MathLesson.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { math3Course } from "../../../../content/math-courses";
import type {
  MathArea,
  MathLesson as MathLessonData,
  MathUnit,
} from "../../../../content/math1/types";
import { math3Areas } from "../../../../content/math3/catalog";

export function getStaticPaths() {
  return math3Areas.flatMap((area) =>
    area.units.flatMap((unit) =>
      unit.lessons.map((lesson) => ({
        params: { area: area.key, unit: unit.key, lesson: lesson.key },
        props: { area, unit, lesson },
      })),
    ),
  );
}

type Props = {
  area: MathArea;
  unit: MathUnit;
  lesson: MathLessonData;
};

const { area: _area, unit: _unit, lesson: _lesson } = Astro.props;
---

<MathLesson area={_area} unit={_unit} lesson={_lesson} course={math3Course} />
