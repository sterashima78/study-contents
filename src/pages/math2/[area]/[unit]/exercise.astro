---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MathUnitExercise from "../../../../components/MathUnitExercise.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { math2Course } from "../../../../content/math-courses";
import type { MathArea, MathUnit } from "../../../../content/math1/types";
import { math2Areas } from "../../../../content/math2/catalog";

export function getStaticPaths() {
  return math2Areas.flatMap((area) =>
    area.units.map((unit) => ({
      params: { area: area.key, unit: unit.key },
      props: { area, unit },
    })),
  );
}

type Props = {
  area: MathArea;
  unit: MathUnit;
};

const { area: _area, unit: _unit } = Astro.props;
---

<MathUnitExercise area={_area} unit={_unit} course={math2Course} />
