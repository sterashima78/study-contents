---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "../../components/ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "../../components/ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "../../components/ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "../../components/ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "../../components/ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "../../components/ui/StudyPage.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SummaryPoints from "../../components/ui/SummaryPoints.astro";

const _base = import.meta.env.BASE_URL;
---

<StudyPage
  title="中学校 | 学習コンテンツ"
  description="中学1〜3年の学習コンテンツです。数学は3学年・4領域を公開済みで、中学1年理科は第1分野2単元と第2分野の生物分類を公開しています。"
  width="wide"
>
  <ContentHero
    kicker="LOWER SECONDARY"
    title="中学校"
    description="中学1〜3年の内容を、1ページ1技能の短い教材で学べるように整備します。数学は全領域、理科は中学1年から公開しています。"
    variant="display"
  />

  <ContentSection labelledby="subjects-title">
    <SectionHeading
      label="SUBJECTS"
      title="教科からはじめる"
      id="subjects-title"
      description="中学数学は1〜3年の全領域を公開済みです。中学理科は1年の物理・物質・生物分類まで公開しています。"
    />
    <ContentIndex
      items={[
        {
          marker: "01",
          title: "数学",
          href: `${_base}middle-school/math/`,
          description: "学年ごとに、数と式・図形・関数・データの活用を小さな技能へ分けて学びます。",
          tags: ["1〜3年・4領域公開", "自動採点", "高校数学へ接続"],
          action: "中学数学へ →",
        },
        {
          marker: "02",
          title: "理科",
          href: `${_base}middle-school/science/`,
          description: "観察・実験や資料から、物理・物質の規則性と、生物の共通点・相違点を見いだして説明する力を育てます。",
          tags: ["中学1年 3単元公開", "図解", "自動採点"],
          action: "中学理科へ →",
        },
      ]}
      variant="grid"
    />
  </ContentSection>

  <ContentSection labelledby="scope-title" compact>
    <SectionHeading label="SCOPE" title="現在の対象" id="scope-title" />
    <SummaryPoints
      items={[
        "中学数学: 1〜3年のA 数と式、B 図形、C 関数、D データの活用を公開済み。",
        "中学理科: 1年「身近な物理現象」「身の回りの物質」「いろいろな生物とその共通点」を公開。次に大地へ拡張する。",
        "中学英語: 理科に続いて同じ1ページ1技能の基盤へ追加する。",
      ]}
    />
  </ContentSection>

  <PageNavigation
    previous={{ label: "← 学習コンテンツ", href: _base }}
    next={{ label: "中学理科へ →", href: `${_base}middle-school/science/` }}
  />
</StudyPage>
