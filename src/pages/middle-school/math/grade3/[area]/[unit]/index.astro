---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import MathUnitIndex from "../../../../../../components/MathUnitIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { middleMath3Course } from "../../../../../../content/math-courses";
import type { MathArea, MathUnit } from "../../../../../../content/math1/types";
import { middleMath3Areas } from "../../../../../../content/middle-school/math/grade3/catalog";

export function getStaticPaths() {
  return middleMath3Areas.flatMap((area) =>
    area.units.map((unit) => ({
      params: { area: area.key, unit: unit.key },
      props: { area, unit },
    })),
  );
}

type Props = {
  area: MathArea;
  unit: MathUnit;
};

const { area: _area, unit: _unit } = Astro.props;
---

<MathUnitIndex area={_area} unit={_unit} course={middleMath3Course} />
