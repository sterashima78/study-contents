---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "../../../components/ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "../../../components/ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "../../../components/ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "../../../components/ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "../../../components/ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "../../../components/ui/StudyPage.astro";

const _base = import.meta.env.BASE_URL;
---

<StudyPage
  title="中学数学 | 学習コンテンツ"
  description="中学1〜3年の数学を学年別に学ぶための入口です。3学年ともA 数と式、B 図形、C 関数、D データの活用を公開しています。"
  width="wide"
>
  <ContentHero
    kicker="JUNIOR HIGH MATHEMATICS"
    title="中学数学"
    description="数と式、図形、関数、データの活用を、学年ごとの既習事項に合わせて学びます。高校数学の教材とは説明・例題・演習を分けて管理します。"
    variant="display"
  />

  <ContentSection labelledby="grades-title">
    <SectionHeading
      label="GRADES"
      title="学年からはじめる"
      id="grades-title"
      description="中学1〜3年の4領域を公開しています。各教材は1ページ1技能で、単元末演習から復習ページへ戻れます。"
    />
    <ContentIndex
      items={[
        {
          marker: "01",
          title: "中学1年",
          href: `${_base}middle-school/math/grade1/`,
          description: "正の数・負の数から始め、文字式、方程式、比例・反比例、図形、データへ進みます。",
          tags: ["4領域 公開中", "1ページ1技能"],
          action: "1年の目次へ →",
        },
        {
          marker: "02",
          title: "中学2年",
          href: `${_base}middle-school/math/grade2/`,
          description:
            "式の計算、連立方程式、図形の性質と証明、一次関数、四分位数・箱ひげ図、場合の数と確率へ進みます。",
          tags: ["4領域 公開中", "1ページ1技能"],
          action: "2年の目次へ →",
        },
        {
          marker: "03",
          title: "中学3年",
          href: `${_base}middle-school/math/grade3/`,
          description:
            "平方根、展開・因数分解、二次方程式、相似、円周角、三平方の定理、関数 y=ax²、標本調査へ進みます。",
          tags: ["4領域 公開中", "1ページ1技能"],
          action: "3年の目次へ →",
        },
      ]}
      variant="grid"
    />
  </ContentSection>

  <PageNavigation
    previous={{ label: "← 中学校", href: `${_base}middle-school/` }}
    next={{ label: "中学3年へ →", href: `${_base}middle-school/math/grade3/` }}
  />
</StudyPage>
