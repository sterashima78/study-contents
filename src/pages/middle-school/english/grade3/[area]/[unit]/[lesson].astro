---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import EnglishLesson from "../../../../../../components/EnglishLesson.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import { middleEnglish3Course } from "../../../../../../content/english/course";
import type {
  EnglishArea,
  EnglishLesson as EnglishLessonData,
  EnglishUnit,
} from "../../../../../../content/english/types";
import { middleEnglish3Areas } from "../../../../../../content/middle-school/english/grade3/catalog";

export function getStaticPaths() {
  return middleEnglish3Areas.flatMap((area) =>
    area.units.flatMap((unit) =>
      unit.lessons.map((lesson) => ({
        params: { area: area.key, unit: unit.key, lesson: lesson.key },
        props: { area, unit, lesson },
      })),
    ),
  );
}

type Props = { area: EnglishArea; unit: EnglishUnit; lesson: EnglishLessonData };
const { area: _area, unit: _unit, lesson: _lesson } = Astro.props;
---

<EnglishLesson area={_area} unit={_unit} lesson={_lesson} course={middleEnglish3Course} />
