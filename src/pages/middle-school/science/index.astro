---
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentHero from "../../../components/ui/ContentHero.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentIndex from "../../../components/ui/ContentIndex.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import ContentSection from "../../../components/ui/ContentSection.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import PageNavigation from "../../../components/ui/PageNavigation.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import SectionHeading from "../../../components/ui/SectionHeading.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro template usage is not detected by Biome.
import StudyPage from "../../../components/ui/StudyPage.astro";

const _base = import.meta.env.BASE_URL;
---

<StudyPage title="中学理科 | 学習コンテンツ" description="中学1〜3年理科を現行の学習指導要領に沿って1ページ1技能で整備します。">
  <ContentHero kicker="JUNIOR HIGH SCIENCE" title="中学理科" description="観察・実験や資料から規則性や共通点を見いだし、自然の現象を科学的に説明する力を育てます。" variant="display" />
  <ContentSection labelledby="grades-title">
    <SectionHeading label="GRADES" title="学年からはじめる" id="grades-title" description="中学1年・中学2年のエネルギー・粒子・生命・地球の4領域を公開しています。" />
    <ContentIndex
      items={[
        {
          marker: "01",
          title: "中学1年",
          href: `${_base}middle-school/science/grade1/`,
          description: "光・音・力、物質、生物の分類、地層・火山・地震まで第1学年の内容を学びます。",
          tags: ["4領域公開", "3問確認", "単元末8問"],
          action: "中学1年理科へ →",
        },
        {
          marker: "02",
          title: "中学2年",
          href: `${_base}middle-school/science/grade2/`,
          description: "回路・磁界、原子・分子と化学変化、細胞と体の働き、気象観測・前線・日本の気象を学びます。",
          tags: ["4領域 公開", "3問確認", "単元末8問"],
          action: "中学2年理科へ →",
        },
      ]}
      variant="grid"
    />
  </ContentSection>
  <PageNavigation previous={{ label: "← 中学校", href: `${_base}middle-school/` }} next={{ label: "中学2年理科へ →", href: `${_base}middle-school/science/grade2/` }} />
</StudyPage>
