{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!dist", "!!.astro"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/content/math1/algebra.ts"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
