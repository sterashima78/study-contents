{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!dist", "!!.astro"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/content/math1/algebra.ts",
        "src/content/matha/**/*.ts",
        "src/content/math2/**/*.ts",
        "src/content/mathb/**/*.ts",
        "src/content/mathc/**/*.ts",
        "src/content/chemistry-basic/**/*.ts",
        "src/content/chemistry/**/*.ts",
        "src/content/math3/**/*.ts",
        "src/content/physics/**/*.ts",
        "src/content/japanese/**/*.ts"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/content/entrance/*-advanced.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
